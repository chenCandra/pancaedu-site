{
  "name": "pancaedu-site",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  // Entrypoint Worker milik adapter @astrojs/cloudflare -- menangani route
  // yang di-render on-demand (mis. /penugasan/[slug] & API-nya). Asset
  // statis di bawah tetap diserve duluan; cuma request yang tidak match
  // file statis yang jatuh ke Worker ini.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Paksa request ke path-path ini SELALU lewat Worker dulu (bukan
    // dicek ke Assets duluan) -- /penugasan/{slug} adalah halaman dinamis
    // TANPA file statis, tapi /penugasan/{slug}/leaderboard/ (statis,
    // prerendered) hidup sebagai sub-folder DI DALAM path yang sama,
    // dan itu terindikasi membuat Cloudflare Assets salah menganggap
    // {slug} sebagai "404" alih-alih meneruskannya ke Worker. Worker
    // sendiri otomatis meneruskan ke ASSETS binding untuk rute yang
    // memang statis (mis. leaderboard), jadi tidak ada yang hilang.
    "run_worker_first": ["/penugasan/*", "/api/*"]
  },
  // Database Cloudflare D1 buat fitur Penugasan (skor & jawaban siswa) --
  // database_id diisi setelah `wrangler d1 create pancaedu-penugasan`
  // dijalankan (lihat migrations/README.md). JANGAN dihapus/diubah asal
  // sendiri, satu deploy salah bisa bikin binding menunjuk DB yang tidak
  // ada dan deploy otomatis gagal.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pancaedu-penugasan",
      "database_id": "4c1209c9-d566-44d4-a5cf-2759cc004e72"
    }
  ],
  "routes": [
    { "pattern": "pancaedu.web.id", "custom_domain": true }
  ]
}
