{
  "name": "pancaedu-site",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  // Entrypoint Worker milik adapter @astrojs/cloudflare -- menangani route
  // yang di-render on-demand (mis. /penugasan/[slug] & API-nya). Asset
  // statis di bawah tetap diserve duluan; cuma request yang tidak match
  // file statis yang jatuh ke Worker ini.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Database Cloudflare D1 buat fitur Penugasan (skor & jawaban siswa) --
  // database_id diisi setelah `wrangler d1 create pancaedu-penugasan`
  // dijalankan (lihat migrations/README.md). JANGAN dihapus/diubah asal
  // sendiri, satu deploy salah bisa bikin binding menunjuk DB yang tidak
  // ada dan deploy otomatis gagal.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pancaedu-penugasan",
      "database_id": "4c1209c9-d566-44d4-a5cf-2759cc004e72"
    }
  ],
  "routes": [
    { "pattern": "pancaedu.web.id", "custom_domain": true }
  ]
}
