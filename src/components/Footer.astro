---
const year = new Date().getFullYear();
const links = [
  { href: '/materi', label: 'Materi' },
  { href: '/artikel', label: 'Artikel' },
  { href: '/game', label: 'Arena Game Edukasi' },
  { href: '/kenangan', label: 'Jejak Kelas' },
  { href: '/candra-pabakti', label: 'Tentang Candra Pabakti' },
  { href: '/kontak', label: 'Kontak' },
  { href: '/kebijakan-privasi', label: 'Kebijakan Privasi' },
];
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    <a href="/" class="footer-brand">PancaEdu</a>
    <nav aria-label="Navigasi footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <details class="footer-admin-menu">
      <summary class="footer-admin-icon" aria-label="Menu admin" title="Menu admin">⚙️</summary>
      <div class="footer-admin-popover">
        <a href="/admin/">📝 Kelola Konten <span>(Sveltia CMS — artikel &amp; materi)</span></a>
        <a href="/admin-panca/login">🎓 Admin Panca <span>(Penugasan, PPDB, data sekolah)</span></a>
      </div>
    </details>

    <p class="footer-copy">
      &copy; {year} PancaEdu — Ruang Belajar Digital oleh <a href="/candra-pabakti">Candra Pabakti</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--glass-border);
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    margin-top: 4rem;
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2.5rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }

  .site-footer-inner nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .site-footer-inner nav a {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }

  .site-footer-inner nav a:hover {
    color: var(--accent);
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    width: 100%;
    order: 3;
    margin: 0;
  }

  .footer-copy a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Kecil sengaja -- bukan CTA, cuma jalan pintas buat guru sendiri supaya
     tidak perlu ingat/ketik /admin/ atau /admin-panca/login manual. Opacity
     dinaikkan (2026-09-11) supaya lebih gampang ditemukan sendiri -- awalnya
     0,35. Diubah (2026-10-28) dari link langsung ke /admin-panca jadi menu
     popover <details> -- dua tujuan admin (Sveltia buat konten, Admin Panca
     buat Penugasan/PPDB) sebelumnya ambigu di satu ikon. <details>/<summary>
     dipakai biar nggak perlu JS buat toggle & tetap bisa dioperasikan lewat
     keyboard bawaan browser.
  */
  .footer-admin-menu {
    position: relative;
  }

  .footer-admin-icon {
    display: inline-block;
    font-size: 0.9rem;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    line-height: 1;
    list-style: none;
  }

  .footer-admin-icon::-webkit-details-marker {
    display: none;
  }

  .footer-admin-icon:hover {
    opacity: 1;
  }

  .footer-admin-popover {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 15rem;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: 0.75rem;
    box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
  }

  .footer-admin-popover a {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0.65rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s ease;
  }

  .footer-admin-popover a:hover {
    background: var(--accent-soft);
  }

  .footer-admin-popover a span {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-soft);
  }
</style>
