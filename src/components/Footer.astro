---
const year = new Date().getFullYear();
const links = [
  { href: '/materi', label: 'Materi' },
  { href: '/artikel', label: 'Artikel' },
  { href: '/kenangan', label: 'Jejak Kelas' },
  { href: '/candra-pabakti', label: 'Tentang Candra Pabakti' },
  { href: '/kontak', label: 'Kontak' },
  { href: '/kebijakan-privasi', label: 'Kebijakan Privasi' },
];
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    <a href="/" class="footer-brand">PancaEdu</a>
    <nav aria-label="Navigasi footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a href="/admin-panca/login" class="footer-admin-icon" aria-label="Admin" title="Admin">⚙️</a>

    <p class="footer-copy">
      &copy; {year} PancaEdu — Ruang Belajar Digital oleh <a href="/candra-pabakti">Candra Pabakti</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--glass-border);
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    margin-top: 4rem;
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2.5rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }

  .site-footer-inner nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .site-footer-inner nav a {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }

  .site-footer-inner nav a:hover {
    color: var(--accent);
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    width: 100%;
    order: 3;
    margin: 0;
  }

  .footer-copy a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Kecil sengaja -- bukan CTA, cuma jalan pintas buat guru sendiri supaya
     tidak perlu ingat/ketik /admin-panca/login manual. Opacity dinaikkan
     (2026-09-11) supaya lebih gampang ditemukan sendiri -- awalnya 0,35. */
  .footer-admin-icon {
    font-size: 0.9rem;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    line-height: 1;
  }

  .footer-admin-icon:hover {
    opacity: 1;
  }
</style>
