---
// Layout KHUSUS sesi Ruang Belajar untuk kelas TKA -- sengaja BEDA dari
// "Learning Path" 6 langkah yang dipakai Kelas X/XI/XII (lihat
// src/pages/ruang-belajar/[slug].astro). TKA fokusnya drilling soal, bukan
// pembelajaran bertahap: TIDAK ADA step Video, Eksperimen/Lab Maya, atau
// Refleksi -- cuma 2 bagian: ringkasan materi singkat (suplemen, bukan
// gerbang wajib) dan satu CTA besar ke latihan soal (mesin `penugasan` yang
// sama dipakai kelas lain, boleh dikerjakan berkali-kali).
import type { CollectionEntry } from 'astro:content';

// Satu topik TKA bisa punya lebih dari satu PAKET latihan penuh (soal
// berbeda per paket, bukan sekadar dipecah dasar/HOTS) -- semuanya
// ditampilkan SEBAGAI KARTU BERDAMPINGAN di halaman yang SAMA, supaya murid
// tinggal pilih mau mengerjakan paket yang mana tanpa perlu pindah halaman.
interface Paket {
  label: string;
  tugasUrl?: string;
  jumlahSoal?: number;
}

interface Props {
  judul: string;
  mapel: string;
  deskripsi?: string;
  tujuanPembelajaran: string[];
  materi?: CollectionEntry<'blog'>;
  paket: Paket[];
  durasi?: number;
  babInfo?: { nomor: number; nama: string; posisi: number; total: number };
  indexSekarang: number;
  totalSesi: number;
  sesiSebelumnya?: CollectionEntry<'ruangBelajar'>;
  sesiBerikutnya?: CollectionEntry<'ruangBelajar'>;
}

const {
  judul, mapel, deskripsi, tujuanPembelajaran, materi, paket, durasi,
  babInfo, indexSekarang, totalSesi, sesiSebelumnya, sesiBerikutnya,
} = Astro.props;

const deskripsiTampil = deskripsi || materi?.data.description;
const totalSoalSemuaPaket = paket.reduce((total, p) => total + (p.jumlahSoal ?? 0), 0);
---

<a href="/ruang-belajar/kelas/tka" class="small-back">&larr; TKA</a>

<p class="eyebrow">🎯 Latihan TKA — {mapel}</p>
<h1>{judul}</h1>

<div class="tka-meta-row">
  {babInfo ? (
    <span class="tka-meta tka-meta-bab">📘 {babInfo.nama} — Sesi {babInfo.posisi} dari {babInfo.total}</span>
  ) : (
    indexSekarang >= 0 && <span class="tka-meta tka-meta-bab">📍 Sesi {indexSekarang + 1} dari {totalSesi}</span>
  )}
  {totalSoalSemuaPaket > 0 && <span class="tka-meta">📝 {totalSoalSemuaPaket} soal ({paket.length} paket)</span>}
  {durasi && <span class="tka-meta">⏱ ~{durasi} menit</span>}
</div>

{deskripsiTampil && <p class="pd-lede">{deskripsiTampil}</p>}

{tujuanPembelajaran.length > 0 && (
  <div class="pd-tujuan">
    <p class="pd-tujuan-label">Yang Diuji</p>
    <ul>
      {tujuanPembelajaran.map((t: string) => <li>{t}</li>)}
    </ul>
  </div>
)}

{materi && (
  <div class="tka-materi-card">
    <p class="tka-materi-label">📖 Ringkasan Materi</p>
    <h2 class="tka-materi-title">{materi.data.title}</h2>
    <p class="tka-materi-desc">{materi.data.description}</p>
    <a href={`/materi/${materi.id}`} class="tka-materi-link">Baca materi lengkap &rarr;</a>
  </div>
)}

{paket.length > 0 && (
  <div class="tka-drill-heading">
    <p class="tka-drill-eyebrow">🎯 Latihan Soal</p>
    <h2>Siap drilling?</h2>
    <p class="tka-drill-desc">
      {paket.length > 1
        ? `Pilih salah satu paket di bawah, atau kerjakan keduanya buat latihan lebih banyak -- soal antar paket berbeda, boleh dikerjakan berkali-kali.`
        : 'Boleh dikerjakan berkali-kali buat mengasah pemahaman & ketepatan.'}
    </p>
  </div>
)}

<div class="tka-drill-grid" data-count={paket.length}>
  {paket.map((p) => (
    <div class="tka-drill-card">
      <p class="tka-drill-paket-label">{p.label}</p>
      <p class="tka-drill-desc">
        {p.jumlahSoal !== undefined
          ? `${p.jumlahSoal} soal latihan gaya TKA (variasi tipe soal + HOTS)`
          : 'Latihan soal untuk paket ini.'}
      </p>
      {p.tugasUrl ? (
        <a href={p.tugasUrl} class="btn btn-primary tka-drill-cta">Mulai {p.label} &rarr;</a>
      ) : (
        <span class="pd-step-unavailable">— Belum tersedia.</span>
      )}
    </div>
  ))}
</div>

<div class="pd-nav-grid">
  <div class="pd-nav-slot">
    {sesiSebelumnya ? (
      <a href={`/ruang-belajar/${sesiSebelumnya.id}`} class="pd-next-card">
        <span class="pd-next-label">⬅️ Sesi Sebelumnya</span>
        <span class="pd-next-judul">{sesiSebelumnya.data.judul}</span>
        <span class="pd-next-cta">&larr; Lihat lagi</span>
      </a>
    ) : (
      <div class="pd-next-selesai">
        <span class="pd-next-label">🏁 Sesi Pertama</span>
        <p>Ini sesi latihan paling awal untuk {mapel} TKA saat ini.</p>
      </div>
    )}
  </div>

  <div class="pd-nav-slot">
    {sesiBerikutnya ? (
      <a href={`/ruang-belajar/${sesiBerikutnya.id}`} class="pd-next-card">
        <span class="pd-next-label">➡️ Sesi Berikutnya</span>
        <span class="pd-next-judul">{sesiBerikutnya.data.judul}</span>
        <span class="pd-next-cta">Lanjut &rarr;</span>
      </a>
    ) : (
      <div class="pd-next-selesai">
        <span class="pd-next-label">🎉 Sesi Terakhir</span>
        <p>
          Ini sesi latihan terakhir untuk {mapel} TKA saat ini. Sesi berikutnya akan ditambahkan menyusul -- lihat
          <a href="/ruang-belajar/kelas/tka">semua Bab TKA</a> sementara menunggu.
        </p>
      </div>
    )}
  </div>
</div>

<style>
  .tka-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .tka-meta {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .tka-meta-bab {
    font-weight: 700;
    color: var(--accent);
  }

  .tka-materi-card {
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.75rem;
    margin: 2rem 0;
  }

  .tka-materi-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin: 0 0 0.5rem;
  }

  .tka-materi-title {
    font-size: 1.1875rem;
    margin: 0 0 0.5rem;
  }

  .tka-materi-desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0 0 0.85rem;
  }

  .tka-materi-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .tka-materi-link:hover {
    text-decoration: underline;
  }

  .tka-drill-heading {
    text-align: center;
    margin-top: 1.5rem;
  }

  .tka-drill-eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rose);
    margin: 0 0 0.5rem;
  }

  .tka-drill-heading h2 {
    font-size: 1.5rem;
    margin: 0 0 0.6rem;
  }

  .tka-drill-desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    max-width: 32rem;
    margin: 0 auto;
  }

  .tka-drill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0 2.5rem;
  }

  /* Satu paket saja -- kartu tunggal jangan melebar penuh, biar tetap
     terasa seperti CTA fokus, bukan grid kosong separuh layar. */
  .tka-drill-grid[data-count='1'] {
    grid-template-columns: minmax(0, 28rem);
    justify-content: center;
  }

  .tka-drill-card {
    background: linear-gradient(135deg, var(--rose-soft), var(--gold-soft));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tka-drill-paket-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }

  .tka-drill-card .tka-drill-desc {
    margin-bottom: 1.25rem;
  }

  .tka-drill-cta {
    font-size: 1.0625rem;
    padding: 0.9rem 2rem;
  }
</style>
