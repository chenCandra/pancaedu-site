---
// Layout KHUSUS sesi Ruang Belajar untuk kelas TKA -- sengaja BEDA dari
// "Learning Path" 6 langkah yang dipakai Kelas X/XI/XII (lihat
// src/pages/ruang-belajar/[slug].astro). TKA fokusnya drilling soal, bukan
// pembelajaran bertahap: TIDAK ADA step Video, Eksperimen/Lab Maya, atau
// Refleksi -- cuma 2 bagian: ringkasan materi singkat (suplemen, bukan
// gerbang wajib) dan satu CTA besar ke latihan soal (mesin `penugasan` yang
// sama dipakai kelas lain, boleh dikerjakan berkali-kali).
import type { CollectionEntry } from 'astro:content';

interface Props {
  judul: string;
  mapel: string;
  deskripsi?: string;
  tujuanPembelajaran: string[];
  materi?: CollectionEntry<'blog'>;
  tugasUrl?: string;
  jumlahSoal?: number;
  durasi?: number;
  babInfo?: { nomor: number; nama: string; posisi: number; total: number };
  indexSekarang: number;
  totalSesi: number;
  sesiSebelumnya?: CollectionEntry<'ruangBelajar'>;
  sesiBerikutnya?: CollectionEntry<'ruangBelajar'>;
}

const {
  judul, mapel, deskripsi, tujuanPembelajaran, materi, tugasUrl, jumlahSoal, durasi,
  babInfo, indexSekarang, totalSesi, sesiSebelumnya, sesiBerikutnya,
} = Astro.props;

const deskripsiTampil = deskripsi || materi?.data.description;
---

<a href="/ruang-belajar/kelas/tka" class="small-back">&larr; TKA</a>

<p class="eyebrow">🎯 Latihan TKA — {mapel}</p>
<h1>{judul}</h1>

<div class="tka-meta-row">
  {babInfo ? (
    <span class="tka-meta tka-meta-bab">📘 {babInfo.nama} — Sesi {babInfo.posisi} dari {babInfo.total}</span>
  ) : (
    indexSekarang >= 0 && <span class="tka-meta tka-meta-bab">📍 Sesi {indexSekarang + 1} dari {totalSesi}</span>
  )}
  {jumlahSoal !== undefined && <span class="tka-meta">📝 {jumlahSoal} soal</span>}
  {durasi && <span class="tka-meta">⏱ ~{durasi} menit</span>}
</div>

{deskripsiTampil && <p class="pd-lede">{deskripsiTampil}</p>}

{tujuanPembelajaran.length > 0 && (
  <div class="pd-tujuan">
    <p class="pd-tujuan-label">Yang Diuji</p>
    <ul>
      {tujuanPembelajaran.map((t: string) => <li>{t}</li>)}
    </ul>
  </div>
)}

{materi && (
  <div class="tka-materi-card">
    <p class="tka-materi-label">📖 Ringkasan Materi</p>
    <h2 class="tka-materi-title">{materi.data.title}</h2>
    <p class="tka-materi-desc">{materi.data.description}</p>
    <a href={`/materi/${materi.id}`} class="tka-materi-link">Baca materi lengkap &rarr;</a>
  </div>
)}

<div class="tka-drill-card">
  <p class="tka-drill-eyebrow">🎯 Latihan Soal</p>
  <h2>Siap drilling?</h2>
  <p class="tka-drill-desc">
    {jumlahSoal !== undefined
      ? `${jumlahSoal} soal latihan gaya TKA (variasi tipe soal + HOTS) -- boleh dikerjakan berkali-kali buat mengasah pemahaman & ketepatan.`
      : 'Latihan soal untuk sesi ini.'}
  </p>
  {tugasUrl ? (
    <a href={tugasUrl} class="btn btn-primary tka-drill-cta">Mulai Latihan Soal &rarr;</a>
  ) : (
    <span class="pd-step-unavailable">— Latihan belum tersedia untuk sesi ini.</span>
  )}
</div>

<div class="pd-nav-grid">
  <div class="pd-nav-slot">
    {sesiSebelumnya ? (
      <a href={`/ruang-belajar/${sesiSebelumnya.id}`} class="pd-next-card">
        <span class="pd-next-label">⬅️ Sesi Sebelumnya</span>
        <span class="pd-next-judul">{sesiSebelumnya.data.judul}</span>
        <span class="pd-next-cta">&larr; Lihat lagi</span>
      </a>
    ) : (
      <div class="pd-next-selesai">
        <span class="pd-next-label">🏁 Sesi Pertama</span>
        <p>Ini sesi latihan paling awal untuk {mapel} TKA saat ini.</p>
      </div>
    )}
  </div>

  <div class="pd-nav-slot">
    {sesiBerikutnya ? (
      <a href={`/ruang-belajar/${sesiBerikutnya.id}`} class="pd-next-card">
        <span class="pd-next-label">➡️ Sesi Berikutnya</span>
        <span class="pd-next-judul">{sesiBerikutnya.data.judul}</span>
        <span class="pd-next-cta">Lanjut &rarr;</span>
      </a>
    ) : (
      <div class="pd-next-selesai">
        <span class="pd-next-label">🎉 Sesi Terakhir</span>
        <p>
          Ini sesi latihan terakhir untuk {mapel} TKA saat ini. Sesi berikutnya akan ditambahkan menyusul -- lihat
          <a href="/ruang-belajar/kelas/tka">semua Bab TKA</a> sementara menunggu.
        </p>
      </div>
    )}
  </div>
</div>

<style>
  .tka-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .tka-meta {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .tka-meta-bab {
    font-weight: 700;
    color: var(--accent);
  }

  .tka-materi-card {
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.75rem;
    margin: 2rem 0;
  }

  .tka-materi-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-soft);
    margin: 0 0 0.5rem;
  }

  .tka-materi-title {
    font-size: 1.1875rem;
    margin: 0 0 0.5rem;
  }

  .tka-materi-desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0 0 0.85rem;
  }

  .tka-materi-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .tka-materi-link:hover {
    text-decoration: underline;
  }

  .tka-drill-card {
    background: linear-gradient(135deg, var(--rose-soft), var(--gold-soft));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 2rem 2.25rem;
    margin: 1.5rem 0 2.5rem;
    text-align: center;
  }

  .tka-drill-eyebrow {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rose);
    margin: 0 0 0.5rem;
  }

  .tka-drill-card h2 {
    font-size: 1.5rem;
    margin: 0 0 0.6rem;
  }

  .tka-drill-desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    max-width: 32rem;
    margin: 0 auto 1.5rem;
  }

  .tka-drill-cta {
    font-size: 1.0625rem;
    padding: 0.9rem 2rem;
  }
</style>
