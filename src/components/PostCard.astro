---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, category, mapel, kelas, pubDate, coverImage, simulasi } = post.data;
const basePath = category === 'materi' ? '/materi' : '/artikel';
const formattedDate = pubDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<a href={`${basePath}/${post.id}`} class="post-card card" data-kelas={kelas} data-mapel={mapel}>
  {coverImage && <img src={coverImage} alt="" loading="lazy" />}
  <div class="post-card-body">
    <div class="post-card-meta">
      <span class:list={['badge', category === 'materi' && 'badge-gold']}>
        {category === 'materi' ? (mapel ?? 'Materi') : 'Artikel'}
      </span>
      {category === 'materi' && kelas && <span class="badge">Kelas {kelas}</span>}
      {simulasi && <span class="badge">🧪 Lab Maya</span>}
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  /* Wajib lebih spesifik dari .post-card di atas, kalau tidak atribut hidden
     (dipakai filter kelas/mapel di materi/index.astro) ketiban `display: flex`
     dan tidak pernah benar-benar hilang — bug berulang yang sama seperti di
     CookieConsent.astro & halaman hasil-ujian. */
  .post-card[hidden] {
    display: none;
  }

  .post-card:hover {
    transform: translateY(-2px);
  }

  .post-card img {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .post-card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .post-card h3 {
    font-size: 1.15rem;
    margin: 0;
  }

  .post-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
