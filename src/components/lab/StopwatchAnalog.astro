---
// Simulasi stopwatch analog -- Lab Maya, kategori Waktu.
//
// Cara bacanya SENGAJA dibuat mengikuti pola yang sama dengan simulasi lab
// lain (jumlahkan beberapa skala): jangka sorong = skala utama + nonius,
// mikrometer sekrup = skala utama + skala putar, neraca tiga lengan =
// ratusan + puluhan + satuan, stopwatch ini = menit (subdial kecil) +
// detik (jarum besar). Palet warna & gaya "metalik" dibuat SENADA sama
// JangkaSorong/NeracaOhaus (gradasi abu-abu yang sama persis), dan pola
// dial-nya niru struktur trigonometri yang sama kayak MikrometerSekrup
// (dial lingkaran, tick dihitung dari sudut).
//
// Bedanya sama 3 simulasi lain: di sini TIDAK ada yang digeser. Murid
// tekan "Mulai", jarumnya "berlari" (animasi berputar cepat) terus
// berhenti sendiri di suatu titik acak (tersembunyi) -- persis kayak
// pakai stopwatch sungguhan: nyalain, nanti berhenti, baru dibaca
// hasilnya.
import '../../styles/lab.css';

const DIAL_CX = 50;
const DIAL_CY = 54;
const CASE_R = 48;
const FACE_R = 43;
const R_INNER = 30;
const R_MINOR = 34;
const R_MAJOR = 36;
const R_LABEL = 40;

const secondTicks = Array.from({ length: 60 }, (_, i) => {
  const angleDeg = (i / 60) * 360 - 90; // i=0 di posisi jam 12 (atas)
  const angleRad = (angleDeg * Math.PI) / 180;
  const isMajor = i % 5 === 0;
  const rOuter = isMajor ? R_MAJOR : R_MINOR;
  return {
    i,
    isMajor,
    x1: DIAL_CX + R_INNER * Math.cos(angleRad),
    y1: DIAL_CY + R_INNER * Math.sin(angleRad),
    x2: DIAL_CX + rOuter * Math.cos(angleRad),
    y2: DIAL_CY + rOuter * Math.sin(angleRad),
    lx: DIAL_CX + R_LABEL * Math.cos(angleRad),
    ly: DIAL_CY + R_LABEL * Math.sin(angleRad),
  };
});

const SUB_CX = 50;
const SUB_CY = 29;
const SUB_R = 13;
const SUB_R_INNER = 6;
const SUB_R_MAJOR = 8.5;
const SUB_R_LABEL = 11;

// Subdial cuma 0..5 menit (bukan 0..59) -- durasi contoh di simulasi ini
// dibatasi maksimal ~5 menit, biar bacaan menitnya tetap masuk akal buat
// latihan (stopwatch sungguhan subdialnya bisa sampai 30, tapi itu bikin
// durasi tunggu/animasinya kelamaan buat latihan online).
const minuteTicks = Array.from({ length: 6 }, (_, i) => {
  const angleDeg = (i / 6) * 360 - 90;
  const angleRad = (angleDeg * Math.PI) / 180;
  return {
    i,
    x1: SUB_CX + SUB_R_INNER * Math.cos(angleRad),
    y1: SUB_CY + SUB_R_INNER * Math.sin(angleRad),
    x2: SUB_CX + SUB_R_MAJOR * Math.cos(angleRad),
    y2: SUB_CY + SUB_R_MAJOR * Math.sin(angleRad),
    lx: SUB_CX + SUB_R_LABEL * Math.cos(angleRad),
    ly: SUB_CY + SUB_R_LABEL * Math.sin(angleRad),
  };
});
---

<div class="jsl swm" data-swm>
  <div class="jsl-card card">
    <div class="jsl-stage">
      <svg
        class="jsl-svg"
        viewBox="-2 -8 104 118"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label="Ilustrasi stopwatch analog"
      >
        <defs>
          <linearGradient id="swm-case-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#8b93a3" />
            <stop offset="100%" stop-color="#5b6272" />
          </linearGradient>
        </defs>

        <!-- Tombol atas (dekoratif, mewakili tombol start/stop fisiknya) -->
        <rect x="44" y="-5" width="12" height="10" rx="2.5" class="swm-crown" />

        <!-- Casing & muka jam -->
        <circle cx={DIAL_CX} cy={DIAL_CY} r={CASE_R} class="swm-case" />
        <circle cx={DIAL_CX} cy={DIAL_CY} r={FACE_R} class="swm-face" />

        <!-- Skala detik (jarum besar, 0–59 detik, satu putaran = 60 detik) -->
        {secondTicks.map((t) => (
          <line
            x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2}
            class={t.isMajor ? 'jsl-tick jsl-tick-major' : 'jsl-tick'}
          />
        ))}
        {secondTicks.filter((t) => t.isMajor).map((t) => (
          <text x={t.lx} y={t.ly} class="jsl-label swm-label-main" text-anchor="middle" dominant-baseline="middle">{t.i}</text>
        ))}

        <!-- Subdial skala menit (jarum kecil, 0–5 menit) -->
        <circle cx={SUB_CX} cy={SUB_CY} r={SUB_R} class="swm-subdial-ring" />
        {minuteTicks.map((t) => (
          <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="jsl-tick jsl-tick-major" />
        ))}
        {minuteTicks.map((t) => (
          <text x={t.lx} y={t.ly} class="jsl-label swm-label-sub" text-anchor="middle" dominant-baseline="middle">{t.i}</text>
        ))}

        <!-- Jarum detik (besar) -- diputar lewat JS pas tombol Mulai ditekan -->
        <line data-hand="second" x1={DIAL_CX} y1={DIAL_CY + 5} x2={DIAL_CX} y2={DIAL_CY - R_INNER} class="swm-hand swm-hand-main" />
        <!-- Jarum menit (subdial kecil) -->
        <line data-hand="minute" x1={SUB_CX} y1={SUB_CY + 2} x2={SUB_CX} y2={SUB_CY - SUB_R_INNER} class="swm-hand swm-hand-sub" />

        <circle cx={DIAL_CX} cy={DIAL_CY} r="1.3" class="swm-pin" />
        <circle cx={SUB_CX} cy={SUB_CY} r="0.9" class="swm-pin" />
      </svg>
    </div>

    <div class="swm-actions">
      <button type="button" class="btn btn-primary" data-start>▶️ Mulai</button>
    </div>

    <p class="jsl-hint" data-hint>👉 Tekan Mulai buat menjalankan stopwatch-nya.</p>

    <div class="jsl-controls" data-controls>
      <label for="swm-guess">Menurut bacaan kamu, berapa detik hasilnya?</label>
      <div class="jsl-input-row">
        <input
          type="text"
          inputmode="decimal"
          id="swm-guess"
          data-guess
          placeholder="contoh: 154"
          autocomplete="off"
        />
        <button type="button" class="btn btn-primary" data-check>Cek Jawaban</button>
      </div>
    </div>

    <div class="jsl-result" data-result hidden>
      <p class="jsl-result-headline" data-result-headline></p>
      <p class="jsl-result-detail" data-result-detail></p>
      <button type="button" class="btn btn-ghost" data-retry>🔄 Coba Lagi (Waktu Baru)</button>
    </div>
  </div>
</div>

<style>
  /* Style dasar (.jsl-card, .jsl-stage, .jsl-svg, tick, label, hint,
     controls, result, dst) ada di src/styles/lab.css. Di sini cuma style
     KHUSUS stopwatch (casing, dial, jarum). */

  .swm-crown {
    fill: url(#swm-case-fill);
    stroke: rgba(0, 0, 0, 0.3);
    stroke-width: 0.3;
  }

  .swm-case {
    fill: url(#swm-case-fill);
    stroke: var(--border-strong);
    stroke-width: 0.4;
  }

  .swm-face {
    fill: var(--surface-solid);
    stroke: var(--border);
    stroke-width: 0.3;
  }

  .swm-subdial-ring {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 0.35;
  }

  .swm-label-main {
    font-size: 3.6px;
  }

  .swm-label-sub {
    font-size: 2.6px;
  }

  /* Jarumnya diputar lewat CSS transform (bukan atribut SVG) supaya
     transition-nya kepakai reliable lintas browser -- transform-origin
     dipatok pas di titik pusat masing-masing dial (koordinatnya HARUS
     senilai sama dengan DIAL_CX/CY & SUB_CX/CY di markup). */
  .swm-hand {
    transition: transform 1.7s cubic-bezier(0.22, 0.9, 0.28, 1);
  }

  .swm-hand-main {
    transform-origin: 50px 54px;
    stroke: var(--accent);
    stroke-width: 0.9;
    stroke-linecap: round;
  }

  .swm-hand-sub {
    transform-origin: 50px 29px;
    stroke: var(--accent-2);
    stroke-width: 0.8;
    stroke-linecap: round;
  }

  .swm-pin {
    fill: var(--ink);
  }

  .swm-actions {
    margin-top: 1rem;
    text-align: center;
  }
</style>

<script>
  import { playClick } from '../../lib/clickSound';

  const MIN_SECONDS = 8;
  const MAX_SECONDS = 305; // sampai sekitar 5 menit -- cocok sama batas subdial menit (0-5)
  const SPIN_MS = 1700; // durasi animasi "berlari" -- HARUS senilai sama dengan transition di CSS
  const EXTRA_TURNS_SEC = 5; // putaran ekstra jarum detik biar berasa "berlari", bukan langsung loncat
  const EXTRA_TURNS_MIN = 1;

  function initStopwatch(root: HTMLElement) {
    const handMain = root.querySelector<SVGLineElement>('[data-hand="second"]')!;
    const handSub = root.querySelector<SVGLineElement>('[data-hand="minute"]')!;
    const startBtn = root.querySelector<HTMLButtonElement>('[data-start]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const guessInput = root.querySelector<HTMLInputElement>('[data-guess]')!;
    const checkBtn = root.querySelector<HTMLButtonElement>('[data-check]')!;
    const resultBox = root.querySelector<HTMLElement>('[data-result]')!;
    const resultHeadline = root.querySelector<HTMLElement>('[data-result-headline]')!;
    const resultDetail = root.querySelector<HTMLElement>('[data-result-detail]')!;
    const retryBtn = root.querySelector<HTMLButtonElement>('[data-retry]')!;

    let targetSeconds = 0;
    let state: 'idle' | 'running' | 'stopped' | 'locked' = 'idle';
    let secDegAccum = 0;
    let minDegAccum = 0;

    function setHandsInstant(deg: number) {
      // Reset ke 0 TANPA ikut animasi transition (buat ronde baru) --
      // matikan transition sesaat, paksa reflow, baru nyalain lagi.
      handMain.style.transition = 'none';
      handSub.style.transition = 'none';
      handMain.style.transform = `rotate(${deg}deg)`;
      handSub.style.transform = `rotate(${deg}deg)`;
      void handMain.getBoundingClientRect();
      handMain.style.transition = '';
      handSub.style.transition = '';
    }

    function newRound() {
      targetSeconds = Math.floor(MIN_SECONDS + Math.random() * (MAX_SECONDS - MIN_SECONDS));
      state = 'idle';
      secDegAccum = 0;
      minDegAccum = 0;
      setHandsInstant(0);

      startBtn.disabled = false;
      guessInput.value = '';
      guessInput.disabled = false;
      checkBtn.disabled = true;
      controls.hidden = false;
      resultBox.hidden = true;
      hint.dataset.state = 'open';
      hint.textContent = '👉 Tekan Mulai buat menjalankan stopwatch-nya.';
    }

    function spin() {
      if (state !== 'idle') return;
      state = 'running';
      startBtn.disabled = true;
      checkBtn.disabled = true;
      hint.dataset.state = 'open';
      hint.textContent = '⏱️ Stopwatch sedang berjalan...';
      playClick();

      // Selalu diputar MAJU (searah jarum jam) dari posisi sekarang,
      // ditambah beberapa putaran ekstra biar kelihatan "berlari" dulu
      // sebelum berhenti pas di detik/menit targetnya.
      const finalSec = (targetSeconds % 60) * 6; // 360/60 = 6 derajat per detik
      const currentSecMod = ((secDegAccum % 360) + 360) % 360;
      const deltaSec = ((finalSec - currentSecMod) % 360 + 360) % 360;
      secDegAccum += EXTRA_TURNS_SEC * 360 + deltaSec;
      handMain.style.transform = `rotate(${secDegAccum}deg)`;

      const finalMin = (Math.floor(targetSeconds / 60) % 6) * 60; // 360/6 = 60 derajat per menit
      const currentMinMod = ((minDegAccum % 360) + 360) % 360;
      const deltaMin = ((finalMin - currentMinMod) % 360 + 360) % 360;
      minDegAccum += EXTRA_TURNS_MIN * 360 + deltaMin;
      handSub.style.transform = `rotate(${minDegAccum}deg)`;

      window.setTimeout(() => {
        state = 'stopped';
        checkBtn.disabled = false;
        hint.dataset.state = 'closed';
        hint.textContent = '✓ Stopwatch berhenti — sekarang coba baca hasilnya.';
        playClick();
      }, SPIN_MS);
    }

    function parseGuess(raw: string): number | null {
      const normalized = raw.trim().replace(',', '.');
      if (!normalized) return null;
      const n = Number(normalized);
      return Number.isFinite(n) ? n : null;
    }

    function onCheck() {
      if (state !== 'stopped') return;
      const guess = parseGuess(guessInput.value);
      if (guess === null) {
        guessInput.focus();
        return;
      }

      state = 'locked';
      guessInput.disabled = true;
      checkBtn.disabled = true;

      const menit = Math.floor(targetSeconds / 60);
      const detik = targetSeconds % 60;
      const isCorrect = Math.abs(guess - targetSeconds) < 0.5;

      resultBox.hidden = false;
      resultBox.dataset.correct = String(isCorrect);
      resultHeadline.textContent = isCorrect ? 'Benar! 🎉' : 'Kurang tepat, coba baca lagi ya.';

      const caraTxt = `📐 Cara bacanya: Menit (subdial kecil) = <strong>${menit} menit</strong> + Detik (jarum besar) = <strong>${detik} detik</strong> → ${menit} × 60 + ${detik} = <strong>${targetSeconds} detik</strong>.`;
      const bacaanTxt = `Bacaan stopwatch: <strong>${targetSeconds} detik</strong> (${menit} menit ${detik} detik).`;

      resultDetail.innerHTML = `${bacaanTxt}<br><br>${caraTxt}`;
    }

    startBtn.addEventListener('click', spin);
    checkBtn.addEventListener('click', onCheck);
    guessInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') onCheck();
    });
    retryBtn.addEventListener('click', newRound);

    newRound();
  }

  document.querySelectorAll<HTMLElement>('[data-swm]').forEach(initStopwatch);
</script>
