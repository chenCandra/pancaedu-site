---
// Simulasi jangka sorong interaktif — Lab Maya.
//
// Sistem koordinat SVG dipakai langsung sebagai milimeter (1 unit SVG =
// 1 mm), jadi translate(x,0) buat gerakin rahang tidak perlu konversi skala
// terpisah di JS. Skala utama (0–100mm) & skala nonius (11 garis, jarak
// 0.9mm/garis — konstruksi baku nonius 10 divisi/9mm) dibuat statis di sini
// (build-time), cuma posisi grup rahang-gerak & highlight garis nonius yang
// diubah JS saat drag.
//
// REVISI: bentuknya digambar ulang biar menyerupai jangka sorong sungguhan
// -- rahang berbentuk "step" (blok tebal nempel di badan, meruncing jadi
// bilah tipis di ujung yang nyentuh benda), rahang geser digambar sebagai
// blok slider yang lebih besar (nampung skala nonius + roda ibu jari
// berkerat), badan skala digambar sebagai balok logam. Warnanya sengaja
// abu-abu metalik (bukan biru/ungu terang) biar kerasa "besi", bukan
// plastik mainan.
import '../../styles/lab.css';

const mainTicks = Array.from({ length: 101 }, (_, i) => i); // 0..100 mm
const noniusTicks = Array.from({ length: 11 }, (_, i) => i); // 0..10 (jarak 0.9mm)

// Roda ibu jari (thumb wheel) di blok slider -- posisinya di atas skala
// nonius (biar nggak numpuk), diameternya pas muat di lebar blok.
const wheel = { x: 6.5, y: 5, r: 2.6 };
const knurls = Array.from({ length: 12 }, (_, i) => {
  const angle = (i / 12) * Math.PI * 2;
  const rInner = wheel.r - 0.8;
  return {
    x1: wheel.x + Math.cos(angle) * rInner,
    y1: wheel.y + Math.sin(angle) * rInner,
    x2: wheel.x + Math.cos(angle) * wheel.r,
    y2: wheel.y + Math.sin(angle) * wheel.r,
  };
});
---

<div class="jsl" data-jsl>
  <div class="jsl-card card">
    <div class="jsl-stage">
      <svg
        class="jsl-svg"
        viewBox="-6 -4 116 58"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label="Ilustrasi jangka sorong mengukur sebuah benda"
      >
        <defs>
          <linearGradient id="jsl-steel-beam" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#eef0f3" />
            <stop offset="50%" stop-color="#d6dae1" />
            <stop offset="100%" stop-color="#aeb4c0" />
          </linearGradient>
          <linearGradient id="jsl-steel-jaw" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#e6e9ed" />
            <stop offset="55%" stop-color="#c7ccd5" />
            <stop offset="100%" stop-color="#969cab" />
          </linearGradient>
          <!-- "Jendela intip" di blok rahang geser -- daripada memaksa skala
               utama tampil di atas blok logam (kepalanya kelihatan aneh
               nempel di atas rahang), sekarang blok rahang geser dilubangi
               beneran lewat mask ini: putih = solid/tertutup, hitam =
               transparan/bolong. Lubangnya sengaja diposisikan pas di garis
               indeks (x lokal ~0, tempat nonius mulai) -- itu titik yang
               paling penting dibaca murid buat skala utama. */ -->
          <mask id="jsl-slider-peephole" maskContentUnits="userSpaceOnUse">
            <rect x="-1.3" y="-2.5" width="10.5" height="22.5" rx="0.8" fill="#fff" />
            <rect x="-2.1" y="-1.2" width="6.4" height="14" rx="1" fill="#000" />
          </mask>
        </defs>

        <!-- Badan skala (balok logam di belakang deretan angka & garis) -->
        <rect x="-3" y="-2" width="106" height="16" rx="1.2" class="jsl-beam" />

        <!-- Skala utama (garis + angka) -- digambar di sini, DI BAWAH kedua
             rahang, seperti alat aslinya (skala terukir di badan, rahang
             menutupinya sebagian saat digeser). Bagian yang biasanya
             tertutup blok rahang geser tetap bisa dibaca lewat "jendela
             intip" (lihat mask #jsl-slider-peephole di bawah). -->
        <line x1="0" y1="12" x2="100" y2="12" class="jsl-baseline" />
        {mainTicks.map((i) => (
          <line
            x1={i}
            y1={i % 10 === 0 ? 4 : 8}
            x2={i}
            y2="12"
            class={i % 10 === 0 ? 'jsl-tick jsl-tick-major' : 'jsl-tick'}
          />
        ))}
        {mainTicks.filter((i) => i % 10 === 0).map((i) => (
          <text x={i} y="2.5" class="jsl-label" text-anchor="middle">{i / 10}</text>
        ))}

        <!-- Rahang tetap (di posisi 0) -- blok nempel badan + bilah tipis ke bawah -->
        <rect x="-1.3" y="-2.5" width="2.6" height="16.5" rx="0.5" class="jsl-jaw" />
        <rect x="-0.65" y="14" width="1.3" height="27" rx="0.25" class="jsl-jaw" />

        <!-- Benda yang diukur -->
        <rect
          data-object
          x="0"
          y="27"
          width="10"
          height="11"
          rx="1.5"
          class="jsl-object"
        />

        <!-- Rahang geser (posisinya di-translate lewat JS) -->
        <g data-moving-jaw transform="translate(10,0)">
          <!-- Blok slider (nampung skala nonius & roda ibu jari) -- dilubangi
               lewat mask supaya skala utama di baliknya tetap kelihatan. -->
          <rect x="-1.3" y="-2.5" width="10.5" height="22.5" rx="0.8" class="jsl-jaw" mask="url(#jsl-slider-peephole)" />
          <!-- Bingkai tipis di sekeliling lubang, biar kelihatan seperti
               jendela kaca sungguhan, bukan sekadar bolong kasar. -->
          <rect x="-2.1" y="-1.2" width="6.4" height="14" rx="1" class="jsl-peephole-frame" />
          <!-- Bilah tipis yang nyentuh benda -->
          <rect x="-0.65" y="20" width="1.3" height="21" rx="0.25" class="jsl-jaw" />

          <!-- Skala nonius, ikut nempel & bergerak bareng rahang -->
          <line x1="0" y1="12" x2="9" y2="12" class="jsl-baseline jsl-baseline-nonius" />
          {noniusTicks.map((i) => (
            <line
              data-nonius-tick={i}
              x1={i * 0.9}
              y1="12"
              x2={i * 0.9}
              y2={i % 5 === 0 ? 19 : 16.5}
              class="jsl-tick jsl-tick-nonius"
            />
          ))}

          <!-- Roda ibu jari (thumb wheel) berkerat -- bagian yang digeser di alat asli -->
          <g data-handle class="jsl-handle" tabindex="0" role="slider" aria-label="Geser rahang jangka sorong" aria-valuemin="0" aria-valuemax="90" aria-valuenow="10">
            <circle cx={wheel.x} cy={wheel.y} r={wheel.r + 2} class="jsl-handle-hit" />
            <circle cx={wheel.x} cy={wheel.y} r={wheel.r} class="jsl-wheel" />
            {knurls.map((k) => (
              <line x1={k.x1} y1={k.y1} x2={k.x2} y2={k.y2} class="jsl-wheel-knurl" />
            ))}
          </g>
        </g>
      </svg>
    </div>

    <!-- Angka skala nonius ditulis di sini, bukan di dalam SVG — 11 angka
         kalau dipaksa muat di lebar 9mm skala nonius bakal kepencet & tidak
         kebaca. Badge ini HTML biasa jadi ukuran fontnya independen. -->
    <div class="jsl-nonius-readout">
      <span class="jsl-nonius-caption">Skala nonius</span>
      <div class="jsl-nonius-badges" data-nonius-badges>
        {noniusTicks.map((i) => (
          <span class="jsl-nonius-badge" data-nonius-badge={i}>{i}</span>
        ))}
      </div>
    </div>

    <p class="jsl-hint" data-hint>👉 Putar/geser roda ibu jari di bawah sampai rahangnya nyentuh benda kuning.</p>

    <div class="jsl-controls" data-controls>
      <label for="jsl-guess">Menurut bacaan kamu, berapa cm hasil pengukurannya?</label>
      <div class="jsl-input-row">
        <input
          type="text"
          inputmode="decimal"
          id="jsl-guess"
          data-guess
          placeholder="contoh: 3,47"
          autocomplete="off"
        />
        <button type="button" class="btn btn-primary" data-check>Cek Jawaban</button>
      </div>
    </div>

    <div class="jsl-result" data-result hidden>
      <p class="jsl-result-headline" data-result-headline></p>
      <p class="jsl-result-detail" data-result-detail></p>
      <button type="button" class="btn btn-ghost" data-retry>🔄 Coba Lagi (Benda Baru)</button>
    </div>
  </div>
</div>

<style>
  /* Style dasar (.jsl-card, .jsl-stage, .jsl-svg, tick, jaw, hint,
     controls, result, dst) ada di src/styles/lab.css — dipakai bersama
     komponen lab lain. Di sini cuma style KHUSUS jangka sorong (skala
     nonius, roda ibu jari). */

  /* Badan skala & rahang -- warna metalik (BUKAN token --accent/--accent-2
     situs) supaya kerasa "besi", bukan plastik mainan warna-warni. Style
     ini CUMA berlaku di komponen ini (Astro scoped style) -- kelas
     `.jsl-jaw` yang sama di MikrometerSekrup.astro TIDAK ikut berubah,
     itu masih pakai warna default dari lab.css. */
  .jsl-beam {
    fill: url(#jsl-steel-beam);
    stroke: var(--border-strong);
    stroke-width: 0.15;
  }

  .jsl-jaw {
    fill: url(#jsl-steel-jaw);
  }

  /* Angka skala digambar terakhir (di atas blok slider) supaya tidak
     pernah ketutup rahang -- halo putih tipis di baliknya (paint-order:
     stroke, digambar SEBELUM isi teksnya) biar tetap kebaca jelas walau
     kebetulan lagi persis di atas blok logam abu-abu. */
  .jsl-label {
    paint-order: stroke fill;
    stroke: var(--surface-solid);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }

  /* Bingkai jendela intip di blok rahang geser (lubangnya sendiri dibuat
     lewat mask di markup) -- fill none supaya isinya (skala utama di
     baliknya) tetap kelihatan, cuma dikasih garis tepi biar kelihatan
     seperti kaca sungguhan, bukan sekadar bolong kasar. */
  .jsl-peephole-frame {
    fill: none;
    stroke: rgba(0, 0, 0, 0.4);
    stroke-width: 0.25;
  }

  .jsl-wheel {
    fill: url(#jsl-steel-jaw);
    stroke: rgba(0, 0, 0, 0.4);
    stroke-width: 0.15;
  }

  .jsl-wheel-knurl {
    stroke: rgba(0, 0, 0, 0.45);
    stroke-width: 0.25;
    stroke-linecap: round;
  }

  /* Bantalan karet di belakang roda -- target sentuh lebih besar buat HP,
     sekaligus kelihatan seperti lapisan grip sungguhan (bukan cuma area
     invisible buat drag). */
  .jsl-handle-hit {
    fill: var(--accent-2);
    opacity: 0.28;
    transition: opacity 0.15s ease;
  }

  .jsl-handle:hover .jsl-handle-hit,
  .jsl-handle:focus-visible .jsl-handle-hit {
    opacity: 0.5;
  }

  .jsl-handle:focus-visible .jsl-handle-hit {
    stroke: var(--gold);
    stroke-width: 0.4;
  }

  .jsl-baseline-nonius {
    stroke: var(--ink-soft);
  }

  .jsl-tick-nonius {
    stroke: var(--ink);
    stroke-width: 0.2;
    transition: stroke 0.2s ease, stroke-width 0.2s ease;
  }

  .jsl-tick-nonius[data-active='true'] {
    stroke: var(--gold);
    stroke-width: 0.42;
  }

  .jsl-nonius-readout {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .jsl-nonius-caption {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-2);
    flex-shrink: 0;
  }

  .jsl-nonius-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .jsl-nonius-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: 0.2rem;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-2);
    background: var(--accent-soft);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease,
      color 0.2s ease;
  }

  .jsl-nonius-badge[data-active='true'] {
    background: var(--gold);
    color: var(--accent-ink);
    transform: scale(1.25);
  }
</style>

<script>
  import { playClick } from '../../lib/clickSound';

  const OBJECT_COLORS = ['#ffd66b', '#6ea8ff', '#a78bfa', '#7ee0c3', '#ff9b7a'];
  const MIN_OBJECT_MM = 15; // 1,5 cm
  const MAX_OBJECT_MM = 85; // 8,5 cm
  const MAX_JAW_MM = 96; // batas kanan skala biar gak mepet ujung

  function initJangkaSorong(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('.jsl-svg')!;
    const movingJaw = root.querySelector<SVGGElement>('[data-moving-jaw]')!;
    const handle = root.querySelector<SVGGElement>('[data-handle]')!;
    const objectRect = root.querySelector<SVGRectElement>('[data-object]')!;
    const noniusTicks = Array.from(root.querySelectorAll<SVGLineElement>('[data-nonius-tick]'));
    const noniusBadges = Array.from(root.querySelectorAll<HTMLElement>('[data-nonius-badge]'));
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const guessInput = root.querySelector<HTMLInputElement>('[data-guess]')!;
    const checkBtn = root.querySelector<HTMLButtonElement>('[data-check]')!;
    const resultBox = root.querySelector<HTMLElement>('[data-result]')!;
    const resultHeadline = root.querySelector<HTMLElement>('[data-result-headline]')!;
    const resultDetail = root.querySelector<HTMLElement>('[data-result-detail]')!;
    const retryBtn = root.querySelector<HTMLButtonElement>('[data-retry]')!;

    let objectMm = 0;
    let jawMm = 0;
    let locked = false;
    let dragging = false;
    let dragStartClientX = 0;
    let dragStartJawMm = 0;
    let lastSn = -1; // garis nonius aktif terakhir -- buat deteksi kapan harus "klik"

    const round1 = (n: number) => Math.round(n * 10) / 10;

    function readingParts(mm: number) {
      const su = Math.floor(mm); // skala utama (mm bulat)
      const sn = Math.round((mm - su) * 10); // skala nonius (0-9)
      return { su, sn: sn === 10 ? 0 : sn, suFixed: sn === 10 ? su + 1 : su };
    }

    function newRound() {
      objectMm = round1(MIN_OBJECT_MM + Math.random() * (MAX_OBJECT_MM - MIN_OBJECT_MM));
      objectRect.setAttribute('width', String(objectMm));
      const color = OBJECT_COLORS[Math.floor(Math.random() * OBJECT_COLORS.length)];
      root.style.setProperty('--object-color', color);

      jawMm = MAX_JAW_MM; // mulai kebuka lebar
      lastSn = -1; // reset -- posisi awal ronde baru TIDAK boleh ikut bunyi klik
      updateJawPosition(true);

      locked = false;
      dragging = false;
      guessInput.value = '';
      guessInput.disabled = false;
      checkBtn.disabled = false;
      controls.hidden = false;
      resultBox.hidden = true;
      hint.textContent = '👉 Putar/geser roda ibu jari di bawah sampai rahangnya nyentuh benda kuning.';
      hint.dataset.state = 'open';
    }

    function updateJawPosition(silent = false) {
      movingJaw.setAttribute('transform', `translate(${jawMm},0)`);
      handle.setAttribute('aria-valuenow', String(jawMm));

      const { suFixed, sn } = readingParts(jawMm);
      noniusTicks.forEach((tick) => {
        const idx = Number(tick.dataset.noniusTick);
        tick.dataset.active = idx === sn ? 'true' : 'false';
      });
      noniusBadges.forEach((badge) => {
        const idx = Number(badge.dataset.noniusBadge);
        badge.dataset.active = idx === sn ? 'true' : 'false';
      });

      // Garis nonius aktif baru saja berpindah (digeser/panah) -- bunyikan
      // klik, mensimulasikan detent rahang jangka sorong asli. `silent`
      // dipakai buat panggilan programatis (mis. reset ronde baru) yang
      // BUKAN aksi user, supaya tidak ikut bunyi.
      if (sn !== lastSn) {
        if (!silent) playClick();
        lastSn = sn;
      }

      const closed = jawMm <= objectMm + 0.05;
      if (!locked) {
        hint.dataset.state = closed ? 'closed' : 'open';
        hint.textContent = closed
          ? '✓ Rahang sudah nempel ke benda — sekarang coba baca skalanya.'
          : '👉 Putar/geser roda ibu jari di bawah sampai rahangnya nyentuh benda kuning.';
      }
      void suFixed;
    }

    function clampJaw(mm: number) {
      return Math.min(MAX_JAW_MM, Math.max(objectMm, mm));
    }

    function pxPerMm() {
      const rect = svg.getBoundingClientRect();
      // viewBox width = 116 (dari -6 sampai 110)
      return rect.width / 116;
    }

    function onPointerDown(e: PointerEvent) {
      if (locked) return;
      dragging = true;
      dragStartClientX = e.clientX;
      dragStartJawMm = jawMm;
      handle.setPointerCapture(e.pointerId);
      handle.focus();
    }

    function onPointerMove(e: PointerEvent) {
      if (!dragging) return;
      const deltaPx = e.clientX - dragStartClientX;
      const deltaMm = deltaPx / pxPerMm();
      jawMm = round1(clampJaw(dragStartJawMm + deltaMm));
      updateJawPosition();
    }

    function onPointerUp(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      try {
        handle.releasePointerCapture(e.pointerId);
      } catch {
        /* noop */
      }
    }

    function onKeyDown(e: KeyboardEvent) {
      if (locked) return;
      if (e.key === 'ArrowLeft') {
        jawMm = round1(clampJaw(jawMm - 0.1));
        updateJawPosition();
        e.preventDefault();
      } else if (e.key === 'ArrowRight') {
        jawMm = round1(clampJaw(jawMm + 0.1));
        updateJawPosition();
        e.preventDefault();
      }
    }

    function parseGuess(raw: string): number | null {
      const normalized = raw.trim().replace(',', '.');
      if (!normalized) return null;
      const n = Number(normalized);
      return Number.isFinite(n) ? n : null;
    }

    function onCheck() {
      const guess = parseGuess(guessInput.value);
      if (guess === null) {
        guessInput.focus();
        return;
      }

      locked = true;
      dragging = false;
      guessInput.disabled = true;
      checkBtn.disabled = true;

      const currentReadingCm = round1(jawMm) / 10;
      const trueObjectCm = round1(objectMm) / 10;
      const closedProperly = jawMm <= objectMm + 0.05;
      const isCorrect = Math.abs(guess - currentReadingCm) < 0.02;

      resultBox.hidden = false;
      resultBox.dataset.correct = String(isCorrect);
      resultHeadline.textContent = isCorrect ? 'Benar! 🎉' : 'Kurang tepat, coba baca lagi ya.';

      // Rincian cara baca -- skala utama (SU, garis terakhir yang terlewati
      // di badan sebelum garis 0 nonius) + skala nonius (SN, garis nonius
      // yang paling lurus/berhimpit dengan skala utama) x 0,01 cm.
      const { su, sn } = readingParts(round1(jawMm));
      const suCm = su / 10;
      const snCm = sn / 100;
      const caraTxt = `📐 Cara bacanya: Skala Utama (SU) = <strong>${suCm.toFixed(1)} cm</strong> + Skala Nonius (SN) = garis ke-<strong>${sn}</strong> × 0,01 cm = <strong>${snCm.toFixed(2)} cm</strong> → ${suCm.toFixed(1)} + ${snCm.toFixed(2)} = <strong>${currentReadingCm.toFixed(2)} cm</strong>.`;
      const bacaanTxt = `Bacaan skala saat ini: <strong>${currentReadingCm.toFixed(2)} cm</strong>.`;
      const bendaTxt = `Ukuran benda sebenarnya: <strong>${trueObjectCm.toFixed(2)} cm</strong>.`;
      const closeTxt = closedProperly
        ? ''
        : ' Rahangnya belum full nempel ke benda, jadi bacaannya lebih besar dari ukuran aslinya — coba tutup rapat dulu di ronde berikutnya.';

      resultDetail.innerHTML = `${bacaanTxt} ${bendaTxt}${closeTxt}<br><br>${caraTxt}`;
    }

    handle.addEventListener('pointerdown', onPointerDown);
    handle.addEventListener('pointermove', onPointerMove);
    handle.addEventListener('pointerup', onPointerUp);
    handle.addEventListener('pointercancel', onPointerUp);
    handle.addEventListener('keydown', onKeyDown);
    checkBtn.addEventListener('click', onCheck);
    guessInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') onCheck();
    });
    retryBtn.addEventListener('click', newRound);

    newRound();
  }

  document.querySelectorAll<HTMLElement>('[data-jsl]').forEach(initJangkaSorong);
</script>
