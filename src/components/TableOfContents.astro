---
// Daftar isi otomatis dari sub-judul (##) hasil render Markdown-nya sendiri —
// bukan ditulis manual per artikel. Astro sudah nyediain slug+text tiap
// heading lewat `render(post)`, jadi tinggal difilter & dirender di sini.
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Cuma level 2 (##) — level 3 ke bawah biasanya detail kecil (contoh soal,
// sub-poin) yang bikin daftar isi kepanjangan & kurang berguna buat navigasi.
const items = headings.filter((h) => h.depth === 2);
---

{items.length >= 3 && (
  <nav class="toc card" aria-label="Daftar isi">
    <p class="toc-title">Daftar Isi</p>
    <ol>
      {items.map((h) => (
        <li><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc {
    margin-block: 1.5rem;
    padding: 1.25rem 1.5rem;
  }

  .toc-title {
    margin: 0 0 0.6rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }

  .toc ol {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .toc a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .toc a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
