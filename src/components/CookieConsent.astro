<div id="cookie-consent" class="cookie-consent" hidden>
  <p>
    Situs ini menggunakan cookie untuk mengukur trafik dan menampilkan iklan yang relevan
    (termasuk dari Google AdSense). Dengan melanjutkan, Anda menyetujui
    <a href="/kebijakan-privasi">Kebijakan Privasi</a> kami.
  </p>
  <button type="button" id="cookie-consent-accept" class="btn btn-primary">Mengerti</button>
</div>

<style>
  .cookie-consent {
    position: fixed;
    inset-inline: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    /* [hidden] di bawah wajib lebih spesifik dari rule ini, kalau tidak atribut
       hidden (dipakai buat sembunyikan setelah tombol "Mengerti" diklik) akan
       ketiban `display: flex` di atas dan tidak pernah benar-benar hilang. */
    align-items: center;
    gap: 1rem;
    max-width: 40rem;
    margin-inline: auto;
    padding: 1rem 1.25rem;
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border: 1px solid var(--glass-border);
    border-radius: 1.25rem;
    box-shadow: var(--shadow);
  }

  .cookie-consent p {
    flex: 1 1 16rem;
    margin: 0;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .cookie-consent a {
    color: var(--accent);
  }

  .cookie-consent[hidden] {
    display: none;
  }
</style>

<script>
  const KEY = 'pancaedu_cookie_consent';
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-consent-accept');

  if (banner && !localStorage.getItem(KEY)) {
    banner.hidden = false;
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(KEY, '1');
    if (banner) banner.hidden = true;
  });
</script>
