---
// Tahap 3: hero full-bleed (foto jadi latar SELURUH section, bukan kartu
// terpisah di dalam container) + "Akses Cepat" (panel terpisah) dibuang,
// digantikan baris pil quick-link di dalam teks hero -- lihat permintaan
// user & contoh referensi yang dilampirkan.
import { dummyHero } from '../../data/previewClassicDummy';

// Link REAL (rute sungguhan di situs), bukan dummy -- cuma styling pil +
// ikonnya yang baru.
const quicklinks = [
  {
    label: 'Materi',
    href: '/materi',
    tone: 'accent',
    icon: '<path d="M12 6.3C10.4 4.9 8 4.4 4 4.4v13c4 0 6.4.5 8 1.9 1.6-1.4 4-1.9 8-1.9v-13c-4 0-6.4.5-8 1.9Z"/><path d="M12 6.3v13"/>',
  },
  {
    label: 'Lab Maya',
    href: '/lab-maya',
    tone: 'teal',
    icon: '<path d="M9 2v6.3L3.6 17.6A2 2 0 0 0 5.3 21h13.4a2 2 0 0 0 1.7-3.4L15 8.3V2"/><path d="M8.5 2h7"/><path d="M8 13h8"/>',
  },
  {
    label: 'Game Edukasi',
    href: '/game',
    tone: 'purple',
    icon: '<rect x="2" y="7" width="20" height="10" rx="4"/><circle cx="8" cy="12" r="1.4"/><path d="M8 10.2v3.6M6.2 12h3.6"/><circle cx="16.5" cy="10.3" r="1"/><circle cx="18.5" cy="13.3" r="1"/>',
  },
  {
    label: 'Artikel',
    href: '/artikel',
    tone: 'gold',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h8"/>',
  },
  {
    label: 'Perkakas',
    href: '/tools',
    tone: 'rose',
    icon: '<path d="M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 1 5.4-5.4l-2.6 2.6-2-2z"/>',
  },
];
---

<section class="cp-hero">
  <img
    class="cp-hero-bg"
    src="/images/preview-classic/hero-fisika-desk.png"
    alt=""
    loading="eager"
  />
  <div class="cp-hero-scrim" aria-hidden="true"></div>

  <div class="cp-container cp-hero-inner">
    <h1 class="cp-hero-title">
      <span>{dummyHero.titleLine1}</span>
      <span class="cp-hero-title-accent">{dummyHero.titleLine2}</span>
    </h1>
    <p class="cp-hero-excerpt">{dummyHero.excerpt}</p>

    <div class="cp-hero-quicklinks">
      {quicklinks.map((item) => (
        <a href={item.href} class="cp-hero-quicklink" data-tone={item.tone}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
          <span>{item.label}</span>
          <span class="cp-hero-quicklink-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <form class="cp-hero-search" action="/cari" method="get">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input type="search" name="q" placeholder="Cari materi, simulasi, game, atau artikel..." aria-label="Cari" />
      <button type="submit">Cari</button>
    </form>
  </div>
</section>
