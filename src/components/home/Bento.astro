---
import { getCollection } from 'astro:content';

const [homepage] = await getCollection('homepage');
const { bentoItems: items } = homepage.data;
---

<section class="section bento">
  <div class="container">
    <p class="eyebrow" data-reveal>Keahlian &amp; Peran</p>
    <div class="bento-grid">
      {items.map((item) => (
        <div class:list={['bento-card', `bento-card--${item.size}`]} data-reveal>
          <span class="bento-icon" aria-hidden="true">{item.icon}</span>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(9rem, auto);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .bento-card {
    position: relative;
    padding: 1.75rem;
    border-radius: var(--radius-md);
    background: var(--surface);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid var(--glass-border);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
  }

  .bento-card:hover {
    box-shadow: var(--shadow-md), var(--glow-accent);
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }

  .bento-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.25rem;
    border-radius: 50%;
    font-size: 1.375rem;
    background: linear-gradient(135deg, var(--gold-soft), transparent 70%), var(--surface);
    border: 1px solid var(--glass-border);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .bento-card:hover .bento-icon {
    animation: icon-wiggle 0.6s ease-in-out;
  }

  @keyframes icon-wiggle {
    0%, 100% { transform: rotate(0deg) scale(1); }
    25% { transform: rotate(-12deg) scale(1.1); }
    50% { transform: rotate(10deg) scale(1.1); }
    75% { transform: rotate(-6deg) scale(1.05); }
  }

  .bento-card h3 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .bento-card p {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .bento-card--lg {
    grid-column: span 2;
    grid-row: span 2;
  }

  .bento-card--lg .bento-icon {
    width: 3.5rem;
    height: 3.5rem;
    font-size: 1.75rem;
  }

  .bento-card--lg h3 {
    font-size: 1.5rem;
  }

  .bento-card--md {
    grid-column: span 2;
  }

  .bento-card--sm {
    grid-column: span 2;
  }

  @media (min-width: 60rem) {
    .bento-card--sm {
      grid-column: span 1;
    }
  }

  @media (max-width: 48rem) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .bento-card--lg,
    .bento-card--md,
    .bento-card--sm {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
