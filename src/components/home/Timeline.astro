---
// Milestone situs yang benar-benar terjadi (bukan karir personal yang belum
// ada datanya) — tetap jujur sambil mengisi bentuk section "Timeline".
const milestones = [
  {
    icon: '🚀',
    label: 'Awal',
    title: 'PancaEdu diluncurkan',
    desc: 'Ruang menulis pribadi dimulai: artikel refleksi mengajar dan materi pelajaran pertama.',
  },
  {
    icon: '🧪',
    label: 'Berkembang',
    title: 'Lab Maya hadir',
    desc: 'Simulasi interaktif mulai ditanamkan langsung di halaman materi, dimulai dari Fisika.',
  },
  {
    icon: '🗂️',
    label: 'Sekarang',
    title: 'Materi per jenjang kelas',
    desc: 'Struktur Kelas X–XII disusun supaya materi lebih mudah ditemukan sesuai kebutuhan.',
  },
];
---

<section class="section timeline">
  <div class="container">
    <p class="eyebrow" data-reveal>Perjalanan PancaEdu</p>
    <ol class="timeline-list">
      {milestones.map((m) => (
        <li class="timeline-item" data-reveal>
          <div class="timeline-marker">
            <span class="timeline-icon" aria-hidden="true">{m.icon}</span>
            <span class="timeline-label">{m.label}</span>
          </div>
          <div class="timeline-body">
            <h3>{m.title}</h3>
            <p>{m.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline-list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .timeline-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .timeline-marker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .timeline-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    font-size: 1.2rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: var(--glow-accent);
  }

  .timeline-item:hover .timeline-icon {
    animation: icon-wiggle 0.6s ease-in-out;
  }

  @keyframes icon-wiggle {
    0%, 100% { transform: rotate(0deg) scale(1); }
    25% { transform: rotate(-12deg) scale(1.1); }
    50% { transform: rotate(10deg) scale(1.1); }
    75% { transform: rotate(-6deg) scale(1.05); }
  }

  .timeline-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .timeline-body h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .timeline-body p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    max-width: 34rem;
  }

  @media (max-width: 36rem) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
