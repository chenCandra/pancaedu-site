---
import { getCollection } from 'astro:content';

const [homepage] = await getCollection('homepage');
const { heroLede } = homepage.data;

// Rute REAL di situs -- /game & /tools sempat dikira belum ada saat
// pengecekan awal integrasi ini, ternyata sudah ada sebagai halaman
// statis di public/game & public/tools (bukan lewat src/pages/), jadi
// tetap aman dipakai di sini.
const quicklinks = [
  {
    label: 'Materi',
    href: '/materi',
    tone: 'accent',
    icon: '<path d="M12 6.3C10.4 4.9 8 4.4 4 4.4v13c4 0 6.4.5 8 1.9 1.6-1.4 4-1.9 8-1.9v-13c-4 0-6.4.5-8 1.9Z"/><path d="M12 6.3v13"/>',
  },
  {
    label: 'Lab Maya',
    href: '/lab-maya',
    tone: 'teal',
    icon: '<path d="M9 2v6.3L3.6 17.6A2 2 0 0 0 5.3 21h13.4a2 2 0 0 0 1.7-3.4L15 8.3V2"/><path d="M8.5 2h7"/><path d="M8 13h8"/>',
  },
  {
    label: 'Game Edukasi',
    href: '/game',
    tone: 'purple',
    icon: '<rect x="2" y="7" width="20" height="10" rx="4"/><circle cx="8" cy="12" r="1.4"/><path d="M8 10.2v3.6M6.2 12h3.6"/><circle cx="16.5" cy="10.3" r="1"/><circle cx="18.5" cy="13.3" r="1"/>',
  },
  {
    label: 'Artikel',
    href: '/artikel',
    tone: 'gold',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h8"/>',
  },
  {
    label: 'Perkakas',
    href: '/tools',
    tone: 'rose',
    icon: '<path d="M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 1 5.4-5.4l-2.6 2.6-2-2z"/>',
  },
];
---

<section class="hero" id="hero">
  <img class="hero-bg" src="/images/hero-beranda.png" alt="" loading="eager" fetchpriority="high" />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <h1 class="hero-title">
      <span>Belajar Sains,</span>
      <span class="hero-title-accent">Lebih Dekat dengan Kehidupan</span>
    </h1>
    <p class="hero-excerpt">{heroLede}</p>

    <div class="hero-quicklinks">
      {quicklinks.map((item) => (
        <a href={item.href} class="hero-quicklink" data-tone={item.tone} data-magnetic>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
          <span>{item.label}</span>
          <span class="hero-quicklink-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>

    <form class="hero-search" action="/cari" method="get">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input type="search" name="q" placeholder="Cari materi, simulasi, game, atau artikel..." aria-label="Cari" />
      <button type="submit">Cari</button>
    </form>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 34rem;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    /* Overlay TERANG (turunan --paper, otomatis ikut gelap sendiri di dark
       mode) di sisi kiri tempat teks duduk, memudar ke kanan supaya foto
       tetap kelihatan jelas. Teks pakai var(--ink), otomatis kontras di
       kedua tema. */
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--paper) 94%, transparent) 0%,
      color-mix(in srgb, var(--paper) 86%, transparent) 38%,
      color-mix(in srgb, var(--paper) 35%, transparent) 62%,
      transparent 85%
    );
  }

  .hero-inner {
    position: relative;
    max-width: 34rem;
    padding-block: 3rem;
    padding-inline-start: clamp(1.5rem, 6vw, 4rem);
    padding-inline-end: 1.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
  }

  .hero-title-accent {
    color: var(--accent);
  }

  .hero-excerpt {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 30rem;
    margin: 0 0 1.5rem;
  }

  .hero-quicklinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .hero-quicklink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .hero-quicklink:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .hero-quicklink svg {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  .hero-quicklink-arrow {
    opacity: 0.7;
    font-size: 0.8em;
  }

  .hero-quicklink[data-tone='teal'] {
    background: var(--teal-soft);
    color: var(--teal);
  }

  .hero-quicklink[data-tone='purple'] {
    background: var(--accent-2-soft);
    color: var(--accent-2);
  }

  .hero-quicklink[data-tone='gold'] {
    background: var(--gold-soft);
    color: var(--gold);
  }

  .hero-quicklink[data-tone='rose'] {
    background: var(--rose-soft);
    color: var(--rose);
  }

  .hero-search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--surface-solid);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    max-width: 28rem;
    box-shadow: var(--shadow-sm);
  }

  .hero-search svg {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--ink-faint);
    flex-shrink: 0;
  }

  .hero-search input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--ink);
  }

  .hero-search button {
    flex-shrink: 0;
    border: none;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    cursor: pointer;
  }

  @media (max-width: 36rem) {
    .hero {
      min-height: 28rem;
    }

    .hero-scrim {
      background: color-mix(in srgb, var(--paper) 88%, transparent);
    }

    .hero-inner {
      padding-block: 2rem;
    }

    .hero-search {
      max-width: none;
    }
  }

  @media (max-width: 25rem) {
    .hero-title {
      font-size: 1.75rem;
    }

    .hero-excerpt {
      font-size: 0.9375rem;
    }

    .hero-quicklink {
      padding: 0.5rem 0.75rem;
      font-size: 0.8125rem;
    }
  }

  @media (max-height: 28rem) and (orientation: landscape) {
    .hero {
      min-height: auto;
      padding-block: 2rem;
    }

    .hero-inner {
      padding-block: 1rem;
    }
  }
</style>
