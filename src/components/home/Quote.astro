---
import { getCollection } from 'astro:content';

// Daftar quote diedit lewat CMS (/admin, field "Quote Besar" di koleksi
// homepage, lihat mainQuotes di content.config.ts) -- sampai 10 quote.
// Quote pertama dirender di server jadi tampilan awal/fallback kalau JS
// mati, lalu script di bawah MENGGANTINYA dengan satu quote ACAK begitu
// halaman dimuat/direfresh di browser (beda tiap pengunjung/refresh,
// bukan cuma beda tiap deploy).
const [homepage] = await getCollection('homepage');
const quotes = homepage.data.mainQuotes;
const first = quotes[0];
---

<section class="section quote">
  <div class="container">
    <blockquote class="quote-block" data-reveal>
      <p id="quote-text">“{first.quote}”</p>
      <footer id="quote-author" style={first.author ? '' : 'display:none'}>— {first.author}</footer>
    </blockquote>
  </div>
</section>

{quotes.length > 1 && (
  <script is:inline type="application/json" id="quote-data" set:html={JSON.stringify(quotes)} />
)}

<style>
  .quote-block {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
    padding: 0;
  }

  .quote-block p {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  .quote-block footer {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
</style>

{quotes.length > 1 && (
  <script is:inline>
    (function () {
      try {
        var dataEl = document.getElementById('quote-data');
        if (!dataEl) return;
        var quotes = JSON.parse(dataEl.textContent);
        if (!quotes.length) return;
        var pick = quotes[Math.floor(Math.random() * quotes.length)];
        var textEl = document.getElementById('quote-text');
        var authorEl = document.getElementById('quote-author');
        if (textEl) textEl.textContent = '“' + pick.quote + '”';
        if (authorEl) {
          if (pick.author) {
            authorEl.textContent = '— ' + pick.author;
            authorEl.style.display = '';
          } else {
            authorEl.textContent = '';
            authorEl.style.display = 'none';
          }
        }
      } catch (e) {}
    })();
  </script>
)}
