---
import { getCollection } from 'astro:content';
// Hasil query D1 (page_views) yang ditarik SEBELUM build (lihat
// scripts/fetch-top-viewed.mjs & .github/workflows/deploy.yml) -- import ES
// biasa, bukan fs runtime (adapter Cloudflare tidak bundle node:fs). Default
// {slug: null, category: null} kalau belum pernah ada data/gagal ditarik.
import topViewed from '../../data/topViewed.json';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Satu item "andalan" -- bisa materi, artikel, ATAU simulasi Lab Maya
// (Lab Maya di koleksi `blog` nempel di materi lewat field `simulasi`,
// bukan koleksi terpisah). Prioritas:
// 1. Halaman dengan VIEW TERBANYAK (data D1 asli, bukan tebakan) -- kalau
//    sudah ada datanya & postingannya masih ada/belum draft.
// 2. Materi terbaru yang PUNYA simulasi DAN cover image (biar kartunya
//    mentereng, bukan cuma placeholder) -- dipakai sebelum ada data view
//    sama sekali (situs baru/view belum terkumpul).
// 3. Materi/artikel terbaru yang punya cover image.
// 4. Post terbaru apa adanya.
const topViewedPost = typeof topViewed.slug === 'string' ? allPosts.find((p) => p.id === topViewed.slug) : undefined;
const spotlight =
  topViewedPost ??
  allPosts.find((p) => p.data.simulasi && p.data.coverImage) ??
  allPosts.find((p) => p.data.coverImage) ??
  allPosts[0];

const isTopViewed = Boolean(topViewedPost && spotlight?.id === topViewedPost.id);
const hasLab = Boolean(spotlight?.data.simulasi);
const basePath = spotlight?.data.category === 'materi' ? '/materi' : '/artikel';
const eyebrow = isTopViewed
  ? '🔥 Paling Banyak Dibaca'
  : hasLab
    ? '🧪 Simulasi Lab Maya'
    : spotlight?.data.category === 'materi'
      ? 'Materi Pilihan'
      : 'Artikel Pilihan';
const title = hasLab ? spotlight?.data.simulasi?.judul ?? spotlight?.data.title : spotlight?.data.title;
---

{spotlight && (
  <section class="spotlight">
    <div class="container">
      <a href={`${basePath}/${spotlight.id}`} class="spotlight-card" data-reveal data-tilt>
        <div class="spotlight-visual">
          {spotlight.data.coverImage ? (
            <img src={spotlight.data.coverImage} alt="" loading="eager" />
          ) : (
            <span class="spotlight-visual-fallback" aria-hidden="true">{hasLab ? '🧪' : '📘'}</span>
          )}
        </div>
        <div class="spotlight-body">
          <span class="spotlight-eyebrow">{eyebrow}</span>
          <h2 class="spotlight-title">{title}</h2>
          <p class="spotlight-excerpt">{spotlight.data.description}</p>
          <span class="spotlight-cta">
            {hasLab ? 'Coba simulasinya' : 'Baca selengkapnya'} <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    </div>
  </section>
)}

<style>
  .spotlight {
    padding-block: 2.5rem;
  }

  .spotlight-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-solid);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.35s ease, transform 0.35s ease, border-color 0.35s ease;
  }

  .spotlight-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--border-strong);
  }

  .spotlight-visual {
    position: relative;
    min-height: 16rem;
    background: linear-gradient(135deg, var(--accent-soft), var(--teal-soft));
  }

  .spotlight-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spotlight-visual-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
  }

  .spotlight-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .spotlight-eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .spotlight-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .spotlight-excerpt {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .spotlight-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--ink);
    width: fit-content;
  }

  .spotlight-cta span {
    transition: transform 0.25s ease;
  }

  .spotlight-card:hover .spotlight-cta span {
    transform: translateX(4px);
  }

  @media (max-width: 48rem) {
    .spotlight-card {
      grid-template-columns: 1fr;
    }

    .spotlight-visual {
      min-height: 12rem;
    }
  }
</style>
