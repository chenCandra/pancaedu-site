---
// Semua angka di section ini dihitung dari data situs saat build (lihat
// src/pages/index.astro) — bukan angka dikarang, jadi otomatis benar
// terus walau kontennya bertambah.
interface Counter {
  icon?: string;
  value: string;
  suffix?: string;
  label: string;
}

interface Props {
  counters: Counter[];
}

const { counters } = Astro.props;
---

<section class="section counters">
  <div class="container">
    <p class="eyebrow" data-reveal>Angka Nyata</p>
    <div class="counters-grid">
      {counters.map((c) => (
        <div class="counter" data-reveal>
          {c.icon && <span class="counter-icon" aria-hidden="true">{c.icon}</span>}
          <p class="counter-value">
            {/* Angka ASLI ditaruh langsung di sini, bukan "0" — supaya kalau
                skrip animasinya gagal jalan, yang kelihatan tetap angka yang
                benar (bukan 0 selamanya). JS akan reset ke 0 lalu hitung naik
                sendiri HANYA kalau berhasil jalan — lihat initCounters(). */}
            <span data-counter-target={c.value}>{c.value}</span>{c.suffix}
          </p>
          <p class="counter-label">{c.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .counters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .counter {
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .counter-icon {
    display: inline-block;
    font-size: 1.375rem;
    margin-bottom: 0.5rem;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .counter:hover .counter-icon {
    transform: scale(1.2) rotate(-8deg);
  }

  .counter-value {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .counter-label {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
</style>
