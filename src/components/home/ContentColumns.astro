---
import { getCollection } from 'astro:content';
// `node:fs` TIDAK dibundel di adapter Cloudflare (prerender gagal, "No
// such module 'node:fs'") -- games.json di-import langsung sebagai modul
// ES (Vite otomatis parse JSON jadi objek saat build), bukan dibaca lewat
// filesystem. Datanya tetap SAMA PERSIS dengan yang dipakai halaman
// statis public/game/index.html (satu file, satu sumber).
import allGamesData from '../../../public/game/games.json';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const materiTerbaru = allPosts.filter((p) => p.data.category === 'materi').slice(0, 5);
const artikelTerbaru = allPosts.filter((p) => p.data.category === 'artikel').slice(0, 4);

// 4 dari sekian lab custom di /lab-maya (lihat customLabs di
// src/pages/lab-maya/index.astro) -- sengaja cuma potongan kecil di-copy
// manual di sini (bukan di-refactor jadi modul bersama), supaya nggak
// ngerisikokan halaman /lab-maya yang sudah jalan cuma demi homepage.
// Title/deskripsi/href SAMA PERSIS dengan entri aslinya di sana.
const labMayaPilihan = [
  {
    icon: '⚡',
    title: 'Hukum Coulomb',
    description: 'Geser jarak & besar muatan, lihat gaya tarik/tolaknya berubah langsung, lengkap rincian perhitungannya.',
    href: '/lab-maya/hukum-coulomb',
  },
  {
    icon: '🚀',
    title: 'Hukum Newton',
    description:
      'Atur massa, gaya dorong, dan gaya gesek, lihat percepatan berubah langsung sesuai Hukum II Newton, lengkap ilustrasi aksi-reaksi dan diagram bebas gaya.',
    href: '/lab-maya/hukum-newton',
  },
  {
    icon: '⚡',
    title: 'Energi Mekanik',
    description: 'Jatuhkan benda dari ketinggian tertentu, amati energi kinetik dan potensial saling bertukar, sementara energi totalnya tetap sama.',
    href: '/lab-maya/energi-mekanik',
  },
  {
    icon: '📏',
    title: 'Eksplorasi Alat Ukur',
    description: 'Latihan baca jangka sorong & mikrometer sekrup — ukuran benda diacak tiap ronde, kamu yang geser & menebak hasilnya.',
    href: '/lab-maya/alat-ukur',
  },
];

const allGames = allGamesData as { judul: string; deskripsi: string; ikon: string; path: string }[];
const gameEdukasiPopuler = allGames.slice(0, 4);

const kelasList = [
  { label: 'Kelas X', href: '/ruang-belajar/kelas/x' },
  { label: 'Kelas XI', href: '/ruang-belajar/kelas/xi' },
  { label: 'Kelas XII', href: '/ruang-belajar/kelas/xii' },
];
---

<div class="columns">
  <div class="container columns-grid">
    <div>
      <h2 class="col-heading">Materi Terbaru</h2>
      <div class="card-list">
        {materiTerbaru.map((post) => (
          <a href={`/materi/${post.id}`} class="content-card">
            {post.data.coverImage ? (
              <img class="content-card-thumb" src={post.data.coverImage} alt="" loading="lazy" />
            ) : (
              <span class="content-card-thumb content-card-thumb-fallback" aria-hidden="true">📘</span>
            )}
            <div class="content-card-body">
              <span class="content-card-title">{post.data.title}</span>
              <span class="content-card-excerpt">{post.data.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="col-heading">Lab Maya Pilihan</h2>
      <div class="card-list">
        {labMayaPilihan.map((lab) => (
          <a href={lab.href} class="content-card">
            <span class="content-card-thumb content-card-thumb-fallback" aria-hidden="true">{lab.icon}</span>
            <div class="content-card-body">
              <span class="content-card-title">{lab.title}</span>
              <span class="content-card-excerpt">{lab.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="col-heading">Game Edukasi Populer</h2>
      <div class="card-list">
        {gameEdukasiPopuler.map((game) => (
          <a href={game.path} class="content-card">
            <span class="content-card-thumb content-card-thumb-fallback" aria-hidden="true">{game.ikon}</span>
            <div class="content-card-body">
              <span class="content-card-title">{game.judul}</span>
              <span class="content-card-excerpt">{game.deskripsi}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="col-heading">Artikel Terbaru</h2>
      <div class="card-list">
        {artikelTerbaru.map((post) => (
          <a href={`/artikel/${post.id}`} class="content-card">
            {post.data.coverImage ? (
              <img class="content-card-thumb" src={post.data.coverImage} alt="" loading="lazy" />
            ) : (
              <span class="content-card-thumb content-card-thumb-fallback" aria-hidden="true">✍️</span>
            )}
            <div class="content-card-body">
              <span class="content-card-title">{post.data.title}</span>
              <span class="content-card-excerpt">{post.data.description}</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="col-heading">Jelajahi Berdasarkan Kelas</h2>
      <div class="kelas-list">
        {kelasList.map((item) => (
          <a href={item.href} class="kelas-item">{item.label}</a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .columns {
    padding-block: 2.5rem;
  }

  .columns-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Tablet: dari 1 kolom langsung ke 4 kolom sempit di 1024px kurang pas
     dipakai -- di rentang tablet (768-1024px) pakai 2x2 dulu, baru di
     desktop (>=1024px) jadi 4 kolom sejajar. */
  @media (min-width: 48rem) and (max-width: 63.9375rem) {
    .columns-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem;
    }
  }

  @media (min-width: 64rem) {
    .columns-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .col-heading {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--border);
  }

  .col-heading + .col-heading {
    margin-top: 2rem;
  }

  .card-list {
    display: flex;
    flex-direction: column;
  }

  .content-card {
    display: flex;
    gap: 0.9rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .content-card:first-child {
    padding-top: 0;
  }

  .content-card:last-child {
    border-bottom: none;
  }

  .content-card-thumb {
    width: 3.75rem;
    height: 3.75rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .content-card-thumb-fallback {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
  }

  .content-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .content-card-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .content-card-excerpt {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .kelas-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }

  .kelas-item {
    text-align: center;
    background: var(--surface-solid);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.85rem 0.5rem;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .kelas-item:hover {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  @media (max-width: 36rem) {
    .kelas-list {
      grid-template-columns: 1fr;
    }
  }
</style>
