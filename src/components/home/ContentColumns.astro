---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const artikelTerbaru = allPosts.filter((p) => p.data.category === 'artikel').slice(0, 5);
const materiTerbaru = allPosts.filter((p) => p.data.category === 'materi').slice(0, 5);
---

<div class="columns">
  <div class="container columns-grid">
    <div>
      <h2 class="col-heading">Artikel Terbaru</h2>
      <div class="card-list">
        {artikelTerbaru.map((post) => (
          <a href={`/artikel/${post.id}`} class="content-card">
            {post.data.coverImage ? (
              <img class="content-card-thumb" src={post.data.coverImage} alt="" loading="lazy" />
            ) : (
              <span class="content-card-thumb content-card-thumb-fallback" aria-hidden="true">✍️</span>
            )}
            <div class="content-card-body">
              <span class="content-card-title">{post.data.title}</span>
              <span class="content-card-excerpt">{post.data.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="col-heading">Materi Terbaru</h2>
      <div class="card-list">
        {materiTerbaru.map((post) => (
          <a href={`/materi/${post.id}`} class="content-card">
            {post.data.coverImage ? (
              <img class="content-card-thumb" src={post.data.coverImage} alt="" loading="lazy" />
            ) : (
              <span class="content-card-thumb content-card-thumb-fallback" aria-hidden="true">📘</span>
            )}
            <div class="content-card-body">
              <span class="content-card-title">{post.data.title}</span>
              <span class="content-card-excerpt">{post.data.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .columns {
    padding-block: 2.5rem;
  }

  .columns-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 48rem) {
    .columns-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .col-heading {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--border);
  }

  .card-list {
    display: flex;
    flex-direction: column;
  }

  .content-card {
    display: flex;
    gap: 0.9rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .content-card:first-child {
    padding-top: 0;
  }

  .content-card:last-child {
    border-bottom: none;
  }

  .content-card-thumb {
    width: 4.5rem;
    height: 4.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .content-card-thumb-fallback {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }

  .content-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .content-card-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .content-card-excerpt {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
