---
// Section preview AR di homepage -- menggantikan posisi section lama
// "Materi & Lab Maya Pilihan" (src/components/home/Works.astro, sekarang
// tidak dipakai lagi di index.astro), jadi slot permanen buat showcase
// topik-topik yang punya versi "AR kamera" (interaksi lewat kamera HP,
// bukan cuma lihat simulasi di layar datar).
//
// Tiap topik dirender sebagai KARTU (pola sama persis dengan .lab-card di
// /lab-maya: ikon besar + badge + judul + deskripsi + CTA), bukan cuma
// chip teks kecil -- biar lebih jelas kelihatan ini simulasi sungguhan,
// bukan placeholder teks doang.
//
// Keempat topik di bawah SUDAH LIVE, semua nunjuk ke game kamera di
// public/game/* (MediaPipe HandLandmarker + kanvas 2D) -- bukan halaman
// AR/WebXR terpisah (percobaan itu sudah dihentikan, WebXR/ARCore
// terbukti tidak andal). Cabang "Segera" di template di bawah tetap
// dipertahankan buat topik baru di masa depan sebelum sempat dibangun.
const previewTopics = [
  {
    label: 'Medan Magnet',
    icon: '🧲',
    href: '/game/simulasi-magnet-tangan/',
    tag: 'Kelas XII · Medan Magnet',
    desc: 'Buka telapak tangan jadi kutub Utara, kepalkan jadi Selatan -- lihat garis gaya magnetnya hidup lewat kamera.',
  },
  {
    label: 'Vektor Gaya',
    icon: '🧭',
    href: '/game/simulasi-vektor-gaya/',
    tag: 'Kelas XI · Resultan Vektor',
    desc: 'Dua tangan jadi dua vektor gaya -- Resultannya tergambar otomatis pakai metode jajaran genjang.',
  },
  {
    label: 'Gerak Parabola',
    icon: '🎯',
    href: '/game/simulasi-parabola-tangan/',
    tag: 'Kelas X · Gerak Parabola',
    desc: 'Buka telapak buat membidik, kepalkan buat menembak -- lintasan parabolanya tergambar langsung lewat kamera.',
  },
  {
    label: 'Orbit Planet',
    icon: '🪐',
    href: '/game/simulasi-orbit-tangan/',
    tag: 'Kelas X · Hukum Kepler',
    desc: 'Jarak tanganmu dari matahari virtual menentukan orbit planetnya -- lepaskan dan lihat Hukum Kepler bekerja.',
  },
];
---

<section class="section ar-teaser">
  <div class="container">
    <div class="ar-teaser-intro" data-reveal>
      <p class="eyebrow">🎥 Simulasi AR Kamera</p>
      <h2>Lab Maya lewat Kamera HP</h2>
      <p class="ar-teaser-desc">
        Simulasi fisika yang berinteraksi langsung lewat kamera HP-mu — gerakkan tanganmu, dan
        simulasinya "nongol" nempel ke dunia nyata, bukan cuma di layar datar.
      </p>
    </div>

    <div class="ar-teaser-grid">
      {previewTopics.map((t) =>
        t.href ? (
          <a href={t.href} class="ar-teaser-card card" data-reveal>
            <span class="ar-teaser-card-icon" aria-hidden="true">{t.icon}</span>
            <div class="ar-teaser-card-body">
              <span class="badge">{t.tag}</span>
              <h3>{t.label}</h3>
              <p>{t.desc}</p>
              <span class="ar-teaser-card-cta">Coba sekarang →</span>
            </div>
          </a>
        ) : (
          <div class="ar-teaser-card ar-teaser-card-soon card" data-reveal>
            <span class="ar-teaser-card-icon" aria-hidden="true">{t.icon}</span>
            <div class="ar-teaser-card-body">
              <span class="badge badge-soon">Segera</span>
              <h3>{t.label}</h3>
              <p>{t.desc}</p>
            </div>
          </div>
        )
      )}
    </div>
  </div>
</section>

<style>
  .ar-teaser-intro {
    max-width: 38rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    width: fit-content;
    background: var(--accent-soft);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full, 999px);
  }

  .ar-teaser-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  .ar-teaser-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  .ar-teaser-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.25rem;
  }

  .ar-teaser-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  a.ar-teaser-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .ar-teaser-card-icon {
    font-size: 1.85rem;
    line-height: 1;
  }

  .ar-teaser-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ar-teaser-card-body h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .ar-teaser-card-body p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
  }

  .ar-teaser-card-cta {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--accent);
    margin-top: 0.15rem;
  }

  .ar-teaser-card-soon {
    border-style: dashed;
    opacity: 0.75;
  }

  .badge-soon {
    background: transparent;
    color: var(--ink-faint);
    border: 1px solid var(--border);
  }
</style>
