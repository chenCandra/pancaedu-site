---
// `node:fs` TIDAK dibundel di adapter Cloudflare -- games.json di-import
// langsung sebagai modul ES (sama pola dengan ContentColumns.astro).
import allGamesData from '../../../public/game/games.json';

// Section preview AR di homepage -- menggantikan posisi section lama
// "Materi & Lab Maya Pilihan" (src/components/home/Works.astro, sekarang
// tidak dipakai lagi di index.astro), jadi slot permanen buat showcase
// topik-topik yang punya versi "AR kamera" (interaksi lewat kamera HP,
// bukan cuma lihat simulasi di layar datar).
//
// Tiap topik dirender sebagai KARTU (pola sama persis dengan .lab-card di
// /lab-maya: ikon besar + badge + judul + deskripsi + CTA), bukan cuma
// chip teks kecil -- biar lebih jelas kelihatan ini simulasi sungguhan,
// bukan placeholder teks doang.
//
// Daftar topik DITARIK OTOMATIS dari games.json (bukan hardcode array lagi)
// -- tiap game kamera (MediaPipe HandLandmarker) diberi field `kamera: true`
// eksplisit di games.json, jadi game kamera BARU otomatis muncul di sini
// cukup dengan nambah field itu, tidak perlu sentuh file ini lagi. Game
// non-kamera (duel-meriam, balap-mobil, dst, dikontrol keyboard/sentuh)
// SENGAJA tidak ikut (field `kamera` kosong/absen untuk mereka).
type Game = { id: string; judul: string; deskripsi: string; ikon: string; path: string; kelas: string; materi: string; kamera?: boolean };
const kameraGames = (allGamesData as Game[]).filter((g) => g.kamera === true);
---

<section class="section ar-teaser">
  <div class="container">
    <div class="ar-teaser-intro" data-reveal>
      <p class="eyebrow">🎥 Simulasi AR Kamera</p>
      <h2>Lab Maya lewat Kamera HP</h2>
      <p class="ar-teaser-desc">
        Simulasi fisika yang berinteraksi langsung lewat kamera HP-mu — gerakkan tanganmu, dan
        simulasinya "nongol" nempel ke dunia nyata, bukan cuma di layar datar.
      </p>
    </div>

    <div class="ar-teaser-grid">
      {kameraGames.map((g) => (
        <a href={g.path} class="ar-teaser-card card" data-reveal>
          <span class="ar-teaser-card-icon" aria-hidden="true">{g.ikon}</span>
          <div class="ar-teaser-card-body">
            <span class="badge">Kelas {g.kelas.replace('SMA Kelas ', '')} · {g.materi}</span>
            <h3>{g.judul.replace(/^Simulasi\s+/, '').replace(/\s*\bTangan\b\s*/, ' ').trim()}</h3>
            <p>{g.deskripsi}</p>
            <span class="ar-teaser-card-cta">Coba sekarang →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ar-teaser-intro {
    max-width: 38rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    width: fit-content;
    background: var(--accent-soft);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full, 999px);
  }

  .ar-teaser-intro h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
    margin: 0;
  }

  .ar-teaser-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  .ar-teaser-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: 0.85rem;
  }

  .ar-teaser-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  a.ar-teaser-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .ar-teaser-card-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .ar-teaser-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ar-teaser-card-body .badge {
    font-size: 0.6875rem;
    padding: 0.2rem 0.55rem;
  }

  .ar-teaser-card-body h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .ar-teaser-card-body p {
    font-size: 0.78125rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ar-teaser-card-cta {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    margin-top: 0.1rem;
  }
</style>
