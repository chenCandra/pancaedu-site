---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  // Matikan cursor kustom halus (site-cursor) di halaman yang butuh drag
  // presisi (mis. Lab Maya) — cursor itu sengaja "telat" mengikuti mouse
  // buat kesan halus di halaman biasa, tapi bikin interaksi drag terasa
  // lag/nggak responsif.
  disableCursor?: boolean;
}

const { title, description, image, article, jsonLd, noindex, disableCursor } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO title={title} description={description} image={image} article={article} noindex={noindex} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <!-- TODO: tempel script verifikasi Google AdSense di sini setelah akun disetujui -->
  </head>
  <body data-disable-cursor={disableCursor ? 'true' : undefined}>
    <div class="bg-blobs" aria-hidden="true">
      <span class="bg-blob bg-blob--1"></span>
      <span class="bg-blob bg-blob--2"></span>
      <span class="bg-blob bg-blob--3"></span>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script>
      import '../scripts/site-animations.js';
    </script>
  </body>
</html>
