---
// Perkakas "Generator Prompt AI untuk Guru" -- SATU-SATUNYA halaman di
// /tools/* yang dirender lewat Astro (bukan file statis polos di public/),
// karena daftar kategorinya sekarang ditarik dari collection CMS
// `promptKategori` (src/content/prompt-kategori/*.md, diedit lewat
// /admin) supaya guru bisa menambah kategori prompt baru sendiri tanpa
// perlu minta bantuan developer. Styling tetap pakai /tools/assets/
// style.css yang sama (dipakai bersama semua Perkakas lain) -- halaman
// ini SENGAJA tidak pakai BaseLayout, konsisten dengan /tools/* dan
// /game/* lain yang memang mandiri (bukan bagian nav/header situs utama).
import { getCollection } from 'astro:content';

const semua = await getCollection('promptKategori', ({ data }) => !data.draft);
const kategoriList = semua
  .map((entry) => entry.data)
  .sort((a, b) => {
    const ua = a.urutan ?? Number.MAX_SAFE_INTEGER;
    const ub = b.urutan ?? Number.MAX_SAFE_INTEGER;
    if (ua !== ub) return ua - ub;
    return a.label.localeCompare(b.label, 'id');
  });
---

<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Generator Prompt AI untuk Guru | Perkakas PancaEdu</title>
<meta name="description" content="Buat prompt siap pakai untuk ChatGPT, Gemini, Claude, atau AI lain -- modul ajar/RPP, konsep Lab Maya & simulasi kamera/AR, soal & asesmen, sampai administrasi guru lainnya. Isi form, salin prompt-nya.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/tools/assets/style.css">
<style>
  .panggung { max-width: 64rem; margin-inline: auto; padding: 1rem 1.25rem 3rem; padding-top: 4.5rem; }
  .judul-alat { text-align: center; margin-bottom: 1.5rem; }
  .judul-alat h1 { font-size: clamp(1.5rem, 4vw, 2rem); background: linear-gradient(90deg, var(--ungu), var(--biru)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .judul-alat p { color: var(--tinta-lembut); margin-top: 0.4rem; }

  .chip-jenis { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.5rem; justify-content: center; }
  .chip-jenis button {
    border: 2px solid var(--garis); background: #fff; color: var(--tinta);
    border-radius: 999px; padding: 0.55rem 1.1rem; font-weight: 700; font-size: 0.875rem;
    cursor: pointer; transition: all 0.15s ease; display: inline-flex; align-items: center; gap: 0.4rem;
  }
  .chip-jenis button:hover { border-color: var(--ungu); color: var(--ungu); }
  .chip-jenis button.aktif { background: var(--ungu); border-color: var(--ungu); color: #fff; }

  .tata-letak { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 52rem) { .tata-letak { grid-template-columns: 1fr 1fr; align-items: start; } }

  .panel-hasil {
    position: sticky; top: 1.5rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .kotak-prompt {
    width: 100%; min-height: 26rem; max-height: 34rem;
    background: #0f172a; color: #e2e8f0;
    border: 1px solid var(--garis); border-radius: var(--radius, 12px);
    padding: 1.1rem; font-family: 'Courier New', monospace; font-size: 0.8125rem; line-height: 1.6;
    white-space: pre-wrap; resize: vertical; box-sizing: border-box;
  }
  .baris-tombol-hasil { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
  .pesan-salin { font-size: 0.8125rem; color: var(--hijau); font-weight: 700; opacity: 0; transition: opacity 0.2s ease; }
  .pesan-salin.tampil { opacity: 1; }

  .tips-pakai {
    background: var(--kuning-lembut); border: 1px solid var(--kuning);
    border-radius: var(--radius, 12px); padding: 0.9rem 1.1rem; font-size: 0.8125rem; color: var(--tinta);
  }

  .cek-opsi { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 600; }
  .cek-opsi input { width: 1.1rem; height: 1.1rem; }

  .pesan-kosong { text-align: center; color: var(--tinta-lembut); padding: 2rem 1rem; }
</style>
</head>
<body>
  <div class="bentuk-dekor no-print" aria-hidden="true">
    <span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span><span class="b5"></span>
  </div>

  <a href="/tools/" class="tombol-kembali-mengambang no-print">← Kembali ke Perkakas</a>

  <div class="panggung">
    <header class="judul-alat">
      <h1>🤖 Generator Prompt AI untuk Guru</h1>
      <p>Isi form di bawah, prompt siap pakai langsung tersusun -- tinggal salin &amp; tempel ke ChatGPT, Gemini, Claude, atau AI favoritmu.</p>
    </header>

    {kategoriList.length === 0 ? (
      <p class="pesan-kosong">Belum ada kategori prompt. Tambahkan lewat <a href="/admin/">/admin</a> &rarr; "Generator Prompt AI — Kategori".</p>
    ) : (
      <>
        <div class="chip-jenis" id="chip-jenis"></div>

        <div class="tata-letak">
          <div class="kartu-panel" id="panel-form"></div>

          <div class="panel-hasil">
            <textarea class="kotak-prompt" id="kotak-prompt" readonly></textarea>
            <div class="baris-tombol-hasil">
              <button class="tombol" id="btn-salin">📋 Salin Prompt</button>
              <span class="pesan-salin" id="pesan-salin">Tersalin ke clipboard!</span>
            </div>
            <div class="tips-pakai">
              💡 <strong>Cara pakai:</strong> salin prompt di atas, tempel ke ChatGPT/Gemini/Claude/AI lain, lalu jalankan. Hasilnya masih draf -- sesuaikan lagi dengan kondisi kelasmu sebelum dipakai.
            </div>
          </div>
        </div>
      </>
    )}
  </div>

  <script type="application/json" id="data-kategori" set:html={JSON.stringify(kategoriList).replace(/</g, '\\u003c')} />

  <script>
    var KATEGORI = JSON.parse(document.getElementById('data-kategori').textContent || '[]');
    if (KATEGORI.length > 0) {
      var elChipJenis = document.getElementById('chip-jenis');
      var elPanelForm = document.getElementById('panel-form');
      var elKotakPrompt = document.getElementById('kotak-prompt');
      var elBtnSalin = document.getElementById('btn-salin');
      var elPesanSalin = document.getElementById('pesan-salin');

      var jenisAktif = KATEGORI[0].label;
      var salinTimeout = null;

      function cariKategori(label) {
        for (var i = 0; i < KATEGORI.length; i++) if (KATEGORI[i].label === label) return KATEGORI[i];
        return KATEGORI[0];
      }

      function buatChip() {
        elChipJenis.innerHTML = '';
        KATEGORI.forEach(function (k) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = k.ikon + ' ' + k.label;
          btn.className = k.label === jenisAktif ? 'aktif' : '';
          btn.addEventListener('click', function () {
            jenisAktif = k.label;
            buatChip();
            renderForm();
          });
          elChipJenis.appendChild(btn);
        });
      }

      function nilaiSemuaBidang(kategori) {
        var v = {};
        kategori.bidang.forEach(function (b) {
          var el = document.getElementById('bidang-' + b.id);
          if (!el) return;
          v[b.id] = b.tipe === 'checkbox' ? el.checked : el.value;
        });
        return v;
      }

      // Substitusi token {{id}} di template -- text/textarea kosong diganti
      // "[isi <label>]" otomatis, checkbox diganti teksJikaDicentang kalau
      // dicentang (atau string kosong kalau tidak), select & isian lain
      // dipakai apa adanya.
      function susunPrompt(kategori, v) {
        var hasil = kategori.template;
        kategori.bidang.forEach(function (b) {
          var nilai = v[b.id];
          var pengganti;
          if (b.tipe === 'checkbox') {
            pengganti = nilai ? b.teksJikaDicentang : '';
          } else if ((b.tipe === 'text' || b.tipe === 'textarea') && !nilai) {
            pengganti = '[isi ' + b.label.toLowerCase() + ']';
          } else {
            pengganti = nilai || '';
          }
          hasil = hasil.split('{{' + b.id + '}}').join(pengganti);
        });
        return hasil;
      }

      function renderPrompt() {
        var kategori = cariKategori(jenisAktif);
        var v = nilaiSemuaBidang(kategori);
        elKotakPrompt.value = susunPrompt(kategori, v);
      }

      function renderForm() {
        var kategori = cariKategori(jenisAktif);
        elPanelForm.innerHTML = '';
        kategori.bidang.forEach(function (b) {
          var wrap = document.createElement('div');
          wrap.className = 'bidang';
          var elId = 'bidang-' + b.id;

          if (b.tipe === 'checkbox') {
            wrap.innerHTML = '<label class="cek-opsi" for="' + elId + '"><input type="checkbox" id="' + elId + '"> ' + b.label + '</label>';
          } else if (b.tipe === 'select') {
            var opsiHtml = b.opsi.map(function (o) { return '<option value="' + o + '">' + o + '</option>'; }).join('');
            wrap.innerHTML = '<label for="' + elId + '">' + b.label + '</label><select id="' + elId + '">' + opsiHtml + '</select>';
          } else if (b.tipe === 'textarea') {
            wrap.innerHTML = '<label for="' + elId + '">' + b.label + '</label><textarea id="' + elId + '" placeholder="' + (b.placeholder || '') + '" rows="3"></textarea>';
          } else {
            wrap.innerHTML = '<label for="' + elId + '">' + b.label + '</label><input type="text" id="' + elId + '" placeholder="' + (b.placeholder || '') + '">';
          }
          elPanelForm.appendChild(wrap);
        });

        document.querySelectorAll('#panel-form input, #panel-form select, #panel-form textarea').forEach(function (el) {
          var evt = el.tagName === 'SELECT' || el.type === 'checkbox' ? 'change' : 'input';
          el.addEventListener(evt, renderPrompt);
        });

        renderPrompt();
      }

      elBtnSalin.addEventListener('click', function () {
        elKotakPrompt.select();
        elKotakPrompt.setSelectionRange(0, elKotakPrompt.value.length);
        var berhasil = false;
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(elKotakPrompt.value);
            berhasil = true;
          } else {
            berhasil = document.execCommand('copy');
          }
        } catch (e) { berhasil = false; }

        if (berhasil) {
          elPesanSalin.classList.add('tampil');
          clearTimeout(salinTimeout);
          salinTimeout = setTimeout(function () { elPesanSalin.classList.remove('tampil'); }, 2200);
        }
      });

      buatChip();
      renderForm();
    }
  </script>
  <script>
    (function () {
      try {
        var payload = JSON.stringify({ slug: "generator-prompt-ai", category: "tools" });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/track-view', new Blob([payload], { type: 'application/json' }));
        } else {
          fetch('/api/track-view', { method: 'POST', body: payload, keepalive: true }).catch(function () {});
        }
      } catch (e) {}
    })();
  </script>
</body>
</html>
