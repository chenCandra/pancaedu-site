---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const angkatan = await getCollection('kelas');
  return angkatan.map((kelas) => ({
    params: { slug: kelas.id },
    props: { kelas },
  }));
}

const { kelas } = Astro.props;
const { tahunAjaran, namaKelas, siswa, fotoBersama } = kelas.data;
const { Content } = await render(kelas);
---

<BaseLayout
  title={`${namaKelas} — ${tahunAjaran}`}
  description={`Album kenangan kelas ${namaKelas}, tahun ajaran ${tahunAjaran}.`}
>
  <section class="container page-header">
    <a href="/kenangan" class="back-link">&larr; Semua Jejak Kelas</a>
    <p class="eyebrow">{tahunAjaran}</p>
    <h1>{namaKelas}</h1>
    <div class="prose intro">
      <Content />
    </div>
  </section>

  {fotoBersama.length > 0 && (
    <section class="container bersama-section">
      <h2 class="bersama-heading">Momen Bersama</h2>
      <div class="bersama-grid">
        {fotoBersama.map((momen, i) => (
          <figure class={`bersama-card ${i % 2 === 0 ? 'tilt-left' : 'tilt-right'}`}>
            <div class="bersama-frame">
              <img src={momen.foto} alt={momen.keterangan ?? ''} loading="lazy" />
            </div>
            {momen.keterangan && <figcaption class="bersama-caption">{momen.keterangan}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}

  {fotoBersama.length > 0 && siswa.length > 0 && (
    <div class="container">
      <div class="section-divider" aria-hidden="true">
        <span class="divider-line"></span>
        <span class="divider-ornament">✦</span>
        <span class="divider-line"></span>
      </div>
    </div>
  )}

  <section class="container yearbook-grid">
    {siswa.map((anak) => {
      const panggilanDesa = [anak.namaPanggilan, anak.desa].filter(Boolean).join(' — ');
      const igUsername = anak.instagram?.replace(/^@/, '');
      return (
        <figure class="yearbook-card">
          <div class="photo-frame">
            {anak.foto ? (
              <img src={anak.foto} alt="" loading="lazy" />
            ) : (
              <div class="photo-placeholder" aria-hidden="true">{anak.namaLengkap.charAt(0)}</div>
            )}
          </div>
          <figcaption>
            <p class="nama">{anak.namaLengkap}</p>
            {panggilanDesa && <p class="panggilan-desa">{panggilanDesa}</p>}
            {igUsername && (
              <a class="instagram" href={`https://instagram.com/${igUsername}`} target="_blank" rel="noopener noreferrer">
                @{igUsername}
              </a>
            )}
            {anak.quote && <p class="quote">&ldquo;{anak.quote}&rdquo;</p>}
          </figcaption>
        </figure>
      );
    })}
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 40rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .intro {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .bersama-section {
    padding-block: 0.5rem 3rem;
  }

  .bersama-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
  }

  .bersama-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2.5rem 2rem;
  }

  /* Gaya "scrapbook" -- tiap foto dimiringkan dikit gantian arah, kayak
     ditempel di album kenangan, beda sengaja dari grid rapi kartu siswa
     di bawahnya. Rotasi di-nolkan lagi pas hover biar foto gampang
     dilihat jelas. */
  .bersama-card {
    margin: 0;
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border: 1px solid var(--glass-border);
    border-radius: 1rem;
    padding: 0.75rem;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease;
  }

  .bersama-card.tilt-left {
    transform: rotate(-1.5deg);
  }

  .bersama-card.tilt-right {
    transform: rotate(1.5deg);
  }

  .bersama-card:hover {
    transform: rotate(0deg) translateY(-3px) scale(1.015);
  }

  .bersama-frame {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: var(--accent-soft);
  }

  .bersama-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bersama-caption {
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--ink-soft);
    padding-top: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .bersama-card,
    .bersama-card.tilt-left,
    .bersama-card.tilt-right {
      transform: none;
      transition: none;
    }
  }

  .section-divider {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 22rem;
    margin: 0 auto;
    padding-block: 0.5rem 2rem;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
  }

  .divider-ornament {
    flex-shrink: 0;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--accent);
    text-shadow: 0 0 12px var(--accent-soft);
  }

  .yearbook-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 1.75rem;
    padding-block: 1rem 4rem;
  }

  .yearbook-card {
    margin: 0;
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border: 1px solid var(--glass-border);
    border-radius: 1rem;
    padding: 0.75rem;
    box-shadow: var(--shadow);
    transition: transform 0.15s ease;
  }

  .yearbook-card:hover {
    transform: rotate(-1deg) translateY(-2px);
  }

  .photo-frame {
    position: relative;
    aspect-ratio: 1;
    border-radius: 0.5rem;
    overflow: hidden;
    background-color: var(--accent-soft);
  }

  /* position:absolute + inset:0 (bukan width/height:100% biasa) supaya foto
     selalu ngisi penuh bingkai kotak tanpa celah tipis di salah satu sisi --
     lebih pasti daripada andalkan resolusi height:100% dari aspect-ratio
     parent, yang di sebagian browser bisa nyisain celah sub-piksel. Foto
     mayoritas potret (3:4, lebih tinggi dari lebar) dipotong object-fit:cover
     buat masuk bingkai kotak -- object-position digeser sedikit ke atas
     (bukan tengah persis) supaya wajah/kepala nggak gampang kepotong. */
  .photo-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  .photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--accent);
  }

  .yearbook-card figcaption {
    text-align: center;
    padding-top: 0.75rem;
  }

  .nama {
    font-family: var(--font-display);
    font-weight: 600;
    margin: 0;
  }

  .panggilan-desa {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin: 0.15rem 0 0;
  }

  .instagram {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--accent);
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .instagram:hover {
    text-decoration: underline;
  }

  .quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin: 0.25rem 0 0;
  }
</style>
