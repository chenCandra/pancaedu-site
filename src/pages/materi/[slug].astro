---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { extractYoutubeId } from '../../lib/youtube';
import { kelasLabel, type Kelas } from '../../lib/ruangBelajar';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.category === 'materi' && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, mapel, kelas, pubDate, updatedDate, tags, coverImage, youtubeId: youtubeIdRaw, simulasi, kuis } =
  post.data;
// Toleran kalau yang ditempel di CMS link lengkap, bukan ID doang.
const youtubeId = youtubeIdRaw ? extractYoutubeId(youtubeIdRaw) : undefined;
const { Content, headings } = await render(post);

// Rekomendasi "Baca Juga" — prioritaskan mapel+kelas yang sama (paling
// relevan), lalu mapel saja, sisanya diisi materi terbaru lain biar slotnya
// nggak pernah kosong.
const related = (
  await getCollection(
    'blog',
    ({ data, id }) => data.category === 'materi' && !data.draft && id !== post.id
  )
)
  .sort((a, b) => {
    const score = (p: typeof a) =>
      (p.data.mapel === mapel ? 2 : 0) + (p.data.kelas === kelas ? 1 : 0);
    const diff = score(b) - score(a);
    return diff !== 0 ? diff : b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);

const formattedDate = pubDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Setiap materi yang jadi bagian sesi Ruang Belajar TERTAUT ke SATU sesi
// saja (1 materiSlug = 1 sesi, dicek pas nambah simulasi kemarin) --
// dipakai buat tombol pemandu "Kembali ke Ruang Belajar" di atas & bawah
// halaman, supaya siswa nggak perlu mengandalkan tombol Back browser cuma
// buat balik ke menu langkah-langkah pembelajaran.
const rbEntry = (await getCollection('ruangBelajar', ({ data }) => !data.draft)).find(
  (s) => s.data.materiSlug === post.id
);
const hasKuis = Boolean(kuis && kuis.length > 0);

// Materi laman ini SENGAJA cuma teks/konsep -- Video & Eksperimen/Lab Maya
// masing-masing punya laman fokus sendiri (lihat video.astro &
// eksperimen.astro di folder ini), dirujuk lewat tombol "Lanjut" di bawah
// biar alurnya runtut satu-per-satu tanpa perlu Back browser. Langkah yang
// belum ada datanya (mis. belum ada video) otomatis dilompati ke langkah
// berikutnya yang tersedia.
const langkahBerikutnya = youtubeId
  ? { href: `/materi/${post.id}/video`, label: '▶ Lanjut ke Video' }
  : simulasi
    ? { href: `/materi/${post.id}/eksperimen`, label: '🧪 Lanjut ke Eksperimen' }
    : hasKuis
      ? { href: `/materi/${post.id}/uji-pemahaman`, label: '🧠 Mulai Uji Pemahaman' }
      : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  headline: title,
  description,
  about: mapel,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Candra Pabakti',
    url: new URL('/candra-pabakti', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    name: 'PancaEdu',
    url: Astro.site?.toString(),
  },
};
---

<BaseLayout title={title} description={description} image={coverImage} article jsonLd={jsonLd}>
  <ReadingProgress />
  <article class="container post">
    {rbEntry ? (
      <a href={`/ruang-belajar/${rbEntry.id}`} class="back-link">&larr; Kembali ke Ruang Belajar: {rbEntry.data.judul}</a>
    ) : (
      <a href="/materi" class="back-link">&larr; Semua Materi</a>
    )}
    <p class="eyebrow">
      Materi Pelajaran{kelas ? ` — ${kelasLabel(kelas as Kelas)}` : ''}{mapel ? ` — ${mapel}` : ''}
    </p>
    <h1>{title}</h1>
    <div class="post-meta-row">
      <p class="post-date">Dipublikasikan {formattedDate}</p>
      <BookmarkButton postId={post.id} />
    </div>
    <AuthorByline />

    <TableOfContents headings={headings} />

    {coverImage && <img src={coverImage} alt="" class="post-cover" />}

    <div class="prose">
      <Content />
    </div>

    <AdSlot label="Iklan" />

    {tags.length > 0 && (
      <ul class="tag-list">
        {tags.map((tag: string) => <li class="badge badge-gold">{tag}</li>)}
      </ul>
    )}

    <div class="next-step">
      {langkahBerikutnya ? (
        <a href={langkahBerikutnya.href} class="btn btn-primary next-step-btn">
          {langkahBerikutnya.label} &rarr;
        </a>
      ) : rbEntry ? (
        <a href={`/ruang-belajar/${rbEntry.id}`} class="btn btn-primary next-step-btn">
          &larr; Kembali ke Ruang Belajar
        </a>
      ) : null}
      {langkahBerikutnya && rbEntry && (
        <a href={`/ruang-belajar/${rbEntry.id}`} class="next-step-secondary">
          Lewati, kembali ke Ruang Belajar &rarr;
        </a>
      )}
    </div>
  </article>

  <RelatedPosts posts={related} />
</BaseLayout>

<style>
  .post {
    padding-block: 3rem 4rem;
    max-width: var(--measure);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .next-step {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .next-step-btn {
    font-size: 1rem;
    padding: 0.85rem 1.75rem;
  }

  .next-step-secondary {
    font-size: 0.8125rem;
    color: var(--ink-faint);
    text-decoration: none;
  }

  .next-step-secondary:hover {
    color: var(--ink-soft);
    text-decoration: underline;
  }

  .post-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .post-date {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .post-cover {
    border-radius: 1rem;
    margin-block: 1.5rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }
</style>
