---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import BookmarkButton from '../../components/BookmarkButton.astro';
import Kuis from '../../components/Kuis.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.category === 'materi' && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, mapel, kelas, pubDate, updatedDate, tags, coverImage, youtubeId, simulasi, kuis } =
  post.data;
const { Content, headings } = await render(post);

// Rekomendasi "Baca Juga" — prioritaskan mapel+kelas yang sama (paling
// relevan), lalu mapel saja, sisanya diisi materi terbaru lain biar slotnya
// nggak pernah kosong.
const related = (
  await getCollection(
    'blog',
    ({ data, id }) => data.category === 'materi' && !data.draft && id !== post.id
  )
)
  .sort((a, b) => {
    const score = (p: typeof a) =>
      (p.data.mapel === mapel ? 2 : 0) + (p.data.kelas === kelas ? 1 : 0);
    const diff = score(b) - score(a);
    return diff !== 0 ? diff : b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);

const formattedDate = pubDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  headline: title,
  description,
  about: mapel,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: 'PancaEdu' },
};
---

<BaseLayout title={title} description={description} image={coverImage} article jsonLd={jsonLd}>
  <ReadingProgress />
  <article class="container post">
    <p class="eyebrow">
      Materi Pelajaran{kelas ? ` — Kelas ${kelas}` : ''}{mapel ? ` — ${mapel}` : ''}
    </p>
    <h1>{title}</h1>
    <div class="post-meta-row">
      <p class="post-date">Dipublikasikan {formattedDate}</p>
      <BookmarkButton postId={post.id} />
    </div>

    <TableOfContents headings={headings} />

    {coverImage && <img src={coverImage} alt="" class="post-cover" />}

    {youtubeId && (
      <div class="video-embed">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {simulasi && (
      <section class="lab-maya">
        <h2>🧪 Lab Maya: {simulasi.judul}</h2>
        <div class="sim-embed" style={`--sim-height: ${simulasi.tinggi}px`}>
          <iframe
            src={simulasi.url}
            title={simulasi.judul}
            loading="lazy"
            allow="fullscreen"
            allowfullscreen
          ></iframe>
        </div>
        <p class="sim-footer">
          {simulasi.sumber && <span class="sim-credit">Sumber: {simulasi.sumber}</span>}
          <a href={simulasi.url} target="_blank" rel="noopener noreferrer">
            Buka di tab baru &rarr;
          </a>
        </p>
      </section>
    )}

    <Kuis soal={kuis} />

    <AdSlot label="Iklan" />

    {tags.length > 0 && (
      <ul class="tag-list">
        {tags.map((tag: string) => <li class="badge badge-gold">{tag}</li>)}
      </ul>
    )}
  </article>

  <RelatedPosts posts={related} />
</BaseLayout>

<style>
  .post {
    padding-block: 3rem 4rem;
    max-width: var(--measure);
  }

  .post-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .post-date {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .post-cover {
    border-radius: 1rem;
    margin-block: 1.5rem;
  }

  .video-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-block: 1.5rem;
    border-radius: 1rem;
    overflow: hidden;
  }

  .video-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lab-maya {
    margin-block: 2.5rem;
  }

  .lab-maya h2 {
    font-size: 1.375rem;
  }

  .sim-embed {
    border: 1px solid var(--border);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow);
    height: var(--sim-height, 600px);
  }

  .sim-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .sim-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0.6rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }
</style>
