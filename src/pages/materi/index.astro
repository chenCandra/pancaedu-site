---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';

const posts = (
  await getCollection('blog', ({ data }) => data.category === 'materi' && !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Materi terbaru jadi kartu unggulan di atas, sisanya grid biasa — pola sama
// dengan /artikel, lihat PostCard.astro untuk detail cover & layout kartunya.
const [featuredPost, ...restPosts] = posts;

// Total materi masih sedikit dibanding artikel, jadi halaman awal ditampilin
// lebih kecil (6) supaya tombol "Muat lebih banyak" tetap kerasa gunanya.
const PAGE_SIZE = 6;

const kelasList = ['X', 'XI', 'XII', 'TKA'].filter((k) => posts.some((p) => p.data.kelas === k));
const mapelList = [...new Set(posts.map((p) => p.data.mapel).filter(Boolean))] as string[];
---

<BaseLayout title="Materi Pelajaran" description="Bahan ajar per mata pelajaran, disusun untuk dipakai gratis oleh guru maupun murid.">
  <section class="container page-header">
    <p class="eyebrow">Materi Pelajaran</p>
    <h1>Bahan Ajar</h1>
    <p class="page-lede">Disusun dari pengalaman mengajar sehari-hari, gratis dipakai siapa saja.</p>
  </section>

  {(kelasList.length > 0 || mapelList.length > 0) && (
    <div class="container filters" data-filters>
      {kelasList.length > 0 && (
        <div class="filter-group">
          <span class="filter-label">Kelas</span>
          <div class="filter-row" role="group" aria-label="Filter kelas">
            <button type="button" class="filter-btn badge" data-filter-kelas="" aria-pressed="true">Semua</button>
            {kelasList.map((k) => (
              <button type="button" class="filter-btn badge" data-filter-kelas={k} aria-pressed="false">{k}</button>
            ))}
          </div>
        </div>
      )}

      {mapelList.length > 0 && (
        <div class="filter-group">
          <span class="filter-label">Mapel</span>
          <div class="filter-row" role="group" aria-label="Filter mata pelajaran">
            <button type="button" class="filter-btn badge badge-gold" data-filter-mapel="" aria-pressed="true">Semua</button>
            {mapelList.map((mapel) => (
              <button type="button" class="filter-btn badge badge-gold" data-filter-mapel={mapel} aria-pressed="false">{mapel}</button>
            ))}
          </div>
        </div>
      )}
    </div>
  )}

  {featuredPost && (
    <section class="container featured-wrap" data-featured-wrap>
      <PostCard post={featuredPost} featured />
    </section>
  )}

  <section class="container post-grid" data-post-grid>
    {posts.length > 0 ? (
      <>
        {restPosts.slice(0, PAGE_SIZE).map((post) => <PostCard post={post} />)}
        {restPosts.length > PAGE_SIZE && (
          <div class="ad-divider" data-ad-divider>
            <AdSlot label="Iklan" />
          </div>
        )}
        {restPosts.slice(PAGE_SIZE).map((post) => <PostCard post={post} hidden />)}
      </>
    ) : (
      <p>Belum ada materi yang diterbitkan.</p>
    )}
  </section>

  <p class="container empty-state" data-empty-state hidden>
    Tidak ada materi yang cocok dengan filter ini.
  </p>

  {restPosts.length > PAGE_SIZE && (
    <div class="container load-more-wrap" data-load-more-sentinel data-page-size={PAGE_SIZE}>
      <p class="loading-indicator" data-loading-indicator>Memuat materi lainnya&hellip;</p>
    </div>
  )}
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const grid = document.querySelector<HTMLElement>('[data-post-grid]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  const featuredWrap = document.querySelector<HTMLElement>('[data-featured-wrap]');
  const sentinel = document.querySelector<HTMLElement>('[data-load-more-sentinel]');
  const adDivider = document.querySelector<HTMLElement>('[data-ad-divider]');

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('a.post-card'));
    const pageSize = Number(sentinel?.dataset.pageSize) || cards.length;
    let activeKelas = '';
    let activeMapel = '';
    // Berapa kartu yang boleh tampil di tampilan "Semua" (tanpa filter) —
    // nambah otomatis tiap kali sentinel di bawah grid masuk viewport
    // (infinite scroll), lihat IntersectionObserver di bawah.
    let revealedCount = pageSize;

    const applyFilter = () => {
      const filterActive = activeKelas !== '' || activeMapel !== '';
      let visibleCount = 0;
      let matchedSoFar = 0;
      for (const card of cards) {
        const matchesKelas = !activeKelas || card.dataset.kelas === activeKelas;
        const matchesMapel = !activeMapel || card.dataset.mapel === activeMapel;
        const matches = matchesKelas && matchesMapel;
        let visible = matches;
        if (matches && !filterActive) {
          // Tanpa filter aktif: batasi ke revealedCount pertama, sisanya
          // nunggu scroll ke bawah (infinite scroll). Begitu ada filter
          // dipakai, semua kartu yang cocok langsung ditampilkan.
          matchedSoFar++;
          visible = matchedSoFar <= revealedCount;
        }
        card.hidden = !visible;
        if (visible) visibleCount++;
      }
      if (emptyState) emptyState.hidden = visibleCount > 0;
      // Kartu unggulan & sentinel infinite-scroll cuma masuk akal di
      // tampilan "Semua" — begitu ada filter aktif, sembunyikan keduanya.
      if (featuredWrap) featuredWrap.hidden = filterActive;
      if (sentinel) sentinel.hidden = filterActive || revealedCount >= cards.length;
      // Pembatas iklan cuma masuk akal di batas "halaman pertama" tampilan
      // "Semua" — sembunyikan begitu filter Kelas/Mapel aktif.
      if (adDivider) adDivider.hidden = filterActive;
    };

    if (filters) {
      filters.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
        if (!btn) return;

        if (btn.dataset.filterKelas !== undefined) {
          activeKelas = btn.dataset.filterKelas;
          for (const b of filters.querySelectorAll<HTMLButtonElement>('[data-filter-kelas]')) {
            b.setAttribute('aria-pressed', String(b === btn));
          }
        } else if (btn.dataset.filterMapel !== undefined) {
          activeMapel = btn.dataset.filterMapel;
          for (const b of filters.querySelectorAll<HTMLButtonElement>('[data-filter-mapel]')) {
            b.setAttribute('aria-pressed', String(b === btn));
          }
        } else {
          return;
        }
        applyFilter();
      });
    }

    // Infinite scroll: begitu sentinel di bawah grid masuk viewport (sambil
    // nggak ada filter aktif & masih ada kartu yang belum ditampilkan),
    // tambah revealedCount otomatis -- gantiin tombol "Muat lebih banyak".
    // rootMargin dikasih jarak ke depan biar kartu baru sudah kebuka SEBELUM
    // sentinel-nya benar-benar kelihatan, jadi scroll-nya kerasa mulus.
    if (sentinel) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              revealedCount += pageSize;
              applyFilter();
            }
          }
        },
        { rootMargin: '600px 0px' }
      );
      observer.observe(sentinel);
    }

    applyFilter();
  }
</script>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 40rem;
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block: 0.5rem 1.5rem;
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .filter-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    border: 1px solid transparent;
    cursor: pointer;
    font-family: var(--font-body);
  }

  .filter-btn[aria-pressed='true'] {
    border-color: currentColor;
  }

  .featured-wrap {
    padding-block: 0.5rem 0.5rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.5rem;
    padding-block: 1rem 2rem;
  }

  /* Pembatas iklan melebar penuh, motongin ritme grid kartu yang seragam */
  .ad-divider {
    grid-column: 1 / -1;
  }

  .ad-divider[hidden] {
    display: none;
  }

  .empty-state {
    color: var(--ink-soft);
    padding-block: 1rem 4rem;
  }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    padding-block: 0 4rem;
  }

  .loading-indicator {
    color: var(--ink-faint);
    font-size: 0.875rem;
  }
</style>
