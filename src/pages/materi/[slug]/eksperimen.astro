---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { kelasLabel, type Kelas } from '../../../lib/ruangBelajar';

// Sama seperti video.astro & uji-pemahaman.astro -- Lab Maya dipisah ke
// laman sendiri supaya materi tetap fokus teks/konsep, dan siswa dipandu
// tombol "Lanjut" runtut ke bagian berikutnya.
export async function getStaticPaths() {
  const posts = await getCollection(
    'blog',
    ({ data }) => data.category === 'materi' && !data.draft && Boolean(data.simulasi)
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, mapel, kelas, simulasi, simulasiTambahan, kuis } = post.data;
const hasKuis = Boolean(kuis && kuis.length > 0);

const rbEntry = (await getCollection('ruangBelajar', ({ data }) => !data.draft)).find(
  (s) => s.data.materiSlug === post.id
);

const langkahBerikutnya = hasKuis
  ? { href: `/materi/${post.id}/uji-pemahaman`, label: '🧠 Mulai Uji Pemahaman' }
  : undefined;
---

<BaseLayout title={`Eksperimen: ${title}`} description={`Simulasi Lab Maya untuk ${title}.`}>
  <article class="container eksperimen-page">
    <a href={`/materi/${post.id}`} class="back-link">&larr; Kembali ke Materi: {title}</a>
    <p class="eyebrow">
      Eksperimen / Lab Maya{kelas ? ` — ${kelasLabel(kelas as Kelas)}` : ''}{mapel ? ` — ${mapel}` : ''}
    </p>
    <h1>🧪 {title}</h1>

    {simulasi && (
      <section class="lab-maya">
        <h2>{simulasi.judul}</h2>
        <div class="sim-embed" style={`--sim-height: ${simulasi.tinggi}px`}>
          <iframe src={simulasi.url} title={simulasi.judul} loading="lazy" allow="fullscreen" allowfullscreen></iframe>
        </div>
        <p class="sim-footer">
          {simulasi.sumber && <span class="sim-credit">Sumber: {simulasi.sumber}</span>}
          <a href={simulasi.url} target="_blank" rel="noopener noreferrer">
            Buka di tab baru &rarr;
          </a>
        </p>
      </section>
    )}

    {simulasiTambahan.map((sim) => (
      <section class="lab-maya">
        <h2>Simulasi Tambahan: {sim.judul}</h2>
        <div class="sim-embed" style={`--sim-height: ${sim.tinggi}px`}>
          <iframe src={sim.url} title={sim.judul} loading="lazy" allow="fullscreen" allowfullscreen></iframe>
        </div>
        <p class="sim-footer">
          <span class="sim-credit">Sumber: {sim.sumber}</span>
          <a href={sim.url} target="_blank" rel="noopener noreferrer">
            Buka di tab baru &rarr;
          </a>
        </p>
      </section>
    ))}

    <div class="next-step">
      {langkahBerikutnya ? (
        <a href={langkahBerikutnya.href} class="btn btn-primary next-step-btn">
          {langkahBerikutnya.label} &rarr;
        </a>
      ) : rbEntry ? (
        <a href={`/ruang-belajar/${rbEntry.id}`} class="btn btn-primary next-step-btn">
          &larr; Kembali ke Ruang Belajar
        </a>
      ) : (
        <a href="/materi" class="btn btn-primary next-step-btn">&larr; Semua Materi</a>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .eksperimen-page {
    padding-block: 3rem 4rem;
    max-width: var(--measure);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .lab-maya {
    margin-block: 2rem;
  }

  .lab-maya h2 {
    font-size: 1.375rem;
  }

  .sim-embed {
    border: 1px solid var(--border);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow);
    height: var(--sim-height, 600px);
  }

  .sim-embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .sim-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0.6rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .next-step {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: center;
  }

  .next-step-btn {
    font-size: 1rem;
    padding: 0.85rem 1.75rem;
  }
</style>
