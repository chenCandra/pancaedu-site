---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PembelajaranDaringBanner from '../components/PembelajaranDaringBanner.astro';
import Hero from '../components/home/Hero.astro';
import QuoteTicker from '../components/home/QuoteTicker.astro';
import ContentColumns from '../components/home/ContentColumns.astro';
import Works from '../components/home/Works.astro';
import Timeline from '../components/home/Timeline.astro';
import Quote from '../components/home/Quote.astro';
import Contact from '../components/home/Contact.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const materiPosts = allPosts.filter((p) => p.data.category === 'materi');

const modeDaring = await getEntry('modeDaring', 'index');
const daringAktif = modeDaring?.data.aktif ?? false;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      name: 'PancaEdu',
      url: Astro.site?.toString(),
      publisher: { '@id': `${Astro.site}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${Astro.site}#organization`,
      name: 'PancaEdu',
      url: Astro.site?.toString(),
      founder: {
        '@type': 'Person',
        name: 'Candra Pabakti',
        url: new URL('/candra-pabakti', Astro.site).toString(),
      },
    },
  ],
};

const workItems = materiPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    href: `/materi/${p.id}`,
    tag: p.data.mapel ?? 'Materi',
    hasLab: Boolean(p.data.simulasi),
  }));
---

<BaseLayout
  title="PancaEdu — Ruang Belajar Digital oleh Candra Pabakti"
  titleIsFull
  description="PancaEdu adalah ruang belajar digital yang dikembangkan oleh Candra Pabakti, berisi materi pembelajaran, artikel pendidikan, dan laboratorium maya interaktif."
  jsonLd={jsonLd}
>
  <Hero />
  {daringAktif && <PembelajaranDaringBanner />}
  <QuoteTicker />
  <ContentColumns />

  {workItems.length > 0 && <Works items={workItems} />}
  <Timeline />
  <Quote />
  <Contact />
</BaseLayout>
