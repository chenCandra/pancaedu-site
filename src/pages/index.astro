---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import PembelajaranDaringBanner from '../components/PembelajaranDaringBanner.astro';
import Hero from '../components/home/Hero.astro';
import Featured from '../components/home/Featured.astro';
import About from '../components/home/About.astro';
import Counters from '../components/home/Counters.astro';
import Bento from '../components/home/Bento.astro';
import Works from '../components/home/Works.astro';
import Timeline from '../components/home/Timeline.astro';
import Quote from '../components/home/Quote.astro';
import Contact from '../components/home/Contact.astro';

// Semua angka & konten di bawah diambil dari data situs yang sesungguhnya
// saat build — bukan angka atau contoh dikarang. Lihat catatan di
// Counters.astro.
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const materiPosts = allPosts.filter((p) => p.data.category === 'materi');
const artikelPosts = allPosts.filter((p) => p.data.category === 'artikel');
const latestPosts = allPosts.slice(0, 6);

const ruangBelajarSesi = (await getCollection('ruangBelajar', ({ data }) => !data.draft)).length;

// Jumlah simulasi Lab Maya TIDAK dihitung dari content collection (alat
// ukurnya komponen kode, bukan entri konten) -- di-hardcode di sini, tapi
// tetap angka NYATA (bukan dikarang), samain manual tiap kali nambah
// simulasi baru. Per 2026-08-29: sama dengan jumlah entri di customLabs
// pada src/pages/lab-maya/index.astro -- 1 Eksplorasi Alat Ukur (Jangka
// Sorong, Mikrometer Sekrup, Neraca Ohaus, Stopwatch Analog, Amperemeter,
// Termometer digabung 1 halaman) + Hukum Coulomb, Medan Listrik, Hukum
// Newton, Usaha dan Daya, Energi Mekanik, Energy Transformation Lab, Energy
// Conservation Lab, Renewable Energy Lab, Energy Consumption Lab,
// Non-Renewable Energy Lab, Energy Efficiency Lab, Energy Crisis Lab,
// Energy Planning Lab, Simulasi Massa Jenis (PhET, wrapper sendiri).
const LAB_MAYA_SIMULASI_COUNT = 15;

const counters = [
  { icon: '📘', value: String(materiPosts.length), suffix: '+', label: 'Materi Pelajaran' },
  { icon: '✍️', value: String(artikelPosts.length), suffix: '', label: 'Artikel' },
  { icon: '🧪', value: String(LAB_MAYA_SIMULASI_COUNT), suffix: '', label: 'Simulasi Lab Maya' },
  { icon: '🎥', value: String(ruangBelajarSesi), suffix: '', label: 'Sesi Pembelajaran Daring' },
];

const featured = materiPosts.find((p) => p.data.simulasi) ?? materiPosts[0] ?? allPosts[0];

const modeDaring = await getEntry('modeDaring', 'index');
const daringAktif = modeDaring?.data.aktif ?? false;

const workItems = materiPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    href: `/materi/${p.id}`,
    tag: p.data.mapel ?? 'Materi',
    hasLab: Boolean(p.data.simulasi),
  }));
---

<BaseLayout
  title="PancaEdu"
  description="Artikel dan materi pelajaran ditulis oleh seorang guru yang juga pembelajar — refleksi mengajar, bahan ajar, dan catatan belajar."
>
  <Hero />
  {daringAktif && <PembelajaranDaringBanner />}
  {featured && (
    <Featured
      title={featured.data.title}
      description={featured.data.description}
      href={`/materi/${featured.id}`}
      mapel={featured.data.mapel}
      kelas={featured.data.kelas}
      hasLab={Boolean(featured.data.simulasi)}
    />
  )}

  {latestPosts.length > 0 && (
    <section class="section latest">
      <div class="container">
        <p class="eyebrow" data-reveal>Terbaru</p>
        <div class="post-grid">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <About />
  <Counters counters={counters} />
  <Bento />
  {workItems.length > 0 && <Works items={workItems} />}
  <Timeline />
  <Quote />
  <Contact />
</BaseLayout>

<style>
  .latest {
    padding-top: 0;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
</style>
