---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan.">
  <section class="container not-found">
    <p class="eyebrow">404</p>
    <h1>Halaman tidak ditemukan</h1>
    <p>Halaman yang Anda cari mungkin sudah dipindah atau tidak pernah ada.</p>
    <a href="/" class="btn btn-primary">Kembali ke Beranda</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 5rem;
    text-align: center;
    max-width: 30rem;
    margin-inline: auto;
  }
</style>
