---
// WAJIB on-demand (bukan lagi prerender) -- perlu cek sesi Admin Panca di
// server lewat cookie. Guru yang SUDAH login ke Admin Panca langsung lihat
// rekap tanpa PIN lagi (sesi itu sendiri sudah otentikasi yang lebih kuat
// daripada PIN); form PIN cuma muncul kalau belum ada sesi valid (mis.
// dibuka di perangkat/browser lain tanpa login, tapi punya PIN yang
// dibagikan). Validitasnya (baik sesi maupun PIN) TETAP dicek ulang di
// server saat fetch data (lihat /api/penugasan/rekap/[slug]) -- flag
// `sudahLogin` di sini cuma menentukan tampilan awal, bukan satu-satunya
// penjaga akses.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ambilSesi } from '../../lib/adminPanca/auth';
import { env } from 'cloudflare:workers';

export const prerender = false;

const semuaPenugasan = await getCollection('penugasan', ({ data }) => !data.draft);
const sesi = await ambilSesi(Astro.cookies, env.ADMIN_SESSION_SECRET);
const sudahLogin = sesi !== null;
---

<BaseLayout
  title="Rekap Nilai"
  description="Rekap nilai Penugasan dikelompokkan per kelas -- khusus guru, digerbangi PIN."
  noindex
>
  <section class="container page-header">
    <a href="/penugasan" class="back-link">&larr; Semua Penugasan</a>
    <p class="eyebrow">📊 Rekap Nilai · Khusus Guru</p>
    <h1>Rekap Nilai per Kelas</h1>
    <p class="page-lede">Pilih penugasan, lihat rata-rata & skor tertinggi tiap kelas yang mengerjakannya.</p>
  </section>

  <section class="container gate-section" data-sudah-login={sudahLogin ? '1' : ''}>
    {sudahLogin && (
      <p class="login-hint">✅ Masuk sebagai <strong>{sesi!.username}</strong> lewat Admin Panca -- tidak perlu PIN.</p>
    )}

    <form class="pin-form card" data-pin-form hidden={sudahLogin}>
      <label for="pin">PIN Guru</label>
      <div class="pin-row">
        <input
          type="text"
          id="pin"
          name="pin"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="Masukkan PIN Guru"
          required
        />
        <button type="submit" class="btn btn-primary">Buka Rekap</button>
      </div>
      <p class="pin-error" data-pin-error hidden></p>
      <p class="pin-hint">
        Belum punya PIN? Buat lewat <a href="/admin-panca/pin">Admin Panca &rarr; Kelola PIN</a>, atau
        <a href="/admin-panca/login">masuk ke Admin Panca</a> kalau sudah punya akun.
      </p>
    </form>

    <div class="rekap-wrap" data-rekap-wrap hidden>
      <label class="rekap-pilih-label">
        Pilih Penugasan
        <select class="pn-select" data-rekap-pilih>
          {semuaPenugasan.map((p) => (
            <option value={p.id}>{p.data.kelas} · {p.data.mapel} — {p.data.judul}</option>
          ))}
        </select>
      </label>

      <p class="leaderboard-loading" data-rekap-loading hidden>Memuat...</p>
      <div class="table-scroll">
        <table class="leaderboard-table" data-rekap-table></table>
      </div>
      <p class="leaderboard-empty" data-rekap-empty hidden>Belum ada yang mengerjakan tugas ini.</p>
    </div>
  </section>
</BaseLayout>

<script>
  async function sha256Hex(text: string): Promise<string> {
    const bytes = new TextEncoder().encode(text);
    const digest = await crypto.subtle.digest('SHA-256', bytes);
    return Array.from(new Uint8Array(digest))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
  }

  type BarisRekap = { kelas: string; jumlahSiswa: number; rataRata: number; skorTertinggi: number; skorMaks: number };

  function baris(...isi: (string | number)[]): HTMLTableRowElement {
    const tr = document.createElement('tr');
    for (const nilai of isi) {
      const cell = document.createElement('td');
      cell.textContent = String(nilai);
      tr.appendChild(cell);
    }
    return tr;
  }

  function renderTable(table: HTMLTableElement, rows: BarisRekap[]) {
    const thead = document.createElement('thead');
    const headRow = document.createElement('tr');
    headRow.innerHTML = '<th>Kelas</th><th>Jumlah Siswa</th><th>Rata-rata</th><th>Skor Tertinggi</th>';
    thead.appendChild(headRow);

    const tbody = document.createElement('tbody');
    rows.forEach((r) => {
      tbody.appendChild(baris(r.kelas, r.jumlahSiswa, r.rataRata, `${r.skorTertinggi} / ${r.skorMaks}`));
    });

    table.replaceChildren(thead, tbody);
  }

  const section = document.querySelector<HTMLElement>('[data-sudah-login]');
  const form = document.querySelector<HTMLFormElement>('[data-pin-form]');
  const errorEl = document.querySelector<HTMLElement>('[data-pin-error]');
  const wrap = document.querySelector<HTMLElement>('[data-rekap-wrap]');
  const pilihSelect = document.querySelector<HTMLSelectElement>('[data-rekap-pilih]');
  const loadingEl = document.querySelector<HTMLElement>('[data-rekap-loading]');
  const emptyEl = document.querySelector<HTMLElement>('[data-rekap-empty]');
  const table = document.querySelector<HTMLTableElement>('[data-rekap-table]');

  if (section && form && errorEl && wrap && pilihSelect && table) {
    // Guru yang sudah login ke Admin Panca TIDAK butuh PIN sama sekali --
    // sesi cookie-nya otomatis ikut tiap fetch (same-origin), server yang
    // memeriksa ulang (lihat /api/penugasan/rekap/[slug]). Sengaja pakai
    // sessionStorage (bukan localStorage) untuk jalur PIN -- pola sama
    // seperti leaderboard & hasil-ujian, tidak "login permanen" di
    // perangkat bersama/sekolah. TIDAK ada lagi "expectedHash" statis untuk
    // dibandingkan di client -- PIN bisa lebih dari satu & berganti kapan
    // saja (dikelola di Admin Panca), jadi validitas SELALU dicek ulang ke
    // server tiap kali (termasuk saat restore dari sessionStorage).
    const sudahLogin = section.dataset.sudahLogin === '1';
    const SESSION_KEY = 'penugasan-rekap-pin';
    let pinTersimpan = sessionStorage.getItem(SESSION_KEY) ?? '';

    const muatRekap = async () => {
      const slug = pilihSelect.value;
      if (!slug || !(sudahLogin || pinTersimpan)) return;

      loadingEl?.removeAttribute('hidden');
      table.replaceChildren();
      emptyEl?.setAttribute('hidden', '');

      try {
        const query = pinTersimpan ? `?pin=${encodeURIComponent(pinTersimpan)}` : '';
        const res = await fetch(`/api/penugasan/rekap/${slug}${query}`);
        if (!res.ok) {
          const body = (await res.json().catch(() => null)) as { error?: string } | null;
          sessionStorage.removeItem(SESSION_KEY);
          pinTersimpan = '';
          // Kalau sesi sempat expired di tengah jalan, tetap kasih jalan keluar
          // lewat form PIN -- jangan biarkan halaman jadi buntu.
          wrap.hidden = true;
          form.hidden = false;
          if (errorEl) {
            errorEl.textContent = body?.error || 'Gagal membuka rekap. Coba lagi.';
            errorEl.hidden = false;
          }
          return;
        }
        const data = (await res.json()) as { rows: BarisRekap[] };
        if (data.rows.length === 0) {
          emptyEl?.removeAttribute('hidden');
        } else {
          renderTable(table, data.rows);
        }
      } catch {
        if (emptyEl) {
          emptyEl.textContent = 'Gagal memuat rekap. Coba muat ulang halaman.';
          emptyEl.removeAttribute('hidden');
        }
      } finally {
        loadingEl?.setAttribute('hidden', '');
      }
    };

    const buka = (hash: string) => {
      pinTersimpan = hash;
      form.hidden = true;
      wrap.hidden = false;
      muatRekap();
    };

    pilihSelect.addEventListener('change', muatRekap);

    if (sudahLogin) {
      wrap.hidden = false;
      muatRekap();
    } else if (pinTersimpan) {
      buka(pinTersimpan);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('#pin')!;
      const hash = await sha256Hex(input.value.trim());

      errorEl.hidden = true;
      sessionStorage.setItem(SESSION_KEY, hash);
      buka(hash);
    });
  }
</script>

<style>
  .page-header {
    padding-block: 3rem 1rem;
    max-width: 40rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .gate-section {
    padding-block: 1rem 4rem;
    max-width: 40rem;
  }

  .pin-form {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pin-form[hidden] {
    display: none;
  }

  .pin-form label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .pin-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pin-row input {
    flex: 1 1 12rem;
    padding: 0.7rem 1rem;
    border-radius: 0.6rem;
    border: 1px solid var(--border);
    background-color: var(--surface-solid);
    color: var(--ink);
    font-size: 1rem;
  }

  .pin-error {
    color: #b3423f;
    font-size: 0.875rem;
    margin: 0.25rem 0 0;
  }

  .pin-hint {
    color: var(--ink-soft);
    font-size: 0.8125rem;
    margin: 0.25rem 0 0;
  }

  .login-hint {
    color: var(--teal);
    font-size: 0.9375rem;
    margin: 0 0 1.25rem;
  }

  .rekap-wrap[hidden] {
    display: none;
  }

  .rekap-pilih-label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .leaderboard-loading,
  .leaderboard-empty {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    padding-block: 1rem;
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--glass-border);
    border-radius: 1rem;
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    box-shadow: var(--shadow);
  }

  .leaderboard-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .leaderboard-table th,
  .leaderboard-table td {
    padding: 0.65rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .leaderboard-table thead th {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--ink-soft);
    background-color: var(--accent-soft);
  }

  .leaderboard-table tbody tr:last-child td {
    border-bottom: none;
  }
</style>
