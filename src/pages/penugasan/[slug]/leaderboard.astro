---
// WAJIB on-demand (bukan lagi prerender) -- perlu cek sesi Admin Panca di
// server lewat cookie, sama pola seperti /penugasan/rekap. Guru yang sudah
// login ke Admin Panca langsung lihat papan peringkat tanpa PIN -- gampang
// lupa PIN leaderboard mana untuk Penugasan yang mana kalau harus diingat
// satu-satu. PIN tetap ada & berfungsi normal untuk MURID (dibagikan guru),
// dicocokkan ulang di server saat fetch data (lihat
// /api/penugasan/leaderboard/[slug]) -- flag `sudahLogin` di sini cuma
// menentukan tampilan awal, bukan satu-satunya penjaga akses.
export const prerender = false;

import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ambilSesi } from '../../../lib/adminPanca/auth';
import { daftarSesi } from '../../../lib/penugasan/sesi';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const entry = slug ? await getEntry('penugasan', slug) : undefined;

if (!entry || entry.data.draft) {
  return new Response(null, { status: 404 });
}

const { judul, kelas, mapel, pinHash } = entry.data;
const sesiAdmin = await ambilSesi(Astro.cookies, env.ADMIN_SESSION_SECRET);
const sudahLogin = sesiAdmin !== null;

// Dropdown filter Sesi -- cuma muncul kalau Penugasan ini PERNAH dibuatkan
// sesi lewat Admin Panca (lihat /admin-panca/sesi & migrations/0003).
// Query `?sesi=` (dikirim otomatis dari link "Lihat Papan Peringkat" begitu
// siswa selesai mengerjakan sesi tertentu, lihat src/pages/penugasan/[slug].astro)
// jadi pilihan awal -- tanpa itu, default TETAP "Semua Sesi" supaya link
// lama/dibagikan manual tanpa parameter tidak tiba-tiba kosong.
const daftarSesiPenugasan = entry.id ? await daftarSesi(env.DB, entry.id) : [];
const sesiParam = Astro.url.searchParams.get('sesi') ?? '';
---

<BaseLayout title={`Papan Peringkat — ${judul}`} description={`Papan peringkat penugasan ${judul}, kelas ${kelas}.`} noindex>
  <section class="container page-header">
    <a href={`/penugasan/${entry.id}`} class="back-link">&larr; Kembali ke Penugasan</a>
    <p class="eyebrow">🏆 Papan Peringkat · {mapel} · Kelas {kelas}</p>
    <h1>{judul}</h1>
  </section>

  <section class="container gate-section" data-pin-hash={pinHash} data-slug={entry.id} data-sudah-login={sudahLogin ? '1' : ''}>
    {sudahLogin && (
      <p class="login-hint">✅ Masuk sebagai <strong>{sesiAdmin!.username}</strong> lewat Admin Panca -- tidak perlu PIN.</p>
    )}

    <form class="pin-form card" data-pin-form hidden={sudahLogin}>
      <label for="pin">Kode PIN</label>
      <div class="pin-row">
        <input
          type="text"
          id="pin"
          name="pin"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="Minta kode ini ke guru"
          required
        />
        <button type="submit" class="btn btn-primary">Buka Papan Peringkat</button>
      </div>
      <p class="pin-error" data-pin-error hidden>Kode PIN salah. Coba lagi.</p>
    </form>

    <div class="leaderboard-wrap" data-leaderboard-wrap hidden>
      {daftarSesiPenugasan.length > 0 && (
        <label class="sesi-filter-label">
          Sesi
          <select data-sesi-filter>
            <option value="" selected={sesiParam === ''}>Semua Sesi (digabung)</option>
            <option value="tanpa-sesi" selected={sesiParam === 'tanpa-sesi'}>Tanpa Sesi (sebelum ada sesi)</option>
            {daftarSesiPenugasan.map((s) => (
              <option value={s.id} selected={String(s.id) === sesiParam}>
                {s.label} {s.revoked_at ? '(dicabut)' : ''}
              </option>
            ))}
          </select>
        </label>
      )}
      <div class="sort-row" role="group" aria-label="Urutkan papan peringkat" data-sort-row>
        <button type="button" class="filter-btn badge" data-sort="tepat" aria-pressed="true">🎯 Paling Tepat</button>
        <button type="button" class="filter-btn badge" data-sort="cepat" aria-pressed="false">⚡ Paling Cepat</button>
      </div>
      <p class="leaderboard-loading" data-leaderboard-loading hidden>Memuat...</p>
      <div class="table-scroll">
        <table class="leaderboard-table" data-leaderboard-table></table>
      </div>
      <p class="leaderboard-empty" data-leaderboard-empty hidden>Belum ada yang mengerjakan penugasan ini.</p>
    </div>
  </section>
</BaseLayout>

<script>
  async function sha256Hex(text: string): Promise<string> {
    const bytes = new TextEncoder().encode(text);
    const digest = await crypto.subtle.digest('SHA-256', bytes);
    return Array.from(new Uint8Array(digest))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
  }

  type BarisLeaderboard = {
    nama: string;
    kelas: string;
    skorTerbaik: number;
    skorMaks: number;
    durasiDetik: number;
    percobaanKe: number;
  };
  type ModeSort = 'tepat' | 'cepat';

  // Format M:SS (mis. "7:05") -- lebih umum & jelas daripada "7m 05d" yang
  // gampang salah dibaca seolah "7 menit 5 HARI" (huruf "d" dikira "day").
  function formatDurasi(detik: number): string {
    const total = Math.max(0, Math.round(detik));
    const menit = Math.floor(total / 60);
    const sisaDetik = total % 60;
    return `${menit}:${String(sisaDetik).padStart(2, '0')}`;
  }

  // Warna badge skor berdasarkan persentase -- kalau skorMaks 0 (soal
  // belum ada skornya sama sekali, edge case), dianggap netral.
  function kelasSkor(skorTerbaik: number, skorMaks: number): string {
    if (skorMaks <= 0) return 'skor-netral';
    const persen = (skorTerbaik / skorMaks) * 100;
    if (persen >= 80) return 'skor-tinggi';
    if (persen >= 50) return 'skor-sedang';
    return 'skor-rendah';
  }

  // "Paling Tepat" = urut skor dulu (tie-break waktu tercepat), "Paling
  // Cepat" = urut waktu dulu (tie-break skor tertinggi) -- dua sudut
  // pandang atas data yang SAMA, jadi cukup sort ulang di klien tanpa
  // fetch API kedua kalinya (baris sudah lengkap dari satu kali panggil).
  function urutkan(rows: BarisLeaderboard[], mode: ModeSort): BarisLeaderboard[] {
    const salinan = [...rows];
    if (mode === 'cepat') {
      salinan.sort((a, b) => a.durasiDetik - b.durasiDetik || b.skorTerbaik - a.skorTerbaik);
    } else {
      salinan.sort((a, b) => b.skorTerbaik - a.skorTerbaik || a.durasiDetik - b.durasiDetik);
    }
    return salinan;
  }

  function selText(tag: string, teks: string | number, kelas?: string): HTMLElement {
    const el = document.createElement(tag);
    el.textContent = String(teks);
    if (kelas) el.className = kelas;
    return el;
  }

  const MEDALI = ['🥇', '🥈', '🥉'];

  function renderTable(table: HTMLTableElement, rows: BarisLeaderboard[]) {
    const thead = document.createElement('thead');
    const headRow = document.createElement('tr');
    headRow.innerHTML = '<th>#</th><th>Nama</th><th>Kelas</th><th>Skor</th><th>Waktu Pengerjaan</th><th>Percobaan Ke-</th>';
    thead.appendChild(headRow);

    // Nama & kelas ditulis siswa sendiri lewat form (bukan konten yang
    // ditulis lewat CMS) -- pakai textContent (lewat selText()), BUKAN
    // innerHTML dengan interpolasi string, supaya tidak ada celah XSS
    // kalau ada yang isi nama/kelas dengan markup aneh-aneh.
    const tbody = document.createElement('tbody');
    rows.forEach((r, i) => {
      const tr = document.createElement('tr');

      const tdRank = document.createElement('td');
      tdRank.className = 'lb-rank';
      tdRank.textContent = i < 3 ? MEDALI[i] : String(i + 1);
      tr.appendChild(tdRank);

      tr.appendChild(selText('td', r.nama));
      tr.appendChild(selText('td', r.kelas));

      const tdSkor = document.createElement('td');
      const badge = document.createElement('span');
      badge.className = `skor-badge ${kelasSkor(r.skorTerbaik, r.skorMaks)}`;
      badge.textContent = `${r.skorTerbaik} / ${r.skorMaks}`;
      tdSkor.appendChild(badge);
      tr.appendChild(tdSkor);

      tr.appendChild(selText('td', formatDurasi(r.durasiDetik), 'lb-waktu'));
      tr.appendChild(selText('td', r.percobaanKe));

      tbody.appendChild(tr);
    });

    table.replaceChildren(thead, tbody);
  }

  const section = document.querySelector<HTMLElement>('[data-pin-hash]');
  const form = document.querySelector<HTMLFormElement>('[data-pin-form]');
  const errorEl = document.querySelector<HTMLElement>('[data-pin-error]');
  const wrap = document.querySelector<HTMLElement>('[data-leaderboard-wrap]');
  const loadingEl = document.querySelector<HTMLElement>('[data-leaderboard-loading]');
  const emptyEl = document.querySelector<HTMLElement>('[data-leaderboard-empty]');
  const table = document.querySelector<HTMLTableElement>('[data-leaderboard-table]');
  const sortRow = document.querySelector<HTMLElement>('[data-sort-row]');
  const sesiFilterSelect = document.querySelector<HTMLSelectElement>('[data-sesi-filter]');

  if (section && form && errorEl && wrap && table) {
    const expectedHash = section.dataset.pinHash!;
    const slug = section.dataset.slug!;
    const sudahLogin = section.dataset.sudahLogin === '1';
    const sessionKey = `penugasan-leaderboard:${expectedHash}`;

    let semuaBaris: BarisLeaderboard[] = [];
    let modeAktif: ModeSort = 'tepat';

    const renderUlang = () => {
      if (semuaBaris.length === 0) return;
      renderTable(table, urutkan(semuaBaris, modeAktif));
    };

    sortRow?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sort]');
      if (!btn) return;
      modeAktif = btn.dataset.sort === 'cepat' ? 'cepat' : 'tepat';
      for (const b of sortRow.querySelectorAll<HTMLButtonElement>('[data-sort]')) {
        b.setAttribute('aria-pressed', String(b === btn));
      }
      renderUlang();
    });

    let pinTersimpan = '';

    const muatData = async (hash: string) => {
      pinTersimpan = hash;
      form.hidden = true;
      wrap.hidden = false;
      loadingEl?.removeAttribute('hidden');
      table.replaceChildren();
      emptyEl?.setAttribute('hidden', '');

      try {
        const params = new URLSearchParams();
        if (hash) params.set('pin', hash);
        if (sesiFilterSelect?.value) params.set('sesi', sesiFilterSelect.value);
        const qs = params.toString();
        const res = await fetch(`/api/penugasan/leaderboard/${slug}${qs ? `?${qs}` : ''}`);
        if (!res.ok) {
          // 403 di sini berarti server MENOLAK meski hash-nya cocok --
          // paling sering karena PIN sudah kedaluwarsa (lihat pengecekan
          // `pinBerlakuHingga` di API). Tampilkan pesan aslinya dari
          // server, JANGAN pesan generik, dan balikkan ke form PIN (bukan
          // ke tampilan "leaderboard kosong") -- ini bukan soal isi
          // leaderboard-nya, tapi soal aksesnya.
          const body = (await res.json().catch(() => null)) as { error?: string } | null;
          sessionStorage.removeItem(sessionKey);
          wrap.hidden = true;
          form.hidden = false;
          if (errorEl) {
            errorEl.textContent = body?.error || 'Gagal membuka leaderboard. Coba lagi.';
            errorEl.hidden = false;
          }
          return;
        }
        const data = (await res.json()) as { rows: BarisLeaderboard[] };
        semuaBaris = data.rows;
        if (semuaBaris.length === 0) {
          emptyEl?.removeAttribute('hidden');
        } else {
          renderUlang();
        }
      } catch {
        if (emptyEl) {
          emptyEl.textContent = 'Gagal memuat leaderboard. Coba muat ulang halaman.';
          emptyEl.removeAttribute('hidden');
        }
      } finally {
        loadingEl?.setAttribute('hidden', '');
      }
    };

    // Ganti Sesi -> muat ulang data dengan filter baru (pakai PIN/sesi yang
    // sama, cuma parameter `sesi` yang berubah) -- juga update URL (tanpa
    // reload) supaya link ini bisa disalin/dibagikan tetap ke sesi yang sama.
    sesiFilterSelect?.addEventListener('change', () => {
      const url = new URL(window.location.href);
      if (sesiFilterSelect.value) url.searchParams.set('sesi', sesiFilterSelect.value);
      else url.searchParams.delete('sesi');
      window.history.replaceState(null, '', url);
      if (wrap.hidden === false) muatData(pinTersimpan);
    });

    // Sengaja pakai sessionStorage (bukan localStorage), sama seperti
    // hasil-ujian -- tidak "login permanen" di perangkat bersama/sekolah.
    // Guru yang sudah login Admin Panca lewati semua ini, langsung muat
    // data (server yang menegakkan lewat sesi cookie, bukan hash di sini).
    if (sudahLogin) {
      muatData('');
    } else if (sessionStorage.getItem(sessionKey) === '1') {
      muatData(expectedHash);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('#pin')!;
      const hash = await sha256Hex(input.value.trim());

      if (hash === expectedHash) {
        errorEl.hidden = true;
        sessionStorage.setItem(sessionKey, '1');
        await muatData(hash);
      } else {
        // Reset ke pesan default -- kalau sebelumnya errorEl sempat diisi
        // pesan lain (mis. "PIN sudah kedaluwarsa" dari muatData), jangan
        // sampai pesan lama itu nyangkut buat kasus PIN salah biasa.
        errorEl.textContent = 'Kode PIN salah. Coba lagi.';
        errorEl.hidden = false;
        input.select();
      }
    });
  }
</script>

<style>
  .page-header {
    padding-block: 3rem 1rem;
    max-width: 40rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .gate-section {
    padding-block: 1rem 4rem;
    max-width: 40rem;
  }

  .pin-form {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Guard [hidden]+display, sama seperti hasil-ujian/[slug].astro &
     CookieConsent.astro -- lihat memori proyek soal bug berulang ini. */
  .pin-form[hidden] {
    display: none;
  }

  .pin-form label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .pin-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pin-row input {
    flex: 1 1 12rem;
    padding: 0.7rem 1rem;
    border-radius: 0.6rem;
    border: 1px solid var(--border);
    background-color: var(--surface-solid);
    color: var(--ink);
    font-size: 1rem;
  }

  .pin-error {
    color: #b3423f;
    font-size: 0.875rem;
    margin: 0.25rem 0 0;
  }

  .login-hint {
    color: var(--teal);
    font-size: 0.9375rem;
    margin: 0 0 1.25rem;
  }

  .leaderboard-wrap {
    margin-top: 1.5rem;
  }

  .sesi-filter-label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    max-width: 22rem;
    margin-bottom: 1.25rem;
  }

  .sesi-filter-label select {
    padding: 0.6rem 0.9rem;
    border-radius: 0.6rem;
    border: 1px solid var(--border);
    background-color: var(--surface-solid);
    color: var(--ink);
    font-size: 0.9375rem;
    font-family: var(--font-body);
  }

  .sort-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .filter-btn {
    border: 1px solid transparent;
    cursor: pointer;
    font-family: var(--font-body);
  }

  .filter-btn[aria-pressed='true'] {
    border-color: currentColor;
  }

  .leaderboard-loading,
  .leaderboard-empty {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    padding-block: 1rem;
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--glass-border);
    border-radius: 1rem;
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    box-shadow: var(--shadow);
  }

  .leaderboard-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }

  /* Rata tengah buat semua kolom KECUALI Nama (kolom ke-2 -- lebih enak
     dibaca rata kiri, apalagi nama panjang) -- guru minta tabelnya jangan
     berantakan/rapat kayak daftar biasa. */
  .leaderboard-table th,
  .leaderboard-table td {
    padding: 1rem 1.35rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
    white-space: nowrap;
  }

  .leaderboard-table th:last-child,
  .leaderboard-table td:last-child {
    border-right: none;
  }

  .leaderboard-table th:nth-child(2),
  .leaderboard-table td:nth-child(2) {
    text-align: left;
  }

  .leaderboard-table thead th {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background-color: var(--accent-soft);
  }

  .leaderboard-table tbody tr:last-child td {
    border-bottom: none;
  }

  .leaderboard-table tbody tr:nth-child(even) {
    background-color: var(--accent-soft);
  }

  .leaderboard-table tbody tr:hover {
    background-color: var(--gold-soft);
  }

  .leaderboard-table td:nth-child(2) {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .lb-rank {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
  }

  .lb-waktu {
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  .skor-badge {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .skor-tinggi {
    background: var(--teal-soft);
    color: var(--teal);
  }

  .skor-sedang {
    background: var(--gold-soft);
    color: var(--gold);
  }

  .skor-rendah {
    background: var(--rose-soft);
    color: var(--rose);
  }

  .skor-netral {
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>
