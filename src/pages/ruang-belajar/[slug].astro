---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { extractYoutubeId } from '../../lib/youtube';
import { kelasToSlug } from '../../lib/ruangBelajar';

export async function getStaticPaths() {
  const entries = await getCollection('ruangBelajar', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  kelas, mapel, bab, judul, deskripsi, durasi, tanggal, tujuanPembelajaran, materiSlug,
  youtubeId, latihanUrl, tugasUrl, refleksiUrl,
} = entry.data;

// Materi/lab TIDAK disimpan ulang di sini -- selalu dirujuk dari entri
// "materi" yang sudah ada (prinsip: jangan duplikasi materi). Video BEDA
// ceritanya -- lihat catatan youtubeId di content.config.ts.
const materi = materiSlug ? await getEntry('blog', materiSlug) : undefined;
const deskripsiTampil = deskripsi || materi?.data.description;

// Link Refleksi GLOBAL (satu Form buat semua sesi) dipakai kalau sesi ini
// tidak isi refleksiUrl sendiri -- lihat ruangBelajarPengaturan di
// content.config.ts.
const pengaturan = await getEntry('ruangBelajarPengaturan', 'index');
const refleksiUrlTampil = refleksiUrl || pengaturan?.data.refleksiUrlGlobal;
// Video punya Ruang Belajar sendiri diutamakan (mis. referensi eksternal
// yang sengaja tidak ditampilkan di halaman Materi); fallback ke video
// materi yang dirujuk kalau ada. Toleran kalau yang ditempel link
// lengkap, bukan ID doang.
const youtubeIdRawTampil = youtubeId || materi?.data.youtubeId;
const youtubeIdTampil = youtubeIdRawTampil ? extractYoutubeId(youtubeIdRawTampil) : undefined;

const formattedDate = tanggal.toLocaleDateString('id-ID', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Pembelajaran Berikutnya -- urutan SAMA PERSIS dengan yang dipakai
// /ruang-belajar (index: dikelompokkan per Kelas+Mapel, urut tanggal
// ASCENDING). Dihitung ulang di sini (bukan disimpan sebagai field manual
// di content) supaya OTOMATIS ikut benar kalau ada sesi baru disisipkan di
// tengah -- guru tidak perlu update field "sesi berikutnya" di tiap entri
// satu-satu tiap kali nambah sesi baru.
const semuaSesi = await getCollection('ruangBelajar', ({ data }) => !data.draft);
const urutanSekelas = semuaSesi
  .filter((s) => s.data.kelas === kelas && s.data.mapel === mapel)
  .sort((a, b) => a.data.tanggal.valueOf() - b.data.tanggal.valueOf() || a.id.localeCompare(b.id));
const indexSekarang = urutanSekelas.findIndex((s) => s.id === entry.id);
const sesiSebelumnya = indexSekarang > 0 ? urutanSekelas[indexSekarang - 1] : undefined;
const sesiBerikutnya = indexSekarang >= 0 ? urutanSekelas[indexSekarang + 1] : undefined;

// Badge "Langkah X dari Y" -- kalau sesi ini sudah dikelompokkan ke sebuah
// Bab, badge dipersempit jadi "Bab N · Nama — Langkah X dari Y" HANYA
// dalam bab itu (supaya urutan panjang lintas-bab, mis. 21 sesi, tidak
// terasa seperti satu daftar rata tanpa struktur). Nomor Bab & posisi di
// dalamnya dihitung dari urutan tanggal yang sama seperti urutanSekelas di
// atas -- BUKAN field manual -- jadi otomatis benar kalau ada sesi baru
// disisipkan. Sesi yang belum diberi `bab` (mis. Kelas XI/XII yang belum
// dikelompokkan) fallback ke badge lama, dihitung dari SELURUH sesi
// Kelas+Mapel seperti sebelumnya.
let babInfo: { nomor: number; nama: string; posisi: number; total: number } | undefined;
if (bab) {
  const urutanBab: string[] = [];
  for (const s of urutanSekelas) {
    if (s.data.bab && !urutanBab.includes(s.data.bab)) urutanBab.push(s.data.bab);
  }
  const entriesDiBab = urutanSekelas.filter((s) => s.data.bab === bab);
  babInfo = {
    nomor: urutanBab.indexOf(bab) + 1,
    nama: bab,
    posisi: entriesDiBab.findIndex((s) => s.id === entry.id) + 1,
    total: entriesDiBab.length,
  };
}

// Learning Path -- 6 langkah tetap, status ("tersedia"/"belum tersedia")
// murni dihitung dari ada-tidaknya data ini, BUKAN progress akun siswa.
const langkah = [
  {
    nomor: '01',
    label: 'Pelajari Materi',
    ikon: '📖',
    tersedia: Boolean(materi),
    cta: 'Buka Materi',
    href: materi ? `/materi/${materi.id}` : undefined,
    externalTarget: false,
    keterangan: materi ? materi.data.description : 'Materi belum tersedia untuk pembelajaran ini.',
  },
  {
    nomor: '02',
    label: 'Tonton Video',
    ikon: '▶',
    tersedia: Boolean(youtubeIdTampil),
    cta: 'Tonton Video',
    href: youtubeIdTampil ? `https://www.youtube.com/watch?v=${youtubeIdTampil}` : undefined,
    externalTarget: true,
    keterangan: youtubeIdTampil ? 'Video pembelajaran di YouTube.' : 'Belum ada video untuk pembelajaran ini.',
  },
  {
    nomor: '03',
    label: 'Eksperimen / Lab Maya',
    ikon: '🧪',
    tersedia: Boolean(materi?.data.simulasi),
    cta: 'Mulai Eksperimen',
    href: materi?.data.simulasi?.url,
    externalTarget: true,
    keterangan: materi?.data.simulasi ? `Simulasi: ${materi.data.simulasi.judul}` : 'Belum ada simulasi untuk materi ini.',
  },
  {
    nomor: '04',
    label: 'Latihan',
    ikon: '📝',
    // Dua sumber -- link platform eksternal (latihanUrl -- Google Form,
    // Wayground/Quizizz, Kahoot, dll, bebas apa saja), ATAU kuis bawaan
    // yang sudah ada di halaman Materi (prinsip: pakai yang sudah ada,
    // jangan duplikasi). latihanUrl diutamakan kalau dua-duanya ada.
    tersedia: Boolean(latihanUrl) || Boolean(materi?.data.kuis?.length),
    cta: latihanUrl ? 'Kerjakan Latihan' : 'Kerjakan Kuis',
    href: latihanUrl || (materi?.data.kuis?.length ? `/materi/${materi.id}/uji-pemahaman` : undefined),
    externalTarget: Boolean(latihanUrl),
    // Link Google Form/Wayground dkk sering gagal login kalau dibuka dari
    // in-app browser (WhatsApp/Instagram/dll) di Android -- lihat script
    // #force-chrome-android di bawah.
    forceChromeAndroid: Boolean(latihanUrl),
    keterangan: latihanUrl
      ? 'Latihan lewat link yang sudah disiapkan guru.'
      : materi?.data.kuis?.length
        ? 'Kuis uji pemahaman di laman terpisah, dengan tombol kembali ke sini.'
        : 'Belum ada latihan untuk pembelajaran ini.',
  },
  {
    nomor: '05',
    label: 'Tugas',
    ikon: '📤',
    tersedia: Boolean(tugasUrl),
    cta: 'Kerjakan / Kumpulkan Tugas',
    href: tugasUrl,
    externalTarget: true,
    forceChromeAndroid: true,
    keterangan: tugasUrl ? 'Kerjakan/kumpulkan lewat link yang sudah disiapkan guru.' : 'Belum ada tugas untuk pembelajaran ini.',
  },
  {
    nomor: '06',
    label: 'Refleksi',
    ikon: '💭',
    tersedia: Boolean(refleksiUrlTampil),
    cta: 'Isi Refleksi',
    href: refleksiUrlTampil,
    externalTarget: true,
    forceChromeAndroid: true,
    keterangan: refleksiUrlTampil ? 'Refleksi singkat lewat Google Form.' : 'Belum ada refleksi untuk pembelajaran ini.',
  },
];
---

<BaseLayout
  title={`${judul} — Ruang Belajar`}
  description={deskripsiTampil ?? `${mapel} Kelas ${kelas}: ${judul}`}
>
  <article class="container pd-detail">
    <a href={`/ruang-belajar/kelas/${kelasToSlug(kelas)}`} class="small-back">&larr; Kelas {kelas}</a>

    <p class="eyebrow">{mapel} — Kelas {kelas}</p>
    <h1>{judul}</h1>

    <div class="pd-meta-row">
      {babInfo ? (
        <span class="pd-meta pd-meta-langkah">📘 Bab {babInfo.nomor} · {babInfo.nama} — Langkah {babInfo.posisi} dari {babInfo.total}</span>
      ) : (
        indexSekarang >= 0 && (
          <span class="pd-meta pd-meta-langkah">📍 Langkah {indexSekarang + 1} dari {urutanSekelas.length}</span>
        )
      )}
      {durasi && <span class="pd-meta">⏱ {durasi} menit</span>}
    </div>

    {deskripsiTampil && <p class="pd-lede">{deskripsiTampil}</p>}

    <p class="pd-tanggal-kecil">
      Sesi ini pertama kali diajarkan {formattedDate} -- tapi bisa dipelajari siapa saja, kapan saja, tidak terikat tanggal.
    </p>

    {tujuanPembelajaran.length > 0 && (
      <div class="pd-tujuan">
        <p class="pd-tujuan-label">Tujuan Pembelajaran</p>
        <ul>
          {tujuanPembelajaran.map((t: string) => <li>{t}</li>)}
        </ul>
      </div>
    )}

    <div class="pd-path">
      {langkah.map((l, i) => (
        <div class={`pd-step ${l.tersedia ? '' : 'pd-step--kosong'}`}>
          <div class="pd-step-line" aria-hidden="true">
            <span class="pd-step-num">{l.nomor}</span>
            {i < langkah.length - 1 && <span class="pd-step-connector"></span>}
          </div>
          <div class="pd-step-body">
            <h2>{l.ikon} {l.label}</h2>
            <p>{l.keterangan}</p>
            {l.tersedia ? (
              <a
                href={l.href}
                class="btn btn-primary"
                target={l.externalTarget ? '_blank' : undefined}
                rel={l.externalTarget ? 'noopener noreferrer' : undefined}
                data-force-chrome-android={l.forceChromeAndroid ? '' : undefined}
              >
                {l.cta} {l.externalTarget ? '↗' : '→'}
              </a>
            ) : (
              <span class="pd-step-unavailable">— Belum tersedia</span>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="pd-nav-grid">
      <div class="pd-nav-slot">
        {sesiSebelumnya ? (
          <a href={`/ruang-belajar/${sesiSebelumnya.id}`} class="pd-next-card">
            <span class="pd-next-label">⬅️ Pembelajaran Sebelumnya</span>
            <span class="pd-next-judul">{sesiSebelumnya.data.judul}</span>
            <span class="pd-next-cta">&larr; Lihat lagi</span>
          </a>
        ) : (
          <div class="pd-next-selesai">
            <span class="pd-next-label">🏁 Sesi Pertama</span>
            <p>Ini pembelajaran paling awal yang tersedia untuk {mapel} Kelas {kelas} saat ini.</p>
          </div>
        )}
      </div>

      <div class="pd-nav-slot">
        {sesiBerikutnya ? (
          <a href={`/ruang-belajar/${sesiBerikutnya.id}`} class="pd-next-card">
            <span class="pd-next-label">➡️ Pembelajaran Berikutnya</span>
            <span class="pd-next-judul">{sesiBerikutnya.data.judul}</span>
            <span class="pd-next-cta">Lanjut &rarr;</span>
          </a>
        ) : (
          <div class="pd-next-selesai">
            <span class="pd-next-label">🎉 Sesi Terakhir</span>
            <p>
              Ini pembelajaran terakhir yang tersedia untuk {mapel} Kelas {kelas} saat ini. Sesi berikutnya akan
              ditambahkan menyusul -- lihat <a href={`/ruang-belajar/kelas/${kelasToSlug(kelas)}`}>semua Bab Kelas {kelas}</a> sementara menunggu.
            </p>
          </div>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // Link Latihan/Tugas/Refleksi biasanya Google Form -- Google MEMBLOKIR
  // login di dalam in-app browser (WhatsApp/Instagram/TikTok/dll yang
  // dipakai siswa buat buka link ini), munculnya error "This browser or
  // app may not be secure". Di Android, ini bisa dihindari dengan memaksa
  // link dibuka lewat Chrome (bukan WebView bawaan app-nya) pakai skema
  // `intent://` -- Android akan mengeluarkan link dari in-app browser dan
  // membukanya di Chrome sungguhan. Tidak ada equivalent yang reliable di
  // iOS (Apple tidak sediakan mekanisme serupa), jadi cuma diterapkan di
  // Android; browser/OS lain dibiarkan pakai href asli apa adanya.
  //
  // SENGAJA tidak menimpa atribut href di DOM (walau lebih sederhana) --
  // kalau href diubah jadi `intent://...`, tekan-lama pada link buat
  // "Salin link"/"Bagikan" bakal ikut menyalin URL intent yang aneh itu,
  // bukan URL Google Form yang asli. Jadi href dibiarkan tetap bersih
  // apa adanya, dan pengalihan ke intent:// cuma dilakukan saat event
  // klik beneran terjadi (dihitung ulang setiap klik dari href asli).
  // Kalau link ini dipaste manual di Chrome (bukan diklik dari sini),
  // dia tetap URL https biasa -- otomatis buka tab baru di Chrome,
  // tanpa lompat ke app lain.
  document.querySelectorAll<HTMLAnchorElement>('[data-force-chrome-android]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (!/Android/i.test(navigator.userAgent)) return;
      let url: URL;
      try {
        url = new URL(a.href);
      } catch {
        return; // href bukan URL absolut yang valid -- biarkan navigasi normal.
      }
      if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
      e.preventDefault();
      const scheme = url.protocol.slice(0, -1); // "https:" -> "https"
      const rest = url.href.slice(url.protocol.length + 2); // buang "https://"
      const fallback = encodeURIComponent(url.href);
      window.location.href = `intent://${rest}#Intent;scheme=${scheme};package=com.android.chrome;S.browser_fallback_url=${fallback};end`;
    });
  });
</script>

<style>
  .pd-detail {
    padding-block: 3rem 4rem;
    max-width: var(--measure);
  }

  .small-back {
    display: inline-block;
    font-size: 0.875rem;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .pd-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .pd-meta {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .pd-meta-langkah {
    font-weight: 700;
    color: var(--accent);
  }

  .pd-lede {
    font-size: 1.0625rem;
    color: var(--ink-soft);
  }

  .pd-tanggal-kecil {
    font-size: 0.8125rem;
    color: var(--ink-faint);
    margin: 0.35rem 0 0;
  }

  .pd-tujuan {
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .pd-tujuan-label {
    font-weight: 600;
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
  }

  .pd-tujuan ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .pd-tujuan li {
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }

  .pd-path {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .pd-step {
    display: flex;
    gap: 1.25rem;
  }

  .pd-step-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .pd-step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .pd-step--kosong .pd-step-num {
    background: var(--surface);
    color: var(--ink-faint);
    border: 1px solid var(--border);
  }

  .pd-step-connector {
    width: 2px;
    flex-grow: 1;
    min-height: 2rem;
    background: var(--border);
    margin-block: 0.35rem;
  }

  .pd-step-body {
    padding-bottom: 2rem;
    flex-grow: 1;
  }

  .pd-step-body h2 {
    font-size: 1.125rem;
    margin: 0.35rem 0 0.35rem;
  }

  .pd-step-body p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0 0 0.85rem;
  }

  .pd-step-unavailable {
    color: var(--ink-faint);
    font-size: 0.875rem;
    font-style: italic;
  }

  .pd-nav-grid {
    margin-top: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--glass-border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  .pd-nav-slot {
    display: flex;
  }

  .pd-nav-slot > * {
    width: 100%;
  }

  @media (max-width: 36rem) {
    .pd-nav-grid {
      grid-template-columns: 1fr;
    }
  }

  .pd-next-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .pd-next-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    transition: border-color 0.2s ease;
  }

  .pd-next-card:hover {
    border-color: var(--border-strong);
  }

  .pd-next-card .pd-next-label {
    flex-basis: 100%;
    margin-bottom: 0;
  }

  .pd-next-judul {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .pd-next-cta {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .pd-next-selesai {
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .pd-next-selesai p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
</style>
