---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { extractYoutubeId } from '../../lib/youtube';

export async function getStaticPaths() {
  const entries = await getCollection('ruangBelajar', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const {
  kelas, mapel, judul, deskripsi, durasi, tanggal, tujuanPembelajaran, materiSlug,
  youtubeId, latihanUrl, tugasUrl, refleksiUrl,
} = entry.data;

// Materi/lab TIDAK disimpan ulang di sini -- selalu dirujuk dari entri
// "materi" yang sudah ada (prinsip: jangan duplikasi materi). Video BEDA
// ceritanya -- lihat catatan youtubeId di content.config.ts.
const materi = materiSlug ? await getEntry('blog', materiSlug) : undefined;
const deskripsiTampil = deskripsi || materi?.data.description;

// Link Refleksi GLOBAL (satu Form buat semua sesi) dipakai kalau sesi ini
// tidak isi refleksiUrl sendiri -- lihat ruangBelajarPengaturan di
// content.config.ts.
const pengaturan = await getEntry('ruangBelajarPengaturan', 'index');
const refleksiUrlTampil = refleksiUrl || pengaturan?.data.refleksiUrlGlobal;
// Video punya Ruang Belajar sendiri diutamakan (mis. referensi eksternal
// yang sengaja tidak ditampilkan di halaman Materi); fallback ke video
// materi yang dirujuk kalau ada. Toleran kalau yang ditempel link
// lengkap, bukan ID doang.
const youtubeIdRawTampil = youtubeId || materi?.data.youtubeId;
const youtubeIdTampil = youtubeIdRawTampil ? extractYoutubeId(youtubeIdRawTampil) : undefined;

const formattedDate = tanggal.toLocaleDateString('id-ID', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Learning Path -- 6 langkah tetap, status ("tersedia"/"belum tersedia")
// murni dihitung dari ada-tidaknya data ini, BUKAN progress akun siswa.
const langkah = [
  {
    nomor: '01',
    label: 'Pelajari Materi',
    ikon: '📖',
    tersedia: Boolean(materi),
    cta: 'Buka Materi',
    href: materi ? `/materi/${materi.id}` : undefined,
    externalTarget: false,
    keterangan: materi ? materi.data.description : 'Materi belum tersedia untuk pembelajaran ini.',
  },
  {
    nomor: '02',
    label: 'Tonton Video',
    ikon: '▶',
    tersedia: Boolean(youtubeIdTampil),
    cta: 'Tonton Video',
    href: youtubeIdTampil ? `https://www.youtube.com/watch?v=${youtubeIdTampil}` : undefined,
    externalTarget: true,
    keterangan: youtubeIdTampil ? 'Video pembelajaran di YouTube.' : 'Belum ada video untuk pembelajaran ini.',
  },
  {
    nomor: '03',
    label: 'Eksperimen / Lab Maya',
    ikon: '🧪',
    tersedia: Boolean(materi?.data.simulasi),
    cta: 'Mulai Eksperimen',
    href: materi?.data.simulasi?.url,
    externalTarget: true,
    keterangan: materi?.data.simulasi ? `Simulasi: ${materi.data.simulasi.judul}` : 'Belum ada simulasi untuk materi ini.',
  },
  {
    nomor: '04',
    label: 'Latihan',
    ikon: '📝',
    // Dua sumber -- link platform eksternal (latihanUrl -- Google Form,
    // Wayground/Quizizz, Kahoot, dll, bebas apa saja), ATAU kuis bawaan
    // yang sudah ada di halaman Materi (prinsip: pakai yang sudah ada,
    // jangan duplikasi). latihanUrl diutamakan kalau dua-duanya ada.
    tersedia: Boolean(latihanUrl) || Boolean(materi?.data.kuis?.length),
    cta: latihanUrl ? 'Kerjakan Latihan' : 'Kerjakan Kuis',
    href: latihanUrl || (materi?.data.kuis?.length ? `/materi/${materi.id}#kuis` : undefined),
    externalTarget: Boolean(latihanUrl),
    // Link Google Form/Wayground dkk sering gagal login kalau dibuka dari
    // in-app browser (WhatsApp/Instagram/dll) di Android -- lihat script
    // #force-chrome-android di bawah.
    forceChromeAndroid: Boolean(latihanUrl),
    keterangan: latihanUrl
      ? 'Latihan lewat link yang sudah disiapkan guru.'
      : materi?.data.kuis?.length
        ? 'Kuis uji pemahaman di halaman Materi.'
        : 'Belum ada latihan untuk pembelajaran ini.',
  },
  {
    nomor: '05',
    label: 'Tugas',
    ikon: '📤',
    tersedia: Boolean(tugasUrl),
    cta: 'Kerjakan / Kumpulkan Tugas',
    href: tugasUrl,
    externalTarget: true,
    forceChromeAndroid: true,
    keterangan: tugasUrl ? 'Kerjakan/kumpulkan lewat link yang sudah disiapkan guru.' : 'Belum ada tugas untuk pembelajaran ini.',
    catatan: tugasUrl ? '⚠️ Presensi kehadiran hari ini didasarkan pada tugas ini terkirim atau tidak. Kalau tidak mengirim tugas, dianggap tidak hadir.' : undefined,
  },
  {
    nomor: '06',
    label: 'Refleksi',
    ikon: '💭',
    tersedia: Boolean(refleksiUrlTampil),
    cta: 'Isi Refleksi',
    href: refleksiUrlTampil,
    externalTarget: true,
    forceChromeAndroid: true,
    keterangan: refleksiUrlTampil ? 'Refleksi singkat lewat Google Form.' : 'Belum ada refleksi untuk pembelajaran ini.',
  },
];
---

<BaseLayout
  title={`${judul} — Ruang Belajar`}
  description={deskripsiTampil ?? `${mapel} Kelas ${kelas}: ${judul}`}
>
  <article class="container pd-detail">
    <a href="/ruang-belajar" class="small-back">&larr; Semua Ruang Belajar</a>

    <p class="eyebrow">{mapel} — Kelas {kelas}</p>
    <h1>{judul}</h1>

    <div class="pd-meta-row">
      <span class="pd-meta">{formattedDate}</span>
      {durasi && <span class="pd-meta">⏱ {durasi} menit</span>}
    </div>

    {deskripsiTampil && <p class="pd-lede">{deskripsiTampil}</p>}

    {tujuanPembelajaran.length > 0 && (
      <div class="pd-tujuan">
        <p class="pd-tujuan-label">Tujuan Pembelajaran</p>
        <ul>
          {tujuanPembelajaran.map((t: string) => <li>{t}</li>)}
        </ul>
      </div>
    )}

    <div class="pd-path">
      {langkah.map((l, i) => (
        <div class={`pd-step ${l.tersedia ? '' : 'pd-step--kosong'}`}>
          <div class="pd-step-line" aria-hidden="true">
            <span class="pd-step-num">{l.nomor}</span>
            {i < langkah.length - 1 && <span class="pd-step-connector"></span>}
          </div>
          <div class="pd-step-body">
            <h2>{l.ikon} {l.label}</h2>
            <p>{l.keterangan}</p>
            {l.catatan && <p class="pd-step-catatan">{l.catatan}</p>}
            {l.tersedia ? (
              <a
                href={l.href}
                class="btn btn-primary"
                target={l.externalTarget ? '_blank' : undefined}
                rel={l.externalTarget ? 'noopener noreferrer' : undefined}
                data-force-chrome-android={l.forceChromeAndroid ? '' : undefined}
              >
                {l.cta} {l.externalTarget ? '↗' : '→'}
              </a>
            ) : (
              <span class="pd-step-unavailable">— Belum tersedia</span>
            )}
          </div>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>

<script>
  // Link Latihan/Tugas/Refleksi biasanya Google Form -- Google MEMBLOKIR
  // login di dalam in-app browser (WhatsApp/Instagram/TikTok/dll yang
  // dipakai siswa buat buka link ini), munculnya error "This browser or
  // app may not be secure". Di Android, ini bisa dihindari dengan memaksa
  // link dibuka lewat Chrome (bukan WebView bawaan app-nya) pakai skema
  // `intent://` -- Android akan mengeluarkan link dari in-app browser dan
  // membukanya di Chrome sungguhan. Tidak ada equivalent yang reliable di
  // iOS (Apple tidak sediakan mekanisme serupa), jadi cuma diterapkan di
  // Android; browser/OS lain dibiarkan pakai href asli apa adanya.
  const isAndroid = /Android/i.test(navigator.userAgent);
  if (isAndroid) {
    document.querySelectorAll<HTMLAnchorElement>('[data-force-chrome-android]').forEach((a) => {
      try {
        const url = new URL(a.href);
        if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
        const scheme = url.protocol.slice(0, -1); // "https:" -> "https"
        const rest = url.href.slice(url.protocol.length + 2); // buang "https://"
        const fallback = encodeURIComponent(url.href);
        a.href = `intent://${rest}#Intent;scheme=${scheme};package=com.android.chrome;S.browser_fallback_url=${fallback};end`;
      } catch {
        // href bukan URL absolut yang valid -- biarkan apa adanya.
      }
    });
  }
</script>

<style>
  .pd-detail {
    padding-block: 3rem 4rem;
    max-width: var(--measure);
  }

  .small-back {
    display: inline-block;
    font-size: 0.875rem;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .pd-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .pd-meta {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .pd-lede {
    font-size: 1.0625rem;
    color: var(--ink-soft);
  }

  .pd-tujuan {
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .pd-tujuan-label {
    font-weight: 600;
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
  }

  .pd-tujuan ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .pd-tujuan li {
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }

  .pd-path {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .pd-step {
    display: flex;
    gap: 1.25rem;
  }

  .pd-step-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .pd-step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .pd-step--kosong .pd-step-num {
    background: var(--surface);
    color: var(--ink-faint);
    border: 1px solid var(--border);
  }

  .pd-step-connector {
    width: 2px;
    flex-grow: 1;
    min-height: 2rem;
    background: var(--border);
    margin-block: 0.35rem;
  }

  .pd-step-body {
    padding-bottom: 2rem;
    flex-grow: 1;
  }

  .pd-step-body h2 {
    font-size: 1.125rem;
    margin: 0.35rem 0 0.35rem;
  }

  .pd-step-body p {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0 0 0.85rem;
  }

  .pd-step-catatan {
    color: var(--rose) !important;
    background: var(--rose-soft);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.85rem;
    font-size: 0.8125rem !important;
    font-weight: 600;
    margin: -0.35rem 0 0.85rem !important;
  }

  .pd-step-unavailable {
    color: var(--ink-faint);
    font-size: 0.875rem;
    font-style: italic;
  }
</style>
