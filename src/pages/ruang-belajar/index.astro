---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// modeDaring cuma buat nampilin catatan darurat (mis. kabut asap) --
// kalau ada. Ruang Belajar sendiri PERMANEN, tidak digerbangi field ini.
const modeDaring = await getEntry('modeDaring', 'index');
const aktif = modeDaring?.data.aktif ?? false;
const keterangan = modeDaring?.data.keterangan;
---

<BaseLayout
  title="Ruang Belajar"
  description="Ruang Belajar PancaEdu -- pilih kelasmu, ikuti bab demi bab secara berurutan, lalu kerjakan latihan/tugasnya. Tersedia kapan saja."
>
  <section class="container pd-hero">
    <div class="pd-hero-main">
      <p class="eyebrow">🎓 Ruang Belajar</p>
      <h1>Belajar Kapan Saja</h1>
      <p class="pd-hero-lede">Pilih kelasmu, lalu ikuti bab-babnya secara berurutan dari yang paling awal.</p>

      {aktif && keterangan && (
        <div class="pd-alert">
          <span class="pd-alert-icon" aria-hidden="true">📢</span>
          <p>{keterangan}</p>
        </div>
      )}
    </div>

    <a href="/ruang-belajar/panduan" class="pd-panduan-link">
      <span class="pd-panduan-icon" aria-hidden="true">💡</span>
      Belum tahu cara belajar di PancaEdu? Baca panduannya &rarr;
    </a>
  </section>

  <section class="container pd-mapel-section">
    <h2 class="pd-section-title">Pilih Mata Pelajaran</h2>
    <p class="pd-section-lede">Setiap mapel punya ruang belajarnya sendiri, tersusun rapi per Kelas.</p>

    <div class="pd-mapel-grid">
      <a href="/ruang-belajar/fisika" class="pd-mapel-card">
        <img src="/images/mapel-fisika-cover.png" alt="" class="pd-mapel-card-cover" loading="eager" />
        <span class="pd-mapel-card-label">
          Fisika
          <span class="pd-mapel-card-cta">Lihat Kelas &rarr;</span>
        </span>
      </a>
      <a href="/bahasa-inggris" class="pd-mapel-card">
        <img src="/images/mapel-bahasa-inggris-cover.png" alt="" class="pd-mapel-card-cover" loading="lazy" />
        <span class="pd-mapel-card-label">
          Bahasa Inggris
          <span class="pd-mapel-card-cta">Lihat Kelas &rarr;</span>
        </span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .pd-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block: 3rem 1.5rem;
  }

  .pd-hero-main {
    min-width: 0;
    max-width: var(--measure);
  }

  .pd-hero-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .pd-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    background: var(--gold-soft);
    border: 1px solid var(--gold);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.1rem;
    margin-top: 0.5rem;
  }

  .pd-alert-icon {
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .pd-alert p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .pd-section-title {
    font-size: 1.375rem;
    margin-bottom: 0.25rem;
  }

  .pd-section-lede {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0 0 1.75rem;
  }

  .pd-mapel-section {
    padding-block: 1rem 2rem;
  }

  .pd-mapel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.5rem;
    max-width: 40rem;
  }

  .pd-mapel-card {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--glass-border);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .pd-mapel-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .pd-mapel-card-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pd-mapel-card-label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.85rem 1.1rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.55) 0%, transparent 100%);
  }

  .pd-mapel-card-cta {
    font-size: 0.8125rem;
    font-weight: 600;
    opacity: 0.9;
  }

  .pd-panduan-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    white-space: nowrap;
  }

  .pd-panduan-icon {
    font-size: 1.375rem;
    line-height: 1;
  }

  .pd-panduan-link:hover {
    color: var(--accent);
    border-color: var(--border-strong);
  }

  @media (max-width: 30rem) {
    .pd-panduan-link {
      white-space: normal;
    }
  }

  /* HP sempit -- judul mapel & CTA ditumpuk vertikal (bukan space-between
     sejajar) supaya tidak mepet/terpotong di layar paling kecil (<=360px). */
  @media (max-width: 26rem) {
    .pd-mapel-card-label {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .pd-mapel-card-cta {
      font-size: 0.75rem;
    }
  }
</style>
