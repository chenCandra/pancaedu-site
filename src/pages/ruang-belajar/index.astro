---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kelasToSlug, type Kelas } from '../../lib/ruangBelajar';

// modeDaring cuma buat nampilin catatan darurat (mis. kabut asap) --
// kalau ada. Ruang Belajar sendiri PERMANEN, tidak digerbangi field ini.
const modeDaring = await getEntry('modeDaring', 'index');
const aktif = modeDaring?.data.aktif ?? false;
const keterangan = modeDaring?.data.keterangan;

const semua = await getCollection('ruangBelajar', ({ data }) => !data.draft);

// Ruang Belajar ditata sebagai 3 kartu Kelas (X/XI/XII) -- bukan lagi
// jadwal "hari ini" yang butuh sesi dibuka tepat pas tanggalnya (fitur
// "belajar daring" lama). Setiap kartu Kelas cuma perlu jumlah Bab &
// sesi buat ditampilkan di sini -- daftar lengkap urutan Bab ada di
// halaman /ruang-belajar/kelas/[kelas].
const KELAS_URUT: Kelas[] = ['X', 'XI', 'XII'];
const kelasCards = KELAS_URUT.map((kelas) => {
  const entries = semua.filter((p) => p.data.kelas === kelas);
  const babCount = new Set(entries.map((p) => p.data.bab).filter(Boolean)).size;
  const mapelList = [...new Set(entries.map((p) => p.data.mapel))].sort((a, b) => a.localeCompare(b, 'id'));
  return { kelas, slug: kelasToSlug(kelas), entries, babCount, mapelList };
}).filter((k) => k.entries.length > 0);
---

<BaseLayout
  title="Ruang Belajar"
  description="Ruang Belajar PancaEdu -- pilih kelasmu, ikuti bab demi bab secara berurutan, lalu kerjakan latihan/tugasnya. Tersedia kapan saja."
>
  <section class="container pd-hero">
    <div class="pd-hero-main">
      <p class="eyebrow">🎓 Ruang Belajar</p>
      <h1>Belajar Kapan Saja</h1>
      <p class="pd-hero-lede">Pilih kelasmu, lalu ikuti bab-babnya secara berurutan dari yang paling awal.</p>

      {aktif && keterangan && (
        <div class="pd-alert">
          <span class="pd-alert-icon" aria-hidden="true">📢</span>
          <p>{keterangan}</p>
        </div>
      )}
    </div>

    <a href="/ruang-belajar/panduan" class="pd-panduan-link">
      <span class="pd-panduan-icon" aria-hidden="true">💡</span>
      Belum tahu cara belajar di PancaEdu? Baca panduannya &rarr;
    </a>
  </section>

  {kelasCards.length > 0 && (
    <section class="container pd-kelas-section">
      <h2 class="pd-section-title">Pilih Kelas</h2>
      <p class="pd-section-lede">Materi tersusun rapi per Bab, urut dari sesi pertama sampai terakhir.</p>

      <div class="pd-kelas-grid">
        {kelasCards.map(({ kelas, slug, entries, babCount, mapelList }) => (
          <a href={`/ruang-belajar/kelas/${slug}`} class="pd-kelas-card">
            <div class="pd-kelas-card-tag">
              <span class="badge">{mapelList.join(', ').toUpperCase()}</span>
            </div>
            <h3 class="pd-kelas-card-title">Kelas {kelas}</h3>
            <p class="pd-kelas-card-desc">
              {babCount > 0 ? `${babCount} bab` : `${entries.length} sesi`} tersusun berurutan, siap dipelajari kapan saja.
            </p>
            <div class="pd-kelas-card-footer">
              <span class="pd-kelas-card-stat">{entries.length} sesi</span>
              <span class="pd-kelas-card-cta">Lihat Bab &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .pd-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block: 3rem 1.5rem;
  }

  .pd-hero-main {
    min-width: 0;
    max-width: var(--measure);
  }

  .pd-hero-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .pd-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    background: var(--gold-soft);
    border: 1px solid var(--gold);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.1rem;
    margin-top: 0.5rem;
  }

  .pd-alert-icon {
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .pd-alert p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .pd-section-title {
    font-size: 1.375rem;
    margin-bottom: 0.25rem;
  }

  .pd-section-lede {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0 0 1.75rem;
  }

  .pd-kelas-section {
    padding-block: 1rem 3rem;
  }

  .pd-kelas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }

  .pd-kelas-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .pd-kelas-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .pd-kelas-card-title {
    font-size: 1.5rem;
    margin: 0;
  }

  .pd-kelas-card-desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0;
    flex-grow: 1;
  }

  .pd-kelas-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
  }

  .pd-kelas-card-stat {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .pd-kelas-card-cta {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }

  .pd-panduan-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    white-space: nowrap;
  }

  .pd-panduan-icon {
    font-size: 1.375rem;
    line-height: 1;
  }

  .pd-panduan-link:hover {
    color: var(--accent);
    border-color: var(--border-strong);
  }

  @media (max-width: 30rem) {
    .pd-panduan-link {
      white-space: normal;
    }
  }
</style>
