---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RuangBelajarCard from '../../../components/RuangBelajarCard.astro';
import { kelasToSlug, kelasLabel, type Kelas } from '../../../lib/ruangBelajar';

// Halaman ini KHUSUS Fisika -- dijangkau hanya lewat /ruang-belajar/fisika
// (lihat index.astro di situ). Mapel lain (mis. "Bahasa Inggris", yang juga
// punya entri sesi di koleksi `ruangBelajar` buat keperluan lain) PUNYA
// rute & listing sendiri-sendiri (lihat /bahasa-inggris/kelas/[kelas]) dan
// SENGAJA difilter keluar di sini -- kalau tidak, satu laman kelas ini bisa
// nampilin materi dari lebih dari satu mapel sekaligus karena keduanya
// berbagi kelas yang sama (mis. Kelas X Fisika + Kelas X Bahasa Inggris).
// String 'Fisika' DITULIS ULANG di tiap tempat (bukan const module-scope
// yang di-closure) -- adapter Cloudflare menjalankan getStaticPaths
// terisolasi dari sisa scope modul ini saat prerender (lihat catatan sama
// di bahasa-inggris/kelas/[kelas].astro).

export async function getStaticPaths() {
  const semua = await getCollection('ruangBelajar', ({ data }) => !data.draft && data.mapel === 'Fisika');
  const kelasList = (['X', 'XI', 'XII', 'TKA'] as Kelas[]).filter((k) => semua.some((p) => p.data.kelas === k));
  return kelasList.map((kelas) => ({
    params: { kelas: kelasToSlug(kelas) },
    props: { kelas },
  }));
}

const { kelas } = Astro.props as { kelas: Kelas };

const semua = await getCollection('ruangBelajar', ({ data }) => !data.draft && data.mapel === 'Fisika');

// Dikelompokkan per Bab, urut tanggal ASCENDING (progres belajar dari sesi
// pertama ke terakhir). Nomor Bab dihitung dari urutan MUNCUL PERTAMA KALI,
// sama seperti babInfo di [slug].astro (lihat komentar di sana).
const mapelGroups = ['Fisika'].map((mapel) => {
  const entries = semua
    .filter((p) => p.data.kelas === kelas)
    .sort((a, b) => a.data.tanggal.valueOf() - b.data.tanggal.valueOf());

  const babGroups: { nama: string; entries: typeof entries }[] = [];
  const tanpaBab: typeof entries = [];
  for (const entry of entries) {
    const nama = entry.data.bab;
    if (!nama) { tanpaBab.push(entry); continue; }
    let grup = babGroups.find((g) => g.nama === nama);
    if (!grup) { grup = { nama, entries: [] }; babGroups.push(grup); }
    grup.entries.push(entry);
  }

  return { mapel, entries, babGroups, tanpaBab };
}).filter((g) => g.entries.length > 0);
---

<BaseLayout
  title={`${kelasLabel(kelas)} — Ruang Belajar`}
  description={`Ruang Belajar ${kelasLabel(kelas)} PancaEdu -- bab demi bab tersusun berurutan, siap dipelajari kapan saja.`}
>
  <section class="container pd-hero">
    <a href="/ruang-belajar" class="small-back">&larr; Semua Kelas</a>
    <p class="eyebrow">🎓 Ruang Belajar</p>
    <h1>{kelasLabel(kelas)}</h1>
    <p class="pd-hero-lede">Ikuti bab-babnya berurutan dari atas ke bawah, dari sesi paling awal ke terbaru.</p>
  </section>

  {mapelGroups.length > 0 ? (
    <section class="container pd-silabus">
      {mapelGroups.map((group) => (
        <div class="pd-mapel-group">
          {mapelGroups.length > 1 && <h2 class="pd-mapel-title">{group.mapel}</h2>}

          {group.babGroups.map((babGroup, i) => (
            <div class="pd-bab-group">
              <h3 class="pd-bab-title">
                <span class="pd-bab-nomor">Bab {i + 1}</span>
                <span class="pd-bab-nama">{babGroup.nama}</span>
              </h3>
              <div class="pd-grid">
                {babGroup.entries.map((entry) => <RuangBelajarCard entry={entry} />)}
              </div>
            </div>
          ))}

          {group.tanpaBab.length > 0 && (
            <div class="pd-grid">
              {group.tanpaBab.map((entry) => <RuangBelajarCard entry={entry} />)}
            </div>
          )}
        </div>
      ))}
    </section>
  ) : (
    <section class="container pd-silabus">
      <p class="pd-empty">Belum ada pembelajaran untuk {kelasLabel(kelas)}.</p>
    </section>
  )}
</BaseLayout>

<style>
  .pd-hero {
    padding-block: 3rem 1.5rem;
    max-width: var(--measure);
  }

  .small-back {
    display: inline-block;
    font-size: 0.875rem;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .pd-hero-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .pd-silabus {
    padding-block: 1rem 3rem;
  }

  .pd-empty {
    color: var(--ink-soft);
    padding-block: 1rem;
  }

  .pd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.25rem;
  }

  .pd-mapel-group {
    margin-bottom: 2.5rem;
  }

  .pd-mapel-group:last-child {
    margin-bottom: 0;
  }

  .pd-mapel-title {
    font-size: 1.0625rem;
    color: var(--accent);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .pd-bab-group {
    margin-bottom: 2rem;
  }

  .pd-bab-group:last-child {
    margin-bottom: 0;
  }

  .pd-bab-title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
  }

  .pd-bab-nomor {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-ink);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .pd-bab-nama {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
</style>
