---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostIndexData from '../components/PostIndexData.astro';
---

<BaseLayout title="Cari" description="Cari artikel & materi di PancaEdu.">
  <section class="container page-header">
    <p class="eyebrow">🔍 Cari</p>
    <h1>Cari Artikel & Materi</h1>
    <p class="page-lede">Ketik judul, topik, atau kata kunci yang kamu ingat.</p>
  </section>

  <section class="container search-wrap">
    <input
      type="search"
      class="search-input"
      data-search-input
      placeholder="Cari, mis. &quot;dilatasi waktu&quot; atau &quot;refleksi&quot;..."
      autofocus
    />
    <p class="result-count" data-result-count aria-live="polite"></p>
  </section>

  <section class="container result-list" data-result-list></section>
  <p class="container result-empty" data-result-empty>Ketik kata kunci buat mulai mencari.</p>
</BaseLayout>

<PostIndexData />

<script>
  import { readPostIndex, renderResultItem, type IndexedPost } from '../scripts/post-index';

  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const list = document.querySelector<HTMLElement>('[data-result-list]');
  const emptyState = document.querySelector<HTMLElement>('[data-result-empty]');
  const countEl = document.querySelector<HTMLElement>('[data-result-count]');
  const index = readPostIndex();

  function search(query: string): IndexedPost[] {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    return index.filter((post) => {
      const haystack = `${post.title} ${post.description} ${post.topik ?? ''} ${post.mapel ?? ''}`.toLowerCase();
      return haystack.includes(q);
    });
  }

  function render(query: string) {
    const q = query.trim();
    if (!list || !emptyState) return;

    if (!q) {
      list.innerHTML = '';
      emptyState.hidden = false;
      emptyState.textContent = 'Ketik kata kunci buat mulai mencari.';
      if (countEl) countEl.textContent = '';
      return;
    }

    const results = search(q);
    list.innerHTML = results.map((post) => renderResultItem(post)).join('');
    emptyState.hidden = results.length > 0;
    emptyState.textContent = `Tidak ada hasil buat "${q}".`;
    if (countEl) countEl.textContent = results.length > 0 ? `${results.length} hasil` : '';
  }

  // Dukung ?q=... di URL biar hasil cari bisa di-bookmark/di-share.
  const params = new URLSearchParams(location.search);
  const initialQuery = params.get('q') ?? '';
  if (input) input.value = initialQuery;
  render(initialQuery);

  input?.addEventListener('input', () => {
    render(input.value);
    const url = new URL(location.href);
    if (input.value) url.searchParams.set('q', input.value);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  });
</script>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 40rem;
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .search-wrap {
    padding-block: 0.5rem 1.5rem;
  }

  .search-input {
    width: 100%;
    max-width: 34rem;
    padding: 0.9rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-solid);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .search-input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .result-count {
    margin: 0.6rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .result-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 0.5rem 2rem;
    max-width: 42rem;
  }

  .result-empty {
    color: var(--ink-soft);
    padding-block: 1rem 4rem;
  }
</style>

<style is:global>
  /* Kartu hasil pencarian/tersimpan — dipakai juga di /tersimpan, style
     global karena dirender lewat innerHTML (bukan komponen Astro). */
  .result-item-wrap {
    position: relative;
  }

  .result-item-link {
    display: block;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .result-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }

  .result-item-link h3 {
    font-size: 1.0625rem;
    margin: 0 0 0.3rem;
  }

  .result-item-link p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .result-remove {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface-solid);
    color: var(--ink-soft);
    cursor: pointer;
    font-size: 0.8125rem;
    line-height: 1;
  }

  .result-remove:hover {
    color: var(--rose);
    border-color: var(--rose);
  }
</style>
