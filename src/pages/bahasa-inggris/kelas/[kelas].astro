---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ModulCard from '../../../components/bahasa-inggris/ModulCard.astro';

// Kelas X = Fase E, Kelas XI & XII = Fase F (lihat panduan kurikulum di
// PROMPT/) -- dipetakan di sini, BUKAN pakai lib/ruangBelajar.ts punya
// Fisika, karena sistem Bahasa Inggris ini sengaja berdiri sendiri
// (koleksi `blog`, bukan `ruangBelajar`). label/fase dikirim lewat
// `props`, BUKAN lookup dari const di luar getStaticPaths -- adapter
// Cloudflare menjalankan getStaticPaths terisolasi dari sisa scope modul
// ini saat prerender, closure ke const luar bikin "ReferenceError: ...
// is not defined" waktu build.
export async function getStaticPaths() {
  return [
    { params: { kelas: 'x' }, props: { kelasLabel: 'X', fase: 'Fase E' } },
    { params: { kelas: 'xi' }, props: { kelasLabel: 'XI', fase: 'Fase F' } },
    { params: { kelas: 'xii' }, props: { kelasLabel: 'XII', fase: 'Fase F' } },
  ];
}

const { kelasLabel, fase } = Astro.props as { kelasLabel: string; fase: string };

const modul = (
  await getCollection(
    'blog',
    ({ data }) =>
      data.category === 'materi' && data.mapel === 'Bahasa Inggris' && data.kelas === kelasLabel && !data.draft
  )
).sort(
  (a, b) => (a.data.urutan ?? 999) - (b.data.urutan ?? 999) || a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
---

<BaseLayout
  title={`Bahasa Inggris Kelas ${kelasLabel}`}
  description={`Modul Bahasa Inggris Kelas ${kelasLabel} (${fase}) PancaEdu, tersusun berurutan.`}
>
  <section class="container bi-hero">
    <a href="/bahasa-inggris" class="bi-small-back">&larr; Bahasa Inggris</a>
    <p class="eyebrow">🇬🇧 Bahasa Inggris</p>
    <h1>Kelas {kelasLabel}</h1>
    <p class="bi-hero-lede">{fase} -- ikuti modulnya berurutan dari atas ke bawah.</p>
  </section>

  <section class="container bi-grid-section">
    {modul.length > 0 ? (
      <div class="bi-grid">
        {modul.map((entry) => <ModulCard entry={entry} />)}
      </div>
    ) : (
      <p class="bi-empty">
        Belum ada modul Bahasa Inggris untuk Kelas {kelasLabel} -- sedang disiapkan.
      </p>
    )}
  </section>
</BaseLayout>

<style>
  .bi-hero {
    padding-block: 3rem 1.5rem;
    max-width: var(--measure);
  }

  .bi-small-back {
    display: inline-block;
    font-size: 0.875rem;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .bi-hero-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .bi-grid-section {
    padding-block: 1rem 3rem;
  }

  .bi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.25rem;
  }

  .bi-empty {
    color: var(--ink-soft);
    padding-block: 1rem;
  }
</style>
