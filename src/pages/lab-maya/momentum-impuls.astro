---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lab Maya: Virtual Collision Lab"
  description="Laboratorium tumbukan virtual -- atur dua kereta eksperimen (massa, kecepatan, arah), pilih jenis tumbukan (lenting/sebagian/tidak lenting), dan buktikan sendiri Hukum Kekekalan Momentum lewat animasi, data, dan grafik F vs t."
  disableCursor
>
  <section class="container page-header">
    <a href="/materi" class="back-link">&larr; Semua Materi</a>
    <p class="eyebrow">🧪 Lab Maya · Mekanika · Kelas X</p>
    <h1>Virtual Collision Lab</h1>
    <p class="page-lede">
      Atur dua kereta eksperimen -- massa, kecepatan, dan arahnya -- pilih jenis tumbukan, lalu
      tekan Mulai Eksperimen dan saksikan sendiri bagaimana momentum berpindah saat keduanya
      bertumbukan. Lengkap dengan analisis impuls, grafik gaya-waktu, dan Safety Lab yang
      menghubungkan konsep ini dengan airbag kendaraan.
    </p>
  </section>

  <section class="container lab-wrap">
    <div class="mi-frame-wrap card">
      <iframe
        data-mi-frame
        src="/lab-embeds/momentum-impuls.html"
        title="Virtual Collision Lab"
        loading="lazy"
      ></iframe>
    </div>
    <p class="lab-note">
      Simulasi ini dijalankan dari file mandiri (bukan komponen situs) — makanya nuansa visualnya
      beda dari halaman sekitarnya. Itu disengaja, bukan bug.
    </p>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-wrap {
    max-width: 60rem;
    padding-block: 1rem 4rem;
  }

  .mi-frame-wrap {
    padding: 0;
    overflow: hidden;
  }

  .mi-frame-wrap iframe {
    display: block;
    width: 100%;
    height: 2900px; /* nilai awal, langsung disesuaikan JS begitu iframe termuat */
    border: 0;
  }

  .lab-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    text-align: center;
  }
</style>

<script>
  // Iframe ini satu domain (file kita sendiri di /lab-embeds), jadi boleh baca
  // tinggi kontennya langsung tanpa postMessage — auto-resize supaya nggak ada
  // scrollbar ganda atau ruang kosong di bawah simulasi.
  const iframe = document.querySelector<HTMLIFrameElement>('[data-mi-frame]');

  function resizeIframe() {
    if (!iframe?.contentDocument) return;
    const height = iframe.contentDocument.documentElement.scrollHeight;
    if (height > 0) iframe.style.height = `${height}px`;
  }

  iframe?.addEventListener('load', () => {
    resizeIframe();
    window.addEventListener('resize', () => setTimeout(resizeIframe, 150));
  });
</script>
