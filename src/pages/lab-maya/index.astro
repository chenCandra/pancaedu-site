  },
  {
    href: '/lab-maya/induksi-elektromagnetik',
    icon: '⚡',
    title: 'Faraday Electromagnetic Induction Lab',
    description:
      'Tarik magnet mendekati/menjauhi kumparan dengan tangan sendiri, amati galvanometer merespons langsung, dan temukan sendiri Hukum Faraday & Hukum Lenz lewat data dan grafik real-time.',
    tag: 'Kelas XII · Listrik Magnet',
  },
  {
    href: '/lab-maya/vektor',
    icon: '🧭',
    title: 'Vector Playground',
    description:
      'Atur besar dan arah dua vektor, lalu bandingkan cara menjumlahkannya -- metode grafis (segitiga) dan metode analitis (komponen sumbu x-y) -- buktikan sendiri hasilnya selalu sama.',
    tag: 'Kelas X · Gerak Dua Dimensi',
  },
  {
    href: '/lab-maya/gerak-parabola',
    icon: '🎯',
    title: 'Projectile Motion Lab',
    description:
      'Atur kecepatan awal dan sudut elevasi peluru, tembakkan, dan buktikan sendiri kenapa sudut θ dan (90°-θ) selalu memberi jangkauan yang sama.',
    tag: 'Kelas X · Gerak Dua Dimensi',
  },
  {
    href: '/lab-maya/perubahan-iklim',
    icon: '🌍',
    title: 'Climate Change Simulator',
    description:
      'Atur upaya pengurangan emisi karbon, energi terbarukan, dan reboisasi, lalu lihat proyeksi kenaikan suhu global -- coba capai target Perjanjian Paris (1,5°C).',
    tag: 'Kelas X · Perubahan Iklim',
  },
  {
    href: '/lab-maya/medan-magnet',
    icon: '🧲',
    title: 'Laboratorium Maya: Medan Magnet',
    description:
      'Geser kompas virtual di sekitar magnet batang atau kawat berarus, dan temukan sendiri arah medan magnetnya lewat 2 tab: Magnet Batang & Kawat Berarus.',
    tag: 'Kelas XII · Fenomena Elektromagnetik',
  },
  {
    href: '/lab-maya/gaya-lorentz',
    icon: '🌀',
    title: 'Laboratorium Maya: Gaya Lorentz',
    description:
      'Tembakkan partikel bermuatan ke medan magnet seragam, atur kecepatan/kuat medan/jenis muatan, dan amati sendiri lintasan melingkarnya terbentuk real-time.',
    tag: 'Kelas XII · Fenomena Elektromagnetik',
  },
  {
    href: '/lab-maya/arus-bolak-balik',
    icon: '📈',
    title: 'Laboratorium Maya: Arus Bolak-Balik',
    description:
      'Atur tegangan puncak dan frekuensi gelombang AC, bandingkan dengan DC, dan temukan sendiri kenapa nilai RMS dipakai untuk tegangan listrik rumah.',
    tag: 'Kelas XII · Fenomena Elektromagnetik',
  },
  {
    href: '/lab-maya/rangkaian-ac-sederhana',
    icon: '🔧',
    title: 'Laboratorium Maya: Rangkaian AC Sederhana',
    description:
      'Pindah-pindah tab Resistor, Induktor, dan Kapasitor, atur frekuensi dan nilai komponennya, lalu amati sendiri hubungan fase tegangan-arus dan reaktansinya berubah.',
    tag: 'Kelas XII · Fenomena Elektromagnetik',
  },
  {
    href: '/lab-maya/efek-fotolistrik',
    icon: '💡',
    title: 'Laboratorium Maya: Efek Fotolistrik',
    description:
      'Pilih jenis logam, atur panjang gelombang dan intensitas cahaya, dan buktikan sendiri kapan elektron terlepas dari permukaan logam -- serta kenapa intensitas saja tidak cukup.',
    tag: 'Kelas XII · Teori Dasar Fisika Modern',
  },
  {
    href: '/lab-maya/peluruhan-radioaktif',
    icon: '☢️',
    title: 'Laboratorium Maya: Peluruhan Radioaktif',
    description:
      'Pilih isotop radioaktif, geser waktu dalam satuan waktu paruh (T½), dan lihat sendiri berapa persen inti yang tersisa -- dari Iodin-131 di kedokteran nuklir sampai Karbon-14 untuk penanggalan fosil.',
    tag: 'Kelas XII · Teori Dasar Fisika Modern',
  },
  {
    href: '/lab-maya/dioda-dan-transistor',
    icon: '🔌',
    title: 'Laboratorium Maya: Dioda dan Transistor',
    description:
      'Geser tegangan bias dan amati sendiri kapan dioda "terbuka" mengalirkan arus, dan kapan transistor menyala sebagai saklar elektronik.',
    tag: 'Kelas XII · Teori Dasar Digital',
  },
  {
    href: '/lab-maya/gerbang-logika',
    icon: '🔢',
    title: 'Laboratorium Maya: Gerbang Logika',
    description:
      'Pilih gerbang logika (AND/OR/NOT/NAND/NOR/XOR), nyalakan-matikan input A dan B, lalu lihat sendiri outputnya dan bandingkan dengan tabel kebenarannya.',
    tag: 'Kelas XII · Teori Dasar Digital',
  },
  {
    href: '/lab-maya/sinyal-analog-digital',
    icon: '📶',
    title: 'Laboratorium Maya: Sinyal Analog dan Digital',
    description:
      'Atur laju sampling dan kedalaman bit, lalu lihat sendiri bagaimana sinyal analog kontinu diubah jadi sinyal digital bertangga -- dan kenapa resolusinya penting.',
    tag: 'Kelas XII · Teori Dasar Digital',
  },
  {
    href: '/lab-maya/bilangan-biner',
    icon: '🔢',
    title: 'Laboratorium Maya: Bilangan Biner',
    description:
      'Nyalakan-matikan 8 bit biner dan lihat nilai desimalnya berubah live, atau geser nilai desimalnya langsung dan lihat pola biner yang terbentuk.',
    tag: 'Kelas XII · Teori Dasar Digital',
  },
  {
    href: '/lab-maya/spektrum-elektromagnetik',
    icon: '🌈',
    title: 'Laboratorium Maya: Spektrum Elektromagnetik',
    description:
      'Geser sepanjang spektrum dari gelombang radio sampai sinar gamma, lihat panjang gelombang & frekuensinya berubah, lengkap contoh pemanfaatan sehari-hari.',
    tag: 'Kelas XII · Fenomena Elektromagnetik',
  },
];

// Slug lab-embeds yang SUDAH punya halaman /lab-maya/* sendiri lewat
// customLabs di atas (asumsi konvensi: /lab-maya/{slug} membungkus
// /lab-embeds/{slug}.html — konsisten di semua Lab Maya yang dibangun sejauh
// ini). Dipakai buat nyaring materiWithSim di bawah, biar simulasi yang sama
// nggak muncul dobel: sekali sebagai kartu simulasi murni, sekali lagi
// sebagai kartu yang sebenarnya mengarah ke artikel materi lengkap.
const customLabEmbedSlugs = new Set(
  customLabs.map((lab) => lab.href.replace('/lab-maya/', ''))
);

// Sebagian besar Lab Maya bikinan sendiri (lab-embeds/*.html) otomatis
// kesaring lewat pola URL di atas. Tapi ada simulasi EKSTERNAL (mis. PhET)
// yang urlnya bukan /lab-embeds/*.html, jadi disaring lewat id post materi-
// nya secara eksplisit di sini kalau sudah punya wrapper /lab-maya/* sendiri.
const materiSimAlreadyWrapped = new Set(['fluida-dan-massa-jenis']);

// Materi yang punya field `simulasi` (embed PhET/GeoGebra/dsb, atau Lab Maya
// yang BELUM punya halaman /lab-maya/* sendiri) — otomatis ikut muncul di
// sini begitu ditambahkan, nggak perlu edit halaman ini tiap kali nulis
// materi baru. Yang simulasinya sudah terwakili di customLabs disaring biar
// nggak dobel.
const materiWithSim = (
  await getCollection(
    'blog',
    ({ data }) => data.category === 'materi' && !data.draft && Boolean(data.simulasi)
  )
)
  .filter((post) => {
    if (materiSimAlreadyWrapped.has(post.id)) return false;
    const url = post.data.simulasi?.url ?? '';
    const match = url.match(/\/lab-embeds\/([^/]+)\.html$/);
    const slug = match?.[1];
    return !slug || !customLabEmbedSlugs.has(slug);
  })
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Lab Maya"
  description="Kumpulan simulasi & latihan interaktif Fisika — jangka sorong, mikrometer sekrup, Hukum Coulomb, massa jenis, dan lainnya menyusul."
>
  <section class="container page-header">
    <p class="eyebrow">🧪 Lab Maya</p>
    <h1>Belajar Sambil Coba-Coba</h1>
    <p class="page-lede">
      Bukan cuma baca teori — di sini kamu bisa geser, tarik, dan otak-atik simulasinya sendiri.
      Pilih salah satu di bawah buat mulai eksplorasi.
    </p>
  </section>

  <section class="container lab-grid">
    {customLabs.map((lab) => (
      <a href={lab.href} class="lab-card card">
        <span class="lab-card-icon" aria-hidden="true">{lab.icon}</span>
        <div class="lab-card-body">
          <span class="badge">{lab.tag}</span>
          <h2>{lab.title}</h2>
          <p>{lab.description}</p>
          <span class="lab-card-cta">Coba sekarang →</span>
        </div>
      </a>
    ))}

    {materiWithSim.map((post) => (
      <a href={`/materi/${post.id}`} class="lab-card card">
        <span class="lab-card-icon" aria-hidden="true">🧪</span>
        <div class="lab-card-body">
          <span class="badge">Kelas {post.data.kelas} · {post.data.mapel}</span>
          <h2>{post.data.simulasi?.judul}</h2>
          <p>{post.data.description}</p>
          <span class="lab-card-cta">Coba sekarang →</span>
        </div>
      </a>
    ))}
  </section>

  {customLabs.length + materiWithSim.length === 0 && (
    <p class="container empty-state">Belum ada simulasi yang diterbitkan.</p>
  )}
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 40rem;
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
    padding-block: 1rem 4rem;
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .lab-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .lab-card-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .lab-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lab-card h2 {
    font-size: 1.15rem;
    margin: 0;
  }

  .lab-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .lab-card-cta {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  .empty-state {
    color: var(--ink-soft);
    padding-block: 1rem 4rem;
  }
</style>
