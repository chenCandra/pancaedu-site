---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Dua tool custom yang dibangun sendiri (bukan lewat content collection) —
// tambahkan baris baru di sini kalau bikin lab-maya/*.astro baru lagi.
const customLabs = [
  {
    href: '/lab-maya/alat-ukur',
    icon: '📏',
    title: 'Eksplorasi Alat Ukur',
    description:
      'Latihan baca jangka sorong & mikrometer sekrup — ukuran benda diacak tiap ronde, kamu yang geser & menebak hasilnya.',
    tag: 'Pengukuran',
  },
  {
    href: '/lab-maya/hukum-coulomb',
    icon: '⚡',
    title: 'Hukum Coulomb',
    description:
      'Geser jarak & besar muatan, lihat gaya tarik/tolaknya berubah langsung, lengkap rincian perhitungannya.',
    tag: 'Kelas XII · Listrik Statis',
  },
  {
    href: '/lab-maya/medan-listrik',
    icon: '🧲',
    title: 'Medan Listrik',
    description:
      'Geser titik uji di sekitar muatan, lihat arah & kekuatan medannya berubah langsung, dan coba temukan titik di mana medannya nol.',
    tag: 'Kelas XII · Listrik Statis',
  },
  {
    href: '/lab-maya/hukum-newton',
    icon: '🚀',
    title: 'Hukum Newton',
    description:
      'Atur massa, gaya dorong, dan gaya gesek, lihat percepatan berubah langsung sesuai Hukum II Newton, lengkap ilustrasi aksi-reaksi.',
    tag: 'Kelas X · Mekanika',
  },
  {
    href: '/lab-maya/usaha-dan-daya',
    icon: '📐',
    title: 'Usaha dan Daya',
    description:
      'Atur gaya, sudut, dan jarak perpindahan, lihat usaha dan daya berubah langsung -- termasuk kenapa usaha bisa jadi nol.',
    tag: 'Kelas X · Mekanika',
  },
  {
    href: '/lab-maya/energi-mekanik',
    icon: '⚡',
    title: 'Energi Mekanik',
    description:
      'Jatuhkan benda dari ketinggian tertentu, amati energi kinetik dan potensial saling bertukar, sementara energi totalnya tetap sama.',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/energy-transformation-lab',
    icon: '🔋',
    title: 'Energy Transformation Lab',
    description:
      'Nyalakan lima sistem berbeda (lampu, motor, pemanas, speaker, tumbuhan), amati energi mengalir dan berubah bentuk, lengkap prediksi dan tantangan.',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/energy-conservation-lab',
    icon: '⚖️',
    title: 'Energy Conservation Lab',
    description:
      'Jatuhkan benda dan bandingkan dua jalur luncuran, buktikan sendiri lewat bar energi & grafik real-time bahwa energi tidak pernah hilang.',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/renewable-energy-lab',
    icon: '🌱',
    title: 'Lab Energi Terbarukan',
    description:
      'Jelajahi scene virtual panel surya, turbin angin, PLTA, panas bumi, dan biomassa -- klik tiap komponen, ikuti prosesnya langkah demi langkah, lalu bandingkan kelimanya.',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/energy-consumption-lab',
    icon: '🔌',
    title: 'Energy Consumption Lab',
    description:
      'Nyalakan alat-alat di Smart Room & Smart Classroom virtual, atur lama pemakaiannya, dan temukan hubungan antara daya, waktu, dan energi (E = P × t).',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/non-renewable-energy-lab',
    icon: '⛏️',
    title: 'Non-Renewable Energy Lab',
    description:
      'Operasikan mini pembangkit listrik tenaga uap berbahan bakar fosil, amati transformasi energinya, dan buktikan sendiri kenapa sumbernya disebut terbatas.',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/energy-efficiency-lab',
    icon: '🏠',
    title: 'Energy Efficiency Lab',
    description:
      'Atur ruangan virtual (panas luar, jendela, insulasi, tirai) dan teknologi pendingin (kipas, AC, ventilasi), lalu cari strategi mencapai suhu nyaman dengan energi seminimal mungkin.',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/energy-crisis-lab',
    icon: '🌍',
    title: 'Energy Crisis Lab',
    description:
      'Jadi operator energi Kota Panca -- atur kombinasi pembangkit surya, angin, air, gas, dan batu bara, hadapi malam hari dan gelombang panas, lalu cari strategi paling seimbang.',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/energy-planning-lab',
    icon: '🏙️',
    title: 'Energy Planning Lab',
    description:
      'Jadi Energy Planner -- rancang sistem energi Panca City dari nol, bangun pembangkit dan baterai penyimpanan, lalu uji ketahanannya lewat berbagai skenario perencanaan jangka panjang.',
    tag: 'Kelas X · Energi',
  },
  {
    href: '/lab-maya/fluida-dan-massa-jenis',
    icon: '🧊',
    title: 'Simulasi Massa Jenis (Density)',
    description:
      'Simulasi dari PhET Interactive Simulations -- bandingkan massa, volume, dan massa jenis berbagai benda, dan lihat sendiri mana yang mengapung atau tenggelam.',
    tag: 'Kelas XI · Fluida',
  },
  {
    href: '/lab-maya/hukum-hooke',
    icon: '🧵',
    title: 'Hukum Hooke',
    description:
      'Gantungkan beban pada pegas (atau tarik langsung), ukur pertambahan panjangnya, ambil data, dan temukan sendiri konstanta pegas dari grafik F vs Δx.',
    tag: 'Kelas X · Mekanika',
  },
  {
    href: '/lab-maya/momentum-impuls',
    icon: '💥',
    title: 'Virtual Collision Lab',
    description:
      'Tabrakkan dua kereta eksperimen, pilih jenis tumbukan (lenting/sebagian/tidak lenting), dan buktikan sendiri Hukum Kekekalan Momentum lewat animasi, data, dan grafik gaya-waktu.',
    tag: 'Kelas X · Mekanika',
  },
  {
    href: '/lab-maya/gerak-lurus',
    icon: '🚗',
    title: 'Virtual Motion Lab',
    description:
      'Jalankan eksperimen GLB atau GLBB di lintasan virtual, baca sensor posisi & kecepatan real-time, dan temukan sendiri ciri khasnya lewat data dan grafik yang tersinkron dengan animasi.',
    tag: 'Kelas X · Mekanika',
  },
  {
    href: '/lab-maya/hukum-ohm',
    icon: '🔌',
    title: 'Virtual Circuit Lab',
