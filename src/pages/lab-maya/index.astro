---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Dua tool custom yang dibangun sendiri (bukan lewat content collection) —
// tambahkan baris baru di sini kalau bikin lab-maya/*.astro baru lagi.
const customLabs = [
  {
    href: '/lab-maya/alat-ukur',
    icon: '📏',
    title: 'Eksplorasi Alat Ukur',
    description:
      'Latihan baca jangka sorong & mikrometer sekrup — ukuran benda diacak tiap ronde, kamu yang geser & menebak hasilnya.',
    tag: 'Pengukuran',
  },
  {
    href: '/lab-maya/hukum-coulomb',
    icon: '⚡',
    title: 'Hukum Coulomb',
    description:
      'Geser jarak & besar muatan, lihat gaya tarik/tolaknya berubah langsung, lengkap rincian perhitungannya.',
    tag: 'Kelas XII · Listrik Statis',
  },
];

// Materi yang punya field `simulasi` (embed PhET/GeoGebra/dsb di dalam
// artikelnya sendiri) — otomatis ikut muncul di sini begitu ditambahkan,
// nggak perlu edit halaman ini tiap kali nulis materi baru.
const materiWithSim = (
  await getCollection(
    'blog',
    ({ data }) => data.category === 'materi' && !data.draft && Boolean(data.simulasi)
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Lab Maya"
  description="Kumpulan simulasi & latihan interaktif Fisika — jangka sorong, mikrometer sekrup, Hukum Coulomb, massa jenis, dan lainnya menyusul."
>
  <section class="container page-header">
    <p class="eyebrow">🧪 Lab Maya</p>
    <h1>Belajar Sambil Coba-Coba</h1>
    <p class="page-lede">
      Bukan cuma baca teori — di sini kamu bisa geser, tarik, dan otak-atik simulasinya sendiri.
      Pilih salah satu di bawah buat mulai eksplorasi.
    </p>
  </section>

  <section class="container lab-grid">
    {customLabs.map((lab) => (
      <a href={lab.href} class="lab-card card">
        <span class="lab-card-icon" aria-hidden="true">{lab.icon}</span>
        <div class="lab-card-body">
          <span class="badge">{lab.tag}</span>
          <h2>{lab.title}</h2>
          <p>{lab.description}</p>
          <span class="lab-card-cta">Coba sekarang →</span>
        </div>
      </a>
    ))}

    {materiWithSim.map((post) => (
      <a href={`/materi/${post.id}`} class="lab-card card">
        <span class="lab-card-icon" aria-hidden="true">🧪</span>
        <div class="lab-card-body">
          <span class="badge">Kelas {post.data.kelas} · {post.data.mapel}</span>
          <h2>{post.data.simulasi?.judul}</h2>
          <p>{post.data.description}</p>
          <span class="lab-card-cta">Coba sekarang →</span>
        </div>
      </a>
    ))}
  </section>

  {customLabs.length + materiWithSim.length === 0 && (
    <p class="container empty-state">Belum ada simulasi yang diterbitkan.</p>
  )}
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 40rem;
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
    padding-block: 1rem 4rem;
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .lab-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .lab-card-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .lab-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lab-card h2 {
    font-size: 1.15rem;
    margin: 0;
  }

  .lab-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .lab-card-cta {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  .empty-state {
    color: var(--ink-soft);
    padding-block: 1rem 4rem;
  }
</style>
