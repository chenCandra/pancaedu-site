---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lab Maya: Medan Listrik"
  description="Simulasi interaktif Medan Listrik — geser titik uji di sekitar muatan, lihat arah & kekuatan medannya berubah langsung, dan coba temukan titik di mana medan totalnya nol."
  disableCursor
>
  <section class="container page-header">
    <a href="/materi" class="back-link">&larr; Semua Materi</a>
    <p class="eyebrow">🧪 Lab Maya · Listrik Statis · Kelas XII</p>
    <h1>Medan Listrik di Sekitar Muatan</h1>
    <p class="page-lede">
      Setiap muatan listrik menciptakan medan di ruang sekitarnya, bahkan sebelum ada muatan lain yang
      merasakannya. Geser bulatan emas (titik uji) ke mana saja di kanvas — kuat medan (E) dan arahnya
      dihitung ulang langsung, lengkap rincian rumusnya. Coba juga aktifkan muatan kedua dan cari titik
      di mana medan totalnya persis nol.
    </p>
  </section>

  <section class="container lab-wrap">
    <div class="medan-frame-wrap card">
      <iframe
        data-medan-frame
        src="/lab-embeds/medan-listrik.html"
        title="Simulasi Medan Listrik"
        loading="lazy"
      ></iframe>
    </div>
    <p class="lab-note">
      Simulasi ini dijalankan dari file mandiri (bukan komponen situs) — makanya nuansa gelapnya
      beda dari halaman sekitarnya. Itu disengaja, bukan bug.
    </p>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-wrap {
    max-width: 60rem;
    padding-block: 1rem 4rem;
  }

  .medan-frame-wrap {
    padding: 0;
    overflow: hidden;
  }

  .medan-frame-wrap iframe {
    display: block;
    width: 100%;
    height: 1000px; /* nilai awal, langsung disesuaikan JS begitu iframe termuat */
    border: 0;
  }

  .lab-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    text-align: center;
  }
</style>

<script>
  // Iframe ini satu domain (file kita sendiri di /lab-embeds), jadi boleh baca
  // tinggi kontennya langsung tanpa postMessage — auto-resize supaya nggak ada
  // scrollbar ganda atau ruang kosong di bawah simulasi.
  const iframe = document.querySelector<HTMLIFrameElement>('[data-medan-frame]');

  function resizeIframe() {
    if (!iframe?.contentDocument) return;
    const height = iframe.contentDocument.documentElement.scrollHeight;
    if (height > 0) iframe.style.height = `${height}px`;
  }

  iframe?.addEventListener('load', () => {
    resizeIframe();
    window.addEventListener('resize', () => setTimeout(resizeIframe, 150));
  });
</script>
