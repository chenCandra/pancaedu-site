---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lab Maya: Energy Transformation Lab"
  description="Eksplorasi bentuk dan perubahan energi — nyalakan lima sistem berbeda (lampu, motor, pemanas, speaker, tumbuhan), amati energi mengalir dan berubah bentuk, lengkap prediksi dan tantangan singkat."
  disableCursor
>
  <section class="container page-header">
    <a href="/materi" class="back-link">&larr; Semua Materi</a>
    <p class="eyebrow">🧪 Lab Maya · Energi · Kelas X</p>
    <h1>Energy Transformation Lab</h1>
    <p class="page-lede">
      Pilih salah satu dari lima sistem energi, coba tebak dulu perubahan energinya, baru nyalakan
      saklarnya dan amati sendiri bagaimana energi mengalir dan berubah bentuk — dari baterai yang
      menyalakan lampu, sampai matahari yang "diminum" tumbuhan lewat fotosintesis.
    </p>
  </section>

  <section class="container lab-wrap">
    <div class="etl-frame-wrap card">
      <iframe
        data-etl-frame
        src="/lab-embeds/energy-transformation-lab.html"
        title="Energy Transformation Lab"
        loading="lazy"
      ></iframe>
    </div>
    <p class="lab-note">
      Simulasi ini dijalankan dari file mandiri (bukan komponen situs) — makanya nuansa gelapnya
      beda dari halaman sekitarnya. Itu disengaja, bukan bug.
    </p>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-wrap {
    max-width: 60rem;
    padding-block: 1rem 4rem;
  }

  .etl-frame-wrap {
    padding: 0;
    overflow: hidden;
  }

  .etl-frame-wrap iframe {
    display: block;
    width: 100%;
    height: 1000px; /* nilai awal, langsung disesuaikan JS begitu iframe termuat */
    border: 0;
  }

  .lab-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    text-align: center;
  }
</style>

<script>
  // Iframe ini satu domain (file kita sendiri di /lab-embeds), jadi boleh baca
  // tinggi kontennya langsung tanpa postMessage — auto-resize supaya nggak ada
  // scrollbar ganda atau ruang kosong di bawah simulasi.
  const iframe = document.querySelector<HTMLIFrameElement>('[data-etl-frame]');

  function resizeIframe() {
    if (!iframe?.contentDocument) return;
    const height = iframe.contentDocument.documentElement.scrollHeight;
    if (height > 0) iframe.style.height = `${height}px`;
  }

  iframe?.addEventListener('load', () => {
    resizeIframe();
    window.addEventListener('resize', () => setTimeout(resizeIframe, 150));
  });
</script>
