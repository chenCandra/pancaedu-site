---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lab Maya: Energy Crisis Lab"
  description="Jadi operator energi Kota Panca -- atur kombinasi pembangkit (surya, angin, air, gas, batu bara), hadapi malam hari dan gelombang panas, dan cari strategi yang memenuhi kebutuhan listrik tanpa mengabaikan emisi, biaya, dan keandalan pasokan."
  disableCursor
>
  <section class="container page-header">
    <a href="/materi" class="back-link">&larr; Semua Materi</a>
    <p class="eyebrow">🧪 Lab Maya · Energi · Kelas X</p>
    <h1>Energy Crisis Lab</h1>
    <p class="page-lede">
      Kebutuhan energi Kota Panca terus berubah sepanjang hari, sementara setiap sumber energi
      punya karakteristik dan keterbatasannya sendiri. Atur kombinasi pembangkit, uji strategimu
      lewat berbagai skenario (malam hari, gelombang panas, bahan bakar terbatas), dan cari tahu
      sendiri kenapa masalah energi tidak punya satu solusi sederhana.
    </p>
  </section>

  <section class="container lab-wrap">
    <div class="ecl-frame-wrap card">
      <iframe
        data-ecl-frame
        src="/lab-embeds/energy-crisis-lab.html"
        title="Energy Crisis Lab"
        loading="lazy"
      ></iframe>
    </div>
    <p class="lab-note">
      Simulasi ini dijalankan dari file mandiri (bukan komponen situs) — makanya nuansa visualnya
      beda dari halaman sekitarnya. Itu disengaja, bukan bug.
    </p>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-wrap {
    max-width: 60rem;
    padding-block: 1rem 4rem;
  }

  .ecl-frame-wrap {
    padding: 0;
    overflow: hidden;
  }

  .ecl-frame-wrap iframe {
    display: block;
    width: 100%;
    height: 1900px; /* nilai awal, langsung disesuaikan JS begitu iframe termuat */
    border: 0;
  }

  .lab-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    text-align: center;
  }
</style>

<script>
  // Iframe ini satu domain (file kita sendiri di /lab-embeds), jadi boleh baca
  // tinggi kontennya langsung tanpa postMessage — auto-resize supaya nggak ada
  // scrollbar ganda atau ruang kosong di bawah simulasi.
  const iframe = document.querySelector<HTMLIFrameElement>('[data-ecl-frame]');

  function resizeIframe() {
    if (!iframe?.contentDocument) return;
    const height = iframe.contentDocument.documentElement.scrollHeight;
    if (height > 0) iframe.style.height = `${height}px`;
  }

  iframe?.addEventListener('load', () => {
    resizeIframe();
    window.addEventListener('resize', () => setTimeout(resizeIframe, 150));
  });
</script>
