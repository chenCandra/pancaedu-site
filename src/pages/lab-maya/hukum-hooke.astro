---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lab Maya: Hukum Hooke"
  description="Laboratorium virtual Hukum Hooke -- gantungkan beban pada pegas, ukur pertambahan panjangnya dengan penggaris virtual, kumpulkan data, buat grafik F vs Δx, dan temukan sendiri konstanta pegasnya."
  disableCursor
>
  <section class="container page-header">
    <a href="/materi" class="back-link">&larr; Semua Materi</a>
    <p class="eyebrow">🧪 Lab Maya · Mekanika · Kelas X</p>
    <h1>Laboratorium Maya: Hukum Hooke</h1>
    <p class="page-lede">
      Gantungkan beban pada pegas (atau tarik langsung dengan gaya tertentu), amati pertambahan
      panjangnya lewat penggaris virtual, ambil data, dan temukan sendiri hubungan F = k·Δx --
      lengkap dengan konsep batas elastis dan penentuan konstanta pegas dari grafik.
    </p>
  </section>

  <section class="container lab-wrap">
    <div class="hk-frame-wrap card">
      <iframe
        data-hk-frame
        src="/lab-embeds/hukum-hooke.html"
        title="Laboratorium Maya: Hukum Hooke"
        loading="lazy"
      ></iframe>
    </div>
    <p class="lab-note">
      Simulasi ini dijalankan dari file mandiri (bukan komponen situs) — makanya nuansa visualnya
      beda dari halaman sekitarnya. Itu disengaja, bukan bug.
    </p>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-wrap {
    max-width: 60rem;
    padding-block: 1rem 4rem;
  }

  .hk-frame-wrap {
    padding: 0;
    overflow: hidden;
  }

  .hk-frame-wrap iframe {
    display: block;
    width: 100%;
    height: 2600px; /* nilai awal, langsung disesuaikan JS begitu iframe termuat */
    border: 0;
  }

  .lab-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    text-align: center;
  }
</style>

<script>
  // Iframe ini satu domain (file kita sendiri di /lab-embeds), jadi boleh baca
  // tinggi kontennya langsung tanpa postMessage — auto-resize supaya nggak ada
  // scrollbar ganda atau ruang kosong di bawah simulasi.
  const iframe = document.querySelector<HTMLIFrameElement>('[data-hk-frame]');

  function resizeIframe() {
    if (!iframe?.contentDocument) return;
    const height = iframe.contentDocument.documentElement.scrollHeight;
    if (height > 0) iframe.style.height = `${height}px`;
  }

  iframe?.addEventListener('load', () => {
    resizeIframe();
    window.addEventListener('resize', () => setTimeout(resizeIframe, 150));
  });
</script>
