---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lab Maya: Virtual Motion Lab"
  description="Laboratorium gerak virtual -- atur kereta di lintasan, jalankan eksperimen GLB atau GLBB, baca sensor posisi & kecepatan secara real-time, dan temukan sendiri ciri khas tiap jenis gerak lewat data dan grafik."
  disableCursor
>
  <section class="container page-header">
    <a href="/materi" class="back-link">&larr; Semua Materi</a>
    <p class="eyebrow">🧪 Lab Maya · Mekanika · Kelas X</p>
    <h1>Virtual Motion Lab</h1>
    <p class="page-lede">
      Atur kereta laboratorium di lintasan, pilih mode GLB (Gerak Lurus Beraturan) atau GLBB
      (Gerak Lurus Berubah Beraturan), lalu jalankan eksperimennya. Sensor posisi dan kecepatan
      membaca datanya otomatis, grafik terbentuk real-time dan tersinkron dengan animasi --
      lengkap dengan mode Bandingkan/Kejar Kereta dan Time Trial.
    </p>
  </section>

  <section class="container lab-wrap">
    <div class="gl-frame-wrap card">
      <iframe
        data-gl-frame
        src="/lab-embeds/gerak-lurus.html"
        title="Virtual Motion Lab"
        loading="lazy"
      ></iframe>
    </div>
    <p class="lab-note">
      Simulasi ini dijalankan dari file mandiri (bukan komponen situs) — makanya nuansa visualnya
      beda dari halaman sekitarnya. Itu disengaja, bukan bug.
    </p>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-wrap {
    max-width: 60rem;
    padding-block: 1rem 4rem;
  }

  .gl-frame-wrap {
    padding: 0;
    overflow: hidden;
  }

  .gl-frame-wrap iframe {
    display: block;
    width: 100%;
    height: 2900px; /* nilai awal, langsung disesuaikan JS begitu iframe termuat */
    border: 0;
  }

  .lab-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    text-align: center;
  }
</style>

<script>
  // Iframe ini satu domain (file kita sendiri di /lab-embeds), jadi boleh baca
  // tinggi kontennya langsung tanpa postMessage — auto-resize supaya nggak ada
  // scrollbar ganda atau ruang kosong di bawah simulasi.
  const iframe = document.querySelector<HTMLIFrameElement>('[data-gl-frame]');

  function resizeIframe() {
    if (!iframe?.contentDocument) return;
    const height = iframe.contentDocument.documentElement.scrollHeight;
    if (height > 0) iframe.style.height = `${height}px`;
  }

  iframe?.addEventListener('load', () => {
    resizeIframe();
    window.addEventListener('resize', () => setTimeout(resizeIframe, 150));
  });
</script>
