---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Game Edukasi: Meriam Parabola"
  description="Atur sudut elevasi dan kecepatan awal meriam supaya peluru mengenai sasaran -- game edukasi gerak parabola."
  disableCursor
>
  <section class="container page-header">
    <a href="/game-edukasi" class="back-link">&larr; Semua Game Edukasi</a>
    <p class="eyebrow">🎮 Game Edukasi · Kelas X · Gerak Parabola</p>
    <h1>Meriam Parabola</h1>
    <p class="page-lede">
      Atur sudut elevasi dan kecepatan awal meriam supaya peluru mengenai sasaran yang berpindah-pindah.
      Sambil main, perhatikan bagaimana jangkauan (R) berubah mengikuti rumus gerak parabola.
    </p>
  </section>

  <section class="container lab-wrap">
    <div class="frame-wrap card">
      <iframe
        data-game-frame
        src="/lab-embeds/meriam-parabola.html"
        title="Game Meriam Parabola"
        loading="lazy"
      ></iframe>
    </div>
    <p class="lab-note">
      Game ini dijalankan dari file mandiri (bukan komponen situs) — makanya nuansa gelapnya
      beda dari halaman sekitarnya. Itu disengaja, bukan bug.
    </p>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 42rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-wrap {
    max-width: 60rem;
    padding-block: 1rem 4rem;
  }

  .frame-wrap {
    padding: 0;
    overflow: hidden;
  }

  .frame-wrap iframe {
    display: block;
    width: 100%;
    height: 900px; /* nilai awal, langsung disesuaikan JS begitu iframe termuat */
    border: 0;
  }

  .lab-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--ink-faint);
    text-align: center;
  }
</style>

<script>
  // Sama seperti wrapper Lab Maya lain -- iframe satu domain, jadi boleh
  // baca tinggi kontennya langsung tanpa postMessage.
  const iframe = document.querySelector<HTMLIFrameElement>('[data-game-frame]');

  function resizeIframe() {
    if (!iframe?.contentDocument) return;
    const height = iframe.contentDocument.documentElement.scrollHeight;
    if (height > 0) iframe.style.height = `${height}px`;
  }

  iframe?.addEventListener('load', () => {
    resizeIframe();
    window.addEventListener('resize', () => setTimeout(resizeIframe, 150));
  });
</script>
