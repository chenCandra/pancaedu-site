---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Game Edukasi -- BEDA dari Lab Maya: Lab Maya fokus eksplorasi bebas
// (geser-geser variabel, lihat efeknya), Game Edukasi fokus ke tantangan
// dengan target/skor/menang-kalah yang jelas. Ditaruh terpisah (bukan
// ditambahkan ke customLabs Lab Maya) atas permintaan eksplisit -- lihat
// riwayat percakapan 2026-09-30.
//
// Game yang SUDAH dibangun (halaman /game-edukasi/{slug} + file mandiri
// di /public/lab-embeds/{slug}.html) -- tambahkan entri baru di sini
// begitu game barunya jadi.
const gamesTersedia = [
  {
    href: '/game-edukasi/meriam-parabola',
    icon: '🎯',
    title: 'Meriam Parabola',
    description:
      'Atur sudut elevasi & kecepatan awal supaya peluru mengenai sasaran yang berpindah-pindah -- sambil lihat rumus jangkauan gerak parabola berubah live.',
    tag: 'Kelas X · Gerak Parabola',
  },
];

// Game yang MASIH DIRENCANAKAN (belum ada halamannya) -- ditampilkan
// sebagai kartu non-aktif "Segera Hadir" biar kelihatan roadmap-nya,
// pindahkan ke gamesTersedia begitu sudah jadi.
const gamesSegeraHadir = [
  {
    icon: '🏎️',
    title: 'Balap Mobil',
    description: 'Atur kecepatan, percepatan, dan gesekan supaya mobilmu menang balapan -- GLB, GLBB, dan gaya gesekan.',
    tag: 'Kelas X · Gerak Lurus & Gaya',
  },
  {
    icon: '🌉',
    title: 'Jembatan Roboh',
    description: 'Taruh beban di posisi yang tepat supaya papan tetap seimbang, tidak berat sebelah dan roboh.',
    tag: 'Kelas XI · Keseimbangan Benda Tegar',
  },
  {
    icon: '🎢',
    title: 'Roller Coaster',
    description: 'Atur tinggi bukit awal supaya kereta punya cukup energi buat melewati loop tanpa jatuh.',
    tag: 'Kelas X · Energi Mekanik',
  },
  {
    icon: '💡',
    title: 'Rangkaian Listrik',
    description: 'Susun resistor seri atau paralel supaya lampu menyala sesuai arus yang diminta.',
    tag: 'Kelas XII · Rangkaian Listrik',
  },
  {
    icon: '🔦',
    title: 'Pantulan Cahaya',
    description: 'Putar cermin supaya sinar laser memantul tepat mengenai target -- hukum pemantulan cahaya.',
    tag: 'Kelas X · Optik',
  },
];
---

<BaseLayout
  title="Game Edukasi"
  description="Kumpulan game edukasi Fisika -- tembak sasaran, balapan, seimbangkan jembatan, dan lainnya, sambil belajar konsepnya langsung."
>
  <section class="container page-header">
    <p class="eyebrow">🎮 Game Edukasi</p>
    <h1>Belajar Sambil Bermain</h1>
    <p class="page-lede">
      Beda dari Lab Maya (eksplorasi bebas), di sini kamu ditantang mencapai target tertentu --
      kena sasaran, menang balapan, jaga keseimbangan -- sambil konsep fisikanya kepakai langsung.
    </p>
  </section>

  <section class="container lab-grid">
    {gamesTersedia.map((game) => (
      <a href={game.href} class="lab-card card">
        <span class="lab-card-icon" aria-hidden="true">{game.icon}</span>
        <div class="lab-card-body">
          <span class="badge">{game.tag}</span>
          <h2>{game.title}</h2>
          <p>{game.description}</p>
          <span class="lab-card-cta">Main sekarang →</span>
        </div>
      </a>
    ))}

    {gamesSegeraHadir.map((game) => (
      <div class="lab-card card lab-card--soon">
        <span class="lab-card-icon" aria-hidden="true">{game.icon}</span>
        <div class="lab-card-body">
          <span class="badge">{game.tag}</span>
          <h2>{game.title}</h2>
          <p>{game.description}</p>
          <span class="lab-card-cta lab-card-cta--soon">Segera hadir</span>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: 3rem 1.5rem;
    max-width: 40rem;
  }

  .page-lede {
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.5rem;
    padding-block: 1rem 4rem;
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .lab-card:not(.lab-card--soon):hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .lab-card--soon {
    opacity: 0.55;
  }

  .lab-card-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .lab-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lab-card h2 {
    font-size: 1.15rem;
    margin: 0;
  }

  .lab-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .lab-card-cta {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }

  .lab-card-cta--soon {
    color: var(--ink-faint);
  }
</style>
