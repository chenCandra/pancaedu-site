---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

// Prosa halaman ini (tagline, bio, badge peran) diedit lewat CMS (/admin,
// koleksi "Halaman Tentang (Profil)", lihat profilPabakti di
// content.config.ts). Grid "works" di bawah TETAP hardcode (lihat catatan
// di content.config.ts).
const [profil] = await getCollection('profilPabakti');
const { tagline, roles, bioIntro, bioHeading, bioAbout, bioClosing } = profil.data;

const works = [
  {
    href: '/ruang-belajar',
    title: 'Ruang Belajar',
    desc: 'Rangkaian sesi belajar mandiri, disusun berurutan per bab kurikulum.',
  },
  {
    href: '/materi',
    title: 'Materi',
    desc: 'Rangkuman konsep fisika, ditulis ulang dengan bahasa yang mudah dicerna.',
  },
  {
    href: '/lab-maya',
    title: 'Lab Maya',
    desc: 'Simulasi interaktif untuk memvisualisasikan konsep yang abstrak di kelas.',
  },
  {
    href: '/penugasan',
    title: 'Penugasan',
    desc: 'Sistem tugas interaktif dengan PIN, dari isian singkat sampai drag-and-drop.',
  },
  {
    href: '/artikel',
    title: 'Artikel',
    desc: 'Tulisan lepas: refleksi ruang kelas, catatan studi, dan opini seputar pendidikan.',
  },
];

// Tulisan terbaru di /artikel -- materi punya listing sendiri (lihat kartu
// "Materi" di bawah), jadi tidak ikut digabung di sini.
const latestPosts = (
  await getCollection('blog', ({ data }) => data.category === 'artikel' && !data.draft)
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const canonicalURL = new URL('/candra-pabakti', Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Candra Pabakti',
  url: canonicalURL,
  email: 'mailto:gravi.tazy@gmail.com',
  jobTitle: 'Guru Fisika',
  description:
    'Guru dan wali kelas. Pendiri dan pengelola tunggal PancaEdu, ruang belajar digital gratis di pancaedu.web.id.',
  knowsAbout: ['Fisika', 'Pendidikan Fisika', 'Media Pembelajaran Interaktif'],
  worksFor: { '@type': 'Organization', name: 'PancaEdu', url: 'https://pancaedu.web.id' },
};
---

<BaseLayout
  title="Candra Pabakti — Pengembang PancaEdu"
  titleIsFull
  description="Candra Pabakti, guru fisika sekaligus pendiri dan pengembang PancaEdu, ruang belajar digital berisi materi pembelajaran, artikel pendidikan, dan Lab Maya interaktif."
  jsonLd={jsonLd}
>
  <article class="container page">
    <header class="hero" data-reveal>
      <div class="hero-avatar" aria-hidden="true">
        <span>CP</span>
      </div>
      <div class="hero-text">
        <p class="eyebrow">Pengembang PancaEdu</p>
        <h1>Candra Pabakti</h1>
        <p class="hero-tagline">{tagline}</p>
        <ul class="hero-roles">
          {roles.map((r) => (
            <li class={`badge ${r.badge}`.trim()}>{r.label}</li>
          ))}
        </ul>
      </div>
    </header>

    <div class="prose bio">
      <p>{bioIntro}</p>
      <h2>{bioHeading}</h2>
      <p>{bioAbout}</p>
      <p>{bioClosing}</p>
    </div>

    <section class="works" data-reveal>
      <p class="eyebrow">Yang saya bangun di PancaEdu</p>
      <div class="works-grid">
        {works.map((w) => (
          <a class="work-card card" href={w.href}>
            <h2>{w.title}</h2>
            <p>{w.desc}</p>
          </a>
        ))}
      </div>
    </section>

    {latestPosts.length > 0 && (
      <section class="latest-posts" data-reveal>
        <p class="eyebrow">Tulisan Terbaru</p>
        <div class="latest-posts-grid">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
      </section>
    )}

    <div class="cta-row">
      <a class="btn btn-primary" href="/kontak">Hubungi Saya</a>
      <a class="btn btn-ghost" href="/artikel">Baca Tulisan Saya</a>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: 3rem 4rem;
  }

  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .hero-avatar {
    flex-shrink: 0;
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 14px 32px -10px rgba(59, 111, 237, 0.55);
  }

  .hero-avatar span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.5rem;
    color: var(--accent-ink);
    letter-spacing: 0.02em;
  }

  .hero-text h1 {
    margin: 0.25rem 0 0.5rem;
  }

  .hero-tagline {
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .hero-tagline a {
    font-weight: 600;
  }

  .hero-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .bio {
    max-width: var(--measure);
  }

  .works {
    margin-top: 3rem;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .work-card {
    display: block;
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .work-card:hover {
    transform: translateY(-3px);
  }

  .work-card h2 {
    margin: 0 0 0.35rem;
    font-size: 1.0625rem;
    font-family: var(--font-display);
    color: var(--accent);
  }

  .work-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .latest-posts {
    margin-top: 3rem;
  }

  .latest-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  @media (max-width: 48rem) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
